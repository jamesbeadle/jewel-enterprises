@namespace Jewel.JPMS.Features.Procurement
@inject ICommandSender Commands
@inject ISubcontractorStore Subs

@* Record a tender submission and save it as a quote — however it arrived (email, phone, post).
   Opened manually it pre-fills the package's line schedule for hand keying; opened from a filed
   tender email it asks the AI to read the submission first and pre-fills the proposal with every
   gap it found. The modal is the review step: nothing is recorded until Save, and saving goes
   through SaveExtractedQuote so statuses and supersede-on-resubmit behave identically however
   the prices came in. *@
<Modal IsOpen="isOpen" Title="Tender submission" ShowFooter="true"
       ConfirmLabel="@(saving || Busy ? "Saving…" : "Save submission")" ConfirmDisabled="@(saving || Busy || extracting)" CancelLabel="Cancel"
       OnCancel="Close" OnConfirm="SaveAsync" Class="max-w-3xl w-full">
    @if (saveError is not null)
    {
        <Notice Tone="Tone.Negative" Class="mb-3">@saveError</Notice>
    }
    @if (sourceEmail is { } fromEmail)
    {
        <p class="rounded bg-surface-raised border border-line px-3 py-2 text-xs text-content-muted mb-3">
            Extracted from <span class="font-medium text-content">@(string.IsNullOrWhiteSpace(fromEmail.FromName) ? fromEmail.FromEmail : fromEmail.FromName)</span>'s
            email of @DateText(fromEmail.ReceivedAt) — the figures below are
            THEIR submission as the AI read it. Review every line (and correct it where the read is
            wrong) before saving; nothing is recorded until you do.
        </p>
    }
    else
    {
        <p class="rounded bg-surface-raised border border-line px-3 py-2 text-xs text-content-muted mb-3">
            Recording a tender as the subcontractor gave it — the package's line items are pre-filled;
            enter the rates from their submission.
        </p>
    }

    <LoadGate IsLoading="extracting" Prominent="true" Label="Reading the tender — the email, its pricing schedule and the package's line items…">
    @if (issues.Count > 0)
    {
        <Notice Tone="Tone.Warning" Class="mb-3">
            <p class="font-medium mb-1">@(proposed ? "The extraction found gaps in this tender:" : "This tender couldn't be read automatically:")</p>
            <ul class="list-disc pl-5 space-y-0.5">
                @foreach (var issue in issues)
                {
                    <li>@issue</li>
                }
            </ul>
        </Notice>
    }
    else if (sourceEmail is not null && complete)
    {
        <Notice Tone="Tone.Positive" Class="mb-3">
            The tender reads complete — every line item is priced and the sums reconcile. Review the
            figures and save it as a submission.
        </Notice>
    }

    <FormField Label="Subcontractor">
    <select class="field mb-3" @bind="subcontractorId">
        <option value="">Select the subcontractor…</option>
        @foreach (var recipient in Recipients)
        {
            var sub = Subs.Find(recipient.SubcontractorId);
            <option value="@recipient.SubcontractorId">@(sub?.CompanyName ?? recipient.SubcontractorId)</option>
        }
    </select>
    </FormField>
    @if (sourceEmail is not null && !string.IsNullOrWhiteSpace(subcontractorNote))
    {
        <p class="text-xs text-content-subtle -mt-2 mb-3">@subcontractorNote</p>
    }

    <div class="panel mb-3">
        <table class="data-table data-table-dense">
            <thead>
                <tr>
                    <th>Description</th>
                    <th class="hidden sm:table-cell">Unit</th>
                    <th>Qty</th>
                    <th>Rate</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var draft in drafts)
                {
                    <tr class="@(draft.BidPackageLineItemId is null ?"bg-accent/5" : "")">
                        <td><input class="field" @bind="draft.Description" /></td>
                        <td class="hidden sm:table-cell"><input class="field w-16" @bind="draft.Unit" /></td>
                        <td><input class="field w-20" type="number" step="any" @bind="draft.Quantity" /></td>
                        <td><input class="field w-24" type="number" step="any" @bind="draft.Rate" @onblur="() => RecalcTotal(draft)" /></td>
                        <td><input class="field w-28" type="number" step="any" @bind="draft.Total" /></td>
                        <td class="text-right">
                            <button type="button" class="text-xs text-content-muted hover:text-negative" @onclick="() => drafts.Remove(draft)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="flex items-center justify-between mb-3">
        <button type="button" class="btn-secondary" @onclick="AddLine">Add line</button>
        <p class="text-sm text-content font-medium">Total: @drafts.Sum(d => d.Total).ToString("£#,##0.00")</p>
    </div>

    <FormField Label="Notes (exclusions, caveats, lead times)">
    <textarea class="field" rows="3" @bind="notes"></textarea>
    </FormField>
    </LoadGate>
</Modal>
