@namespace Jewel.JPMS.Features.Cvr
@using static Jewel.JPMS.Features.Cvr.ProfitDisplay

@* Running profit by month — FIRST on the page (Jeremy, 2026-08-13 pm: "an easy one stop shop
   for what Nigel wants to see as a trend for the projects, and it is live", so the trend leads
   and the deal/certified table follows). Jeremy's running-balance format (2026-08-13): each
   cell's main figure is the project-to-date running % at that month end (the accountant's
   "Running % Profit"), the trend of the whole job, so one month's spike or fall can't
   masquerade as the position. The small print beneath is the month ON ITS OWN — its margin
   (his "Current Month % Profit") and its £ — and the cell's colour is whether the month made or
   lost money (Jeremy, 2026-09-07: the small print used to be the month's movement in the
   running %, with the colour following it; on a job running at 84% a month that made £31k at
   77% read red, so the page was being misread in the Monday meeting). Profit includes overheads
   tracked to the site, so the figures reconcile with his P&L exactly — Xero data only, no
   forecast snapshots (the accountant's call, 2026-08-05). The host builds the MovementModel in
   the table's own row order and owns the labour-accrual overlay and the low-invoicing floor;
   the basis switch and the floor live here because this is the first Xero panel a reader
   meets, and both are bound back to the page because every Xero panel reads the basis and the
   export reads the floor. The ‹ › page the six month columns back and forward in time (Jeremy,
   2026-09-10: "go back further… see what the run rate was prior"), a page of six at a time;
   the page owns the window and the bounds, this only renders the controls. "6-mo Δ" and
   "Position now" never move with the page — they are the job to date. *@
<div class="panel p-5 mb-6">
    <div class="flex items-start justify-between gap-x-6 gap-y-1 flex-wrap">
        <div>
            <p class="eyebrow">
                Running profit by month
                <span class="normal-case tracking-normal font-normal text-content-faint ml-2">— the whole job's % profit to date at each month end, that month on its own beneath · Xero site P&L, @BasisLabel</span>
            </p>
            <p class="text-xs text-content-muted mt-1 mb-3">
                The main figure is the whole job to that month end; the small print is that month on its own — its margin and its £; the colour is whether the month made or lost money. The last column is where the job stands to date.
            </p>
        </div>
        <div class="flex items-center gap-x-5 gap-y-1 flex-wrap">
            @* Paging the months: six earlier, six later, back to the latest six. Controls, never
               gated — a page with nothing to show is simply not offered (Disabled). *@
            <Toolbar>
                <ToolbarButton Icon="chevron-left" Label="Earlier — the six months before"
                               Disabled="@(!CanPageEarlier)" OnClick="OnPageEarlier" />
                <span class="text-xs text-content-subtle tabular-nums whitespace-nowrap px-1"
                      title="@(IsLatestWindow ? "The latest six months" : "Six earlier months — 6-mo Δ and Position now are still the job to date")">
                    @(Movement.Months[0].ToString("MMM yy")) – @(Movement.Months[^1].ToString("MMM yy"))
                </span>
                <ToolbarButton Icon="chevron-right" Label="Later — the six months after"
                               Disabled="@IsLatestWindow" OnClick="OnPageLater" />
                <ToolbarDivider />
                <ToolbarButton Icon="calendar-today" Label="Back to the latest six months"
                               Disabled="@IsLatestWindow" OnClick="OnPageToNow" />
            </Toolbar>
            @* The basis switch for every Xero panel on the page (grid, trajectory, cumulative
               charts) — a control, so never gated. Default OFF: pure Xero, exactly what the
               accountant reconciles. ON overlays approved timesheet cost that no Xero-approved
               bill settles yet, so the current month reads the portal's live labour position. *@
            <label class="flex w-fit items-center gap-2 text-xs text-content-subtle cursor-pointer select-none whitespace-nowrap"
                   title="Adds approved timesheet cost that no Xero-approved bill settles yet — the portal's live labour, marked • per cell. It drops out automatically as bills are approved in Xero, so closed months always converge back to Xero's own figures.">
                <input type="checkbox" class="cursor-pointer align-middle" checked="@IncludeLabourAccrual"
                       @onchange="args => IncludeLabourAccrualChanged.InvokeAsync(args.Value is true)" />
                Include approved labour not yet billed
            </label>
            @* The low-invoicing floor (Jeremy, 2026-09-07): a month invoicing less than this shows
               its £ only, greyed — £500 invoiced against £3,000 of bills is −500%, noise. A
               control, never gated; default £5,000. *@
            <label class="flex w-fit items-center gap-2 text-xs text-content-subtle select-none whitespace-nowrap"
                   title="A month invoicing less than this shows its £ only, greyed — too little invoicing for its margin to mean anything. The £ and the colour are unaffected.">
                Month % floor £
                <input type="number" class="field w-24 py-0.5 text-xs" min="0" step="500"
                       value="@(MonthPercentFloor.ToString("0"))"
                       @onchange="OnFloorChangedAsync" />
            </label>
        </div>
    </div>
    <RunningProfitTable Movement="Movement"
                        AccrualHover="AccrualHover"
                        AccrualOwnFor="AccrualOwnFor"
                        AccrualToDateFor="AccrualToDateFor" />
    <p class="text-xs text-content-subtle mt-3 max-w-3xl">
        <span class="text-content-muted">Main figure</span> — the whole job to that month end:
        cumulative profit (income less cost of sales less overheads tracked to the site, in Xero)
        over cumulative invoicing, exactly the accountant's "Running % Profit" row — so the row
        reads as the project's trend, and on the latest page the last month always agrees with
        "Position now" (the £ beneath it is the profit it is made of).
        <span class="text-content-muted">Small print</span> — that month on its own: the month's
        profit over the month's invoicing, then the month's profit or loss in £. ▲ or ▼ after the
        month's margin says it ran above or below the job's running % at the end of the month
        before — better or worse than the job so far — without colouring the cell. A month invoicing
        under the floor (@($"£{Movement.MonthPercentFloor:N0}"), set above) shows its £ only,
        greyed: too little invoicing for a margin to mean anything. A month with nothing invoiced
        shows its £ only.
        <span class="text-content-muted">Colour</span> — whether the month made or lost money:
        green is a month in profit, red a month in loss, plain where the month is nil. Nothing
        else drives it, so a red cell always means the month lost money, never that a profitable
        month happened to pull the average down.
        <span class="text-content-muted">Hover</span> a cell for the month's invoicing (so the
        margin can be checked), what the month did to the running % in points, and the position
        to date. "6-mo Δ" is the running % now against six months ago — "—" where the job wasn't
        invoiced back then. ‹ › page the month columns back six months at a time to see the run
        rate before; "6-mo Δ" and "Position now" stay the job to date whichever months are on
        screen, so an earlier page reads "where it was, where it is now". "n/a" is a job with costs but no invoicing at all yet — no honest
        percentage exists; the £ is beneath. "—" is a month before anything happened. Young jobs
        swing wildly by nature — deposits against little cost read absurdly high — so read them by
        the £, not the %. This grid reports the
        <span class="text-content-muted">invoiced</span> rung of the ladder and deducts site-tracked
        overheads, so its figures deliberately sit near, not on, the
        <span class="text-content-muted">certified</span> figures in the table below — a job with
        salaries tracked to its site reads lower here, and one with deposits invoiced ahead of
        certification reads higher. The Excel export carries this grid with the same small print
        and the same colour rule.
        @if (IncludeLabourAccrual)
        {
            <text>The basis switch is ON: months marked <span class="text-warning">•</span> include
            approved labour not yet billed — approved timesheet cost from the portal that no
            Xero-approved bill settles yet. It is an accrual, not a Xero figure: as each labourer's
            bill is approved in Xero the cost enters the synced P&L and leaves the accrual in the
            same moment, so nothing double-counts and closed months converge back to exactly what
            Xero says. Switch it off before reconciling against Xero itself. </text>
        }
        @if (Movement.Rows.Any(row => row.Stale))
        {
            <text>⚠ A job with no movement for six months usually means stalled or unbilled, not that nothing is happening on site. </text>
        }
        @if (Movement.Excluded.Count > 0)
        {
            <text>@string.Join(", ", Movement.Excluded.Select(project => project.Name)) @(Movement.Excluded.Count == 1 ? "has" : "have") no Xero site data yet — see the cards below.</text>
        }
    </p>
</div>

@code {
    [Parameter, EditorRequired] public MovementModel Movement { get; set; } = default!;
    /// <summary>The basis tag every Xero panel's subtitle carries ("invoiced basis").</summary>
    [Parameter] public string BasisLabel { get; set; } = "";
    [Parameter] public bool IncludeLabourAccrual { get; set; }
    [Parameter] public EventCallback<bool> IncludeLabourAccrualChanged { get; set; }

    /// <summary>The low-invoicing floor: a month invoicing under it shows its £ only. Bound to the page, which builds the model (and the export) from it.</summary>
    [Parameter] public decimal MonthPercentFloor { get; set; } = RunningMovement.DefaultMonthPercentFloor;
    [Parameter] public EventCallback<decimal> MonthPercentFloorChanged { get; set; }

    /// <summary>Paging the month columns — the page owns the window; these are its bounds and its moves.</summary>
    [Parameter] public bool IsLatestWindow { get; set; } = true;
    [Parameter] public bool CanPageEarlier { get; set; }
    [Parameter] public EventCallback OnPageEarlier { get; set; }
    [Parameter] public EventCallback OnPageLater { get; set; }
    [Parameter] public EventCallback OnPageToNow { get; set; }

    /// <summary>The host's labour-accrual overlay, handed on to the grid cell by cell.</summary>
    [Parameter, EditorRequired] public Func<string, DateTime, string> AccrualHover { get; set; } = default!;
    [Parameter, EditorRequired] public Func<string, DateTime, decimal> AccrualOwnFor { get; set; } = default!;
    [Parameter, EditorRequired] public Func<string, decimal> AccrualToDateFor { get; set; } = default!;

    // A blank or unreadable entry falls back to the default rather than to zero: zero would
    // silently print every month's % again, which is the noise the floor exists to stop.
    private Task OnFloorChangedAsync(ChangeEventArgs args) =>
        MonthPercentFloorChanged.InvokeAsync(
            decimal.TryParse(args.Value?.ToString(), out var floor) && floor >= 0m
                ? floor
                : RunningMovement.DefaultMonthPercentFloor);
}
