@namespace Jewel.JPMS.Features.Cvr
@using static Jewel.JPMS.Features.Cvr.ProfitDisplay

@* The running-profit grid: one row per job, one column per month end. Each cell's main figure
   is the running % to date (the trend of the whole project); the small print is the month on
   its own — its margin (▲/▼ against the running % at the end of the previous month) and its £.
   The COLOUR follows the sign of the month's £ and nothing else: green made money, red lost
   money, neutral nil (Jeremy, 2026-09-07 — a red cell must mean the month lost money). The
   movement in points and the month's invoicing are in the hover. A month invoicing under the
   floor shows its £ only, greyed. The host builds the MovementModel and owns the labour-accrual
   overlay — the three delegates carry its per-cell hover, dot and to-date figures. *@
<div class="overflow-x-auto">
    <table class="data-table data-table-dense" style="border-collapse:separate;border-spacing:3px">
        <thead>
            <tr>
                <th class="text-left">Project</th>
                @foreach (var month in Movement.Months)
                {
                    <th class="text-center whitespace-nowrap">@month.ToString("MMM yy")</th>
                }
                <th class="text-center whitespace-nowrap" title="Running % now against six months ago — the job to date, not the months on screen">6-mo Δ</th>
                <th class="text-center whitespace-nowrap" title="The job to date, whichever months are on screen">Position now</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Movement.Rows)
            {
                <tr>
                    <td class="text-left whitespace-nowrap">
                        <span class="text-content">@row.Project.Name</span>
                        <span class="block font-mono text-xs text-content-faint">@row.Project.Reference</span>
                    </td>
                    @for (var index = 0; index < row.MonthCells.Count; index++)
                    {
                        var cell = row.MonthCells[index];
                        var cellMonth = Movement.Months[index];
                        @if (cell.Empty)
                        {
                            <td class="text-center rounded text-xs text-content-faint" style="@MonthCellStyle(cell.Own)">—</td>
                        }
                        else if (cell.Running is not decimal runningLevel)
                        {
                            @* Costs have moved but nothing has EVER been invoiced — no honest running %. The
                               month's £ still colours the cell: a month of bills against no invoicing lost money. *@
                            <td class="text-center rounded text-xs text-content-faint" style="@MonthCellStyle(cell.Own)"
                                title="@($"{cellMonth:MMM yy} — nothing invoiced to date · profit to date {SignedMoneyCompact(cell.CumProfit)}{AccrualHover(row.Project.ProjectId, cellMonth)}")">
                                n/a
                                @if (!cell.Own.Empty)
                                {
                                    <span class="block text-xs font-normal mt-0.5">@SignedMoneyCompact(cell.Own.Profit)</span>
                                }
                            </td>
                        }
                        else
                        {
                            <td class="text-center rounded text-xs tabular-nums"
                                style="@MonthCellStyle(cell.Own)"
                                title="@(RunningCellHover(cellMonth, cell, Movement.MonthPercentFloor) + AccrualHover(row.Project.ProjectId, cellMonth))">
                                <span class="font-medium @ProfitClass(runningLevel)">@PctCell(runningLevel)</span>@if (AccrualOwnFor(row.Project.ProjectId, cellMonth) > 0m)
                                {<span class="text-warning ml-0.5" aria-hidden="true">•</span>}
                                <span class="block text-xs font-normal mt-0.5 @SmallPrintClass(cell)">@SmallPrint(cell, Movement.MonthPercentFloor)</span>
                            </td>
                        }
                    }
                    <td class="text-center text-xs font-semibold tabular-nums @ProfitClass(row.WindowDelta ?? 0m)"
                        title="@($"running % now vs 6 months ago — the job to date, whichever months are on screen · the latest six months: invoiced {MoneyCompact(row.Window.Income)} · profit {SignedMoneyCompact(row.Window.Profit)}")">
                        @(row.WindowDelta is decimal windowDelta ? SignedPp(windowDelta) : "—")
                    </td>
                    <td class="text-center rounded text-xs font-semibold whitespace-nowrap border @ProfitClass(row.RunningPercent ?? 0m)">
                        @(row.RunningPercent is decimal runningPct ? PctCell(runningPct) : "—")
                        <span class="block font-normal text-xs text-content-subtle mt-0.5">@MoneyCompact(row.PositionMoney)</span>
                        @if (AccrualToDateFor(row.Project.ProjectId) is > 0m and var accruedToDate)
                        {
                            <span class="block font-normal text-xs text-warning mt-0.5">incl. @MoneyCompact(accruedToDate) accrued</span>
                        }
                        @if (row.Stale)
                        {
                            <span class="block font-normal text-xs text-warning mt-0.5">⚠ no movement 6 mo</span>
                        }
                    </td>
                </tr>
            }
            @if (Movement.Rows.Count > 1)
            {
                <tr class="font-semibold">
                    <td class="text-left border-t text-content">
                        All jobs with Xero data
                        <span class="block font-normal text-xs text-content-faint">combined margin — total profit over total invoiced</span>
                    </td>
                    @for (var index = 0; index < Movement.ColumnTotals.Count; index++)
                    {
                        var total = Movement.ColumnTotals[index];
                        var totalMonth = Movement.Months[index];
                        <td class="text-center rounded text-xs border-t tabular-nums"
                            style="@MonthCellStyle(total.Own)"
                            title="@RunningCellHover(totalMonth, total, Movement.MonthPercentFloor)">
                            @if (total.Running is decimal totalPct)
                            {
                                <span class="@ProfitClass(totalPct)">@PctCell(totalPct)</span>
                                <span class="block text-xs font-normal mt-0.5 @SmallPrintClass(total)">@SmallPrint(total, Movement.MonthPercentFloor)</span>
                            }
                            else
                            {
                                <span class="text-content-faint">@(total.Empty ? "—" : "n/a")</span>
                            }
                        </td>
                    }
                    <td class="text-center text-xs border-t tabular-nums @ProfitClass(Movement.TotalWindowDelta ?? 0m)"
                        title="@($"running % now vs 6 months ago — the book to date, whichever months are on screen · the latest six months: invoiced {MoneyCompact(Movement.TotalWindow.Income)} · profit {SignedMoneyCompact(Movement.TotalWindow.Profit)}")">
                        @(Movement.TotalWindowDelta is decimal totalWindowDelta ? SignedPp(totalWindowDelta) : "—")
                    </td>
                    <td class="text-center text-xs border-t whitespace-nowrap @ProfitClass(Movement.TotalRunningPercent ?? 0m)">
                        @(Movement.TotalRunningPercent is decimal totalRunningPct ? PctCell(totalRunningPct) : "—")
                        <span class="block font-normal text-xs text-content-subtle mt-0.5">@MoneyCompact(Movement.TotalPositionMoney)</span>
                        @if (Movement.Rows.Sum(gridRow => AccrualToDateFor(gridRow.Project.ProjectId)) is > 0m and var totalAccrued)
                        {
                            <span class="block font-normal text-xs text-warning mt-0.5">incl. @MoneyCompact(totalAccrued) accrued</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public MovementModel Movement { get; set; } = default!;

    /// <summary>The host's labour-accrual overlay, per cell: the hover suffix…</summary>
    [Parameter, EditorRequired] public Func<string, DateTime, string> AccrualHover { get; set; } = default!;
    /// <summary>…the month's own accrued £ (a dot marks a cell carrying any)…</summary>
    [Parameter, EditorRequired] public Func<string, DateTime, decimal> AccrualOwnFor { get; set; } = default!;
    /// <summary>…and the to-date accrued £ for the Position column's memo.</summary>
    [Parameter, EditorRequired] public Func<string, decimal> AccrualToDateFor { get; set; } = default!;

    // The small print greys where the month % is suppressed (invoicing under the floor, or nil):
    // the £ is still a fact, but it is not the month's margin and shouldn't read like one.
    private string SmallPrintClass(RunningCell cell) =>
        cell.MonthPercent(Movement.MonthPercentFloor) is null ? "text-content-faint" : "text-content-muted";
}
