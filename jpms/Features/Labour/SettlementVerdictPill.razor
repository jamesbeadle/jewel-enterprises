@namespace Jewel.JPMS.Features.Labour

@* The schedule's one-word reconciliation verdict against the covered bill. *@
@switch (Schedule.Verdict)
{
    case ScheduleVerdict.Matches:
        <Pill Tone="Tone.Positive" Title="@(Schedule.PostedVariance == 0m ? null : $"Matches with a £{Schedule.PostedVariance:N2} variance posted")">Matches</Pill>
        break;
    case ScheduleVerdict.VarianceOpen:
        <Pill Tone="Tone.Negative" Title="@($"Covered bill differs by £{Schedule.Difference:N2}")">Variance £@Math.Abs(Schedule.Difference).ToString("N0")</Pill>
        break;
    case ScheduleVerdict.NoBillYet:
        <Pill Tone="Tone.Muted">No bill yet</Pill>
        break;
    default:
        <span class="text-content-faint text-xs">—</span>
        break;
}

@code {
    [Parameter, EditorRequired] public WorkerSettlementSchedule Schedule { get; set; } = default!;
}
