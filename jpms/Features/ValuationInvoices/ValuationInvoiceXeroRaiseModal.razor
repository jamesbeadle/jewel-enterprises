@namespace Jewel.JPMS.Features.ValuationInvoices
@inject IValuationInvoiceStore Invoices

@* Raise in Xero (2026-09-09, the accountant's ask): the claim card's Issue step, showing what Xero
   will hold BEFORE it is raised — client, net, VAT reading, Sites option, due date, the certificate
   to attach — and every reason it would be refused. One press raises the AUTHORISED sales invoice
   in Xero and issues the valuation invoice. "Issue without Xero" is the old move, for an invoice
   someone raised in Xero by hand. *@
<Modal IsOpen="open" Title="@($"Raise {reference} in Xero")" ShowFooter="true"
       ConfirmLabel="@(raising ? "Raising…" : "Raise in Xero and issue")" CancelLabel="Cancel"
       ConfirmDisabled="@(raising || issuing || preview is null || !preview.CanRaise)"
       OnCancel="Close" OnConfirm="RaiseAsync" Class="max-w-2xl w-full">
    @if (error is not null)
    {
        <Notice Tone="Tone.Negative" Class="mb-3">@error</Notice>
    }
    <LoadGate IsLoading="@(preview is null && error is null)" Prominent="true" Label="Reading Xero">
        @if (preview is not null)
        {
            @foreach (var blocker in preview.Blockers)
            {
                <Notice Tone="Tone.Negative" Class="mb-3">@blocker</Notice>
            }
            <ValuationInvoiceXeroRaiseSummary Preview="preview" />
            <p class="text-sm text-content-subtle mt-4">
                Raising creates the invoice in Xero as authorised (awaiting payment) and issues @reference here —
                certified to date moves. Xero cannot un-raise it from the portal; a wrong invoice is voided in Xero.
            </p>
            <div class="mt-3">
                <button type="button" class="btn-secondary" disabled="@(raising || issuing)" @onclick="IssueWithoutXeroAsync"
                        title="For an invoice already raised in Xero by hand — records it as issued and raises nothing">
                    @(issuing ? "Issuing…" : "Issue without raising in Xero")
                </button>
            </div>
        }
    </LoadGate>
</Modal>
