@namespace Jewel.JPMS.Features.Variations

@* The approve dialog. Approval runs from any pre-approved status. With a recorded tender (a
   subcontractor and agreed value) this is the normal end of the pipeline; without one it is a
   MANUAL approval — the route for historic (seeded) and client-instructed variations that never
   tendered. The write-through (Valuation Report, CVR, cost-centre budgets) is identical either
   way. The build-up is captured in a modal (VariationApprovePanel) — the sidebar is too narrow
   for the line table — and the open flag is bound, because it is opened from the page's bar: the
   primary button, the Actions menu and the status pill's "Approved…" pick all land here. (The
   sidebar panel that used to carry the button is gone — the bar is where actions live.) *@
<Modal IsOpen="ModalOpen"
       Title="@($"{(IsManual ? "Approve manually" : "Approve")} {Order.DisplayNumber} — {Order.Title}")"
       ShowFooter="false"
       OnCancel="() => ModalOpenChanged.InvokeAsync(false)"
       Class="max-w-3xl">
    @* Pre-seeded from the staged agreed build-up when there is one, so approval
       is a check of the agreed lines rather than a retype of them. *@
    <VariationApprovePanel IsManual="@IsManual"
                           ShowHeading="false"
                           EstimatedValue="Order.EstimatedValue"
                           DefaultDescription="@Order.Title"
                           InitialLines="@Order.DraftLines"
                           Busy="@Busy"
                           OnApprove="OnApprove" />
</Modal>

@code {
    [Parameter, EditorRequired] public VariationOrder Order { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    /// <summary>Bound: the page's bar (primary button, Actions menu, status pill) opens it.</summary>
    [Parameter] public bool ModalOpen { get; set; }
    [Parameter] public EventCallback<bool> ModalOpenChanged { get; set; }
    /// <summary>The build-up to approve with — the page writes it through.</summary>
    [Parameter] public EventCallback<VariationApprovePanel.ApproveRequest> OnApprove { get; set; }

    private bool IsManual => string.IsNullOrEmpty(Order.SelectedSubcontractorId);
}
