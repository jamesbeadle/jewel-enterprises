@namespace Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Features.Triage.Workspace
@inject IIntakeQueue Intake

@*
    A browsable correspondence list in the house card style: one card per CONVERSATION (Graph's
    ConversationId), newest thread first, the latest email leading its card with the earlier
    members folded behind a "Thread · N emails" toggle. Any email expands in place to its full
    body — read live on demand, exactly like the request conversation and programme panels — and
    the expanded view lists the attachments with Preview (into the workspace Preview pane, when
    the host passes OnPreview) and Download. Built for gathering context and copy/paste while
    working an email in the other window. A host that passes OnReply also gets a Reply button on
    every email (and OnForward a Forward button) — the consistent reply/forward affordance
    wherever a communication is listed: record pages send there and then; the Control Centre
    lines the email up in its Outbox instead. A host that passes OnUntagged (with ExcludeTag set)
    additionally gets an Untag button per email: it removes THIS record's tag from that one email
    — armed on first press, confirmed on second, so a stray click can't unfile correspondence.
    An email left with no JPMS tag at all is back in the Control Centre queue by definition (the
    queue IS the untagged inbox), so untagging is always recoverable from triage. A host with its
    own per-email verbs (the bid package's Extract / Discard, 2026-09-07) passes EmailActions — a
    fragment rendered in the action row after the built-in buttons — and can set
    GroupByConversation="false" to list one card per email (a list where every email is its own
    candidate, not a thread to fold).
*@

<ul class="space-y-2">
    @foreach (var thread in Threads)
    {
        <li @key="thread.Key" class="rounded border border-line bg-surface px-4 py-3">
            @EmailEntry(thread.Latest, thread)

            @if (thread.Earlier.Count > 0 && expandedThreads.Contains(thread.Key))
            {
                <div class="mt-3 pl-3 border-l-2 border-line space-y-3">
                    @foreach (var member in thread.Earlier)
                    {
                        <div @key="member.Id">@EmailEntry(member, null)</div>
                    }
                </div>
            }
        </li>
    }
</ul>

@code {
    /// <summary>Every email to list — the component groups them into conversations itself.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<MailboxMessage> Emails { get; set; } = Array.Empty<MailboxMessage>();

    /// <summary>The tag that IS this list's premise (e.g. the open record's own "JPMS/RFI-001") —
    /// excluded from the chip rows, which show where ELSE an email is filed.</summary>
    [Parameter] public string ExcludeTag { get; set; } = "";

    /// <summary>Open an attachment in the workspace Preview pane. Without a delegate the
    /// attachments still list with Download links — Preview simply isn't offered.</summary>
    [Parameter] public EventCallback<PreviewRequest> OnPreview { get; set; }

    /// <summary>Start a reply to an email in the list. Without a delegate no Reply button renders
    /// — the host decides whether replying is offered here, and what it means (send now on a
    /// record page; line up in the Outbox in the Control Centre).</summary>
    [Parameter] public EventCallback<MailboxMessage> OnReply { get; set; }

    /// <summary>Start a FORWARD of an email in the list — same host semantics as
    /// <see cref="OnReply"/> (send now on a record page; line up in the Outbox in the Control
    /// Centre). Without a delegate no Forward button renders.</summary>
    [Parameter] public EventCallback<MailboxMessage> OnForward { get; set; }

    /// <summary>Raised after this record's tag (<see cref="ExcludeTag"/>) has been removed from an
    /// email — the host reloads its list so the email disappears from it. Without a delegate no
    /// Untag button renders; with one, ExcludeTag must be the record's full "JPMS/…" tag.</summary>
    [Parameter] public EventCallback<MailboxMessage> OnUntagged { get; set; }

    /// <summary>"Tag like this": stage the host's open email with the same tags as a listed one.
    /// The Control Centre's browsers pass it (Nigel, 2026-08-22 — he reads a past thread and
    /// expects to file the open email alongside it from the same list). Without a delegate no
    /// button renders; <see cref="TagLikeLabel"/> is the button's wording.</summary>
    [Parameter] public EventCallback<MailboxMessage> OnTagLike { get; set; }
    [Parameter] public string TagLikeLabel { get; set; } = "Tag open email like this";

    /// <summary>Host-specific verbs for one email, rendered in its action row after the built-in
    /// buttons (Reply, Forward, thread toggle…). Null = none.</summary>
    [Parameter] public RenderFragment<MailboxMessage>? EmailActions { get; set; }

    /// <summary>Extra content under an email's header line (a status pill, a note) — rendered
    /// before the body preview. Null = none.</summary>
    [Parameter] public RenderFragment<MailboxMessage>? EmailBadge { get; set; }

    /// <summary>True (default): one card per conversation, earlier members folded behind the
    /// thread toggle. False: one card per email, newest first — for lists where each email stands
    /// on its own.</summary>
    [Parameter] public bool GroupByConversation { get; set; } = true;

    private readonly HashSet<string> expandedThreads = new();
    private readonly HashSet<string> expandedEmails = new();
    // Detail cached for the component's life: null value = fetch in flight ("Loading full email…").
    private readonly Dictionary<string, MailboxMessageDetail?> details = new();

    private sealed record ThreadGroup(string Key, MailboxMessage Latest, IReadOnlyList<MailboxMessage> Earlier);

    // Emails without a ConversationId (Graph occasionally omits it) each stand as their own card.
    private List<ThreadGroup> Threads =>
        Emails
            .GroupBy(email => !GroupByConversation || string.IsNullOrEmpty(email.ConversationId) ? $"single:{email.Id}" : email.ConversationId)
            .Select(group =>
            {
                var newestFirst = group.OrderByDescending(email => email.ReceivedAt).ToList();
                return new ThreadGroup(group.Key, newestFirst[0], newestFirst.Skip(1).ToList());
            })
            .OrderByDescending(thread => thread.Latest.ReceivedAt)
            .ToList();

    // One email's entry — the card lead when `thread` is passed (it carries the thread toggle),
    // or an earlier thread member when null.
    private RenderFragment EmailEntry(MailboxMessage email, ThreadGroup? thread) => __builder =>
    {
        var detail = details.GetValueOrDefault(email.Id);
        var isExpanded = expandedEmails.Contains(email.Id);

        <div class="min-w-0">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="text-sm font-medium text-content truncate">@(string.IsNullOrWhiteSpace(email.FromName) ? email.FromEmail : email.FromName)</span>
                <span class="text-xs text-content-subtle">@DateTimeText(email.ReceivedAt)</span>
            </div>
            <p class="text-sm text-content mt-0.5">
                @email.Subject
                @if (email.HasAttachments)
                {
                    <Pill Tone="Tone.Muted" Class="ml-2">attachment</Pill>
                }
            </p>
            @if (OtherTags(email) is { Count: > 0 } chips)
            {
                <div class="flex flex-wrap items-center gap-1 mt-1">
                    @foreach (var tag in chips)
                    {
                        <Pill Tone="Tone.Info">@TagStem(tag)</Pill>
                    }
                </div>
            }
            @if (EmailBadge is not null)
            {
                @EmailBadge(email)
            }

            @if (isExpanded)
            {
                <div class="mt-2 rounded bg-surface-raised border border-line p-3 max-h-[28rem] overflow-y-auto">
                    @if (detail is null)
                    {
                        <p class="text-sm text-content-subtle italic">Loading full email…</p>
                    }
                    else
                    {
                        @if (detail.To is { Count: > 0 } to)
                        {
                            <p class="text-xs text-content-subtle truncate">To: @string.Join("; ", to)</p>
                        }
                        @if (detail.Cc is { Count: > 0 } cc)
                        {
                            <p class="text-xs text-content-subtle truncate">Cc: @string.Join("; ", cc)</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(detail.BodyHtml) && detail.BodyIsHtml)
                        {
                            <div class="rounded bg-white text-gray-900 p-3 text-sm overflow-x-auto mt-1">@((MarkupString)detail.BodyHtml)</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(detail.BodyHtml))
                        {
                            <p class="text-sm text-content whitespace-pre-wrap mt-1">@detail.BodyHtml</p>
                        }
                        else
                        {
                            <p class="text-sm text-content whitespace-pre-wrap mt-1">@email.BodyPreview</p>
                        }
                    }
                </div>
                @if (detail is { Attachments.Count: > 0 })
                {
                    <div class="mt-2 rounded bg-surface-raised border border-line p-3">
                        <p class="eyebrow mb-2">
                            @detail.Attachments.Count attachment@(detail.Attachments.Count == 1 ? "" : "s")
                        </p>
                        <ul class="space-y-1">
                            @foreach (var attachment in detail.Attachments)
                            {
                                <li class="flex items-center justify-between gap-3 text-sm text-content">
                                    <span class="truncate">@attachment.Name</span>
                                    <span class="flex items-center gap-3 whitespace-nowrap">
                                        @if (attachment.Size > 0)
                                        {
                                            <span class="text-xs text-content-subtle">@FormatSize(attachment.Size)</span>
                                        }
                                        @if (!string.IsNullOrEmpty(attachment.Id))
                                        {
                                            @if (OnPreview.HasDelegate && IsPreviewable(attachment))
                                            {
                                                <button type="button" class="text-xs text-accent hover:underline"
                                                        @onclick="() => OpenAttachmentPreviewAsync(email, attachment)">
                                                    Preview
                                                </button>
                                            }
                                            <a href="@AttachmentUrl(email, attachment, inline: false)" target="_blank" rel="noopener"
                                               class="text-xs text-accent hover:underline">Download</a>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                }
                else if (email.HasAttachments && detail is not null && detail.Attachments.Count == 0)
                {
                    <p class="text-xs text-content-subtle italic mt-1">This email has attachments, but their names couldn't be retrieved.</p>
                }
            }
            else if (!string.IsNullOrWhiteSpace(email.BodyPreview))
            {
                <p class="text-xs text-content-subtle mt-1 line-clamp-2">@email.BodyPreview</p>
            }

            <div class="mt-2 flex flex-wrap items-center gap-4">
                <button type="button" class="text-xs font-medium text-accent hover:underline"
                        @onclick="() => ToggleEmailAsync(email)">
                    @(isExpanded ? "Show summary" : "Show full email")
                </button>
                @if (OnReply.HasDelegate)
                {
                    <button type="button" class="text-xs font-medium text-accent hover:underline"
                            @onclick="() => OnReply.InvokeAsync(email)">↩ Reply</button>
                }
                @if (OnForward.HasDelegate)
                {
                    <button type="button" class="text-xs font-medium text-accent hover:underline"
                            @onclick="() => OnForward.InvokeAsync(email)">→ Forward</button>
                }
                @if (OnTagLike.HasDelegate)
                {
                    <button type="button" class="text-xs font-medium text-accent hover:underline"
                            title="Stages the open email with the same tags as this one — applied by the inbox's Apply"
                            @onclick="() => OnTagLike.InvokeAsync(email)">🏷 @TagLikeLabel</button>
                }
                @if (thread is { } threadGroup && threadGroup.Earlier.Count > 0)
                {
                    <button type="button" class="text-xs font-medium text-accent hover:underline"
                            @onclick="() => ToggleThread(threadGroup.Key)">
                        @(expandedThreads.Contains(threadGroup.Key)
                            ? "Hide earlier emails"
                            : $"Thread · {threadGroup.Earlier.Count + 1} emails")
                    </button>
                }
                @if (EmailActions is not null)
                {
                    @EmailActions(email)
                }
                @if (OnUntagged.HasDelegate && !string.IsNullOrWhiteSpace(ExcludeTag))
                {
                    @if (untagging.Contains(email.Id))
                    {
                        <span class="text-xs text-content-subtle italic">Untagging…</span>
                    }
                    else if (untagArmed.Contains(email.Id))
                    {
                        <button type="button" class="text-xs font-medium text-negative hover:underline"
                                @onclick="() => UntagAsync(email)">
                            Untag from @TagStem(ExcludeTag)? Press to confirm
                        </button>
                    }
                    else
                    {
                        <button type="button" class="text-xs font-medium text-content-subtle hover:text-negative"
                                @onclick="() => untagArmed.Add(email.Id)">Untag</button>
                    }
                }
            </div>
            @if (untagErrors.TryGetValue(email.Id, out var untagError))
            {
                <p class="text-xs text-negative mt-1">@untagError</p>
            }
        </div>
    };

    // ---- Untag: remove THIS record's tag from one email --------------------------------------
    // Armed-then-confirm on purpose: unfiling correspondence is cheap to redo (Find & tag, or
    // triage) but confusing to do by accident. Only the record's own tag is ever touched — an
    // email filed to other records keeps those tags, and one left with no JPMS tag at all is
    // simply back in the Control Centre queue.

    private readonly HashSet<string> untagArmed = new();
    private readonly HashSet<string> untagging = new();
    private readonly Dictionary<string, string> untagErrors = new();

    private async Task UntagAsync(MailboxMessage email)
    {
        untagArmed.Remove(email.Id);
        untagErrors.Remove(email.Id);
        untagging.Add(email.Id);
        try
        {
            await Intake.RemoveTagFromMessageAsync(email.Id, email.InternetMessageId, ExcludeTag);
            await OnUntagged.InvokeAsync(email);
        }
        catch
        {
            untagErrors[email.Id] = "Couldn't untag that email. Please try again.";
        }
        finally
        {
            untagging.Remove(email.Id);
        }
    }

    private void ToggleThread(string key)
    {
        if (!expandedThreads.Add(key)) expandedThreads.Remove(key);
    }

    private async Task ToggleEmailAsync(MailboxMessage email)
    {
        if (!expandedEmails.Add(email.Id))
        {
            expandedEmails.Remove(email.Id);
            return;
        }
        if (details.ContainsKey(email.Id)) return;
        details[email.Id] = null;
        try
        {
            details[email.Id] = await Intake.GetMessageDetailAsync(email.Id, email.InternetMessageId);
        }
        catch
        {
            // The query client has reported the failure; the pane degrades to the preview text.
            details[email.Id] = new MailboxMessageDetail(email.Id, "", false, Array.Empty<IntakeAttachment>());
        }
    }

    private IReadOnlyList<string> OtherTags(MailboxMessage email) =>
        email.Categories
            .Where(tag => !tag.Equals(ExcludeTag, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private static string TagStem(string tag) =>
        tag.StartsWith("JPMS/", StringComparison.OrdinalIgnoreCase) ? tag["JPMS/".Length..] : tag;

    // Same previewable set as triage's attachment tray: PDFs (the in-app viewer) and images.
    private static bool IsPreviewable(IntakeAttachment attachment)
    {
        var type = attachment.ContentType ?? "";
        return type.Contains("pdf", StringComparison.OrdinalIgnoreCase)
            || type.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    }

    // Ids go in the query string, never the path — Graph ids don't survive a URL path segment.
    private static string AttachmentUrl(MailboxMessage email, IntakeAttachment attachment, bool inline) =>
        $"/api/mailbox/message/attachment?id={Uri.EscapeDataString(email.Id)}"
        + $"&aid={Uri.EscapeDataString(attachment.Id)}{(inline ? "&inline=1" : "")}";

    private Task OpenAttachmentPreviewAsync(MailboxMessage email, IntakeAttachment attachment)
    {
        var isPdf = (attachment.ContentType ?? "").Contains("pdf", StringComparison.OrdinalIgnoreCase);
        return OnPreview.InvokeAsync(new PreviewRequest(
            attachment.Name,
            AttachmentUrl(email, attachment, inline: true),
            AttachmentUrl(email, attachment, inline: false),
            isPdf));
    }

}
