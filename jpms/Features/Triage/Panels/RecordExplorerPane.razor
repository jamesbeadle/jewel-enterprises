@namespace Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Features.Triage.Workspace
@inject IIntakeQueue Intake
@inject IQueryClient Queries

@*
    The record explorer: search any system document and read it in this window — built for the
    side-by-side flow (an email one side, the RFI it answers the other). Pick a project and a
    record type, narrow by text, open a record. With no project chosen, Requests / RFIs searches
    the register across every project. Reading is this pane's job; editing stays on the record's
    own page (linked from the open document).
*@

@if (openRecord is { } record)
{
    <RecordDocumentView Record="record" OnBack="() => openRecord = null" OnPreview="OnPreview" OnReply="OnReply" OnForward="OnForward" />
}
else
{
    <div class="space-y-3">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <select class="field" value="@projectId" @onchange="OnProjectChanged">
                <option value="">All projects (RFIs only)…</option>
                @foreach (var project in Projects)
                {
                    <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                }
            </select>
            <select class="field" value="@((int)recordType)" @onchange="OnTypeChanged">
                @foreach (var type in ExplorerRecordTypes.All)
                {
                    <option value="@((int)type)">@ExplorerRecordTypes.Label(type)</option>
                }
            </select>
        </div>
        <SearchInput @bind-Value="search" Placeholder="Search reference, title or description…" />
        <label class="flex w-fit items-center gap-2 text-xs text-content-subtle cursor-pointer select-none"
               title="The list defaults to live records — tick to also list closed, rejected and completed ones">
            <input type="checkbox" class="cursor-pointer align-middle" checked="@shouldIncludeInactive"
                   @onchange="e => shouldIncludeInactive = e.Value is true" />
            <span>
                Include closed / inactive records
                @if (!shouldIncludeInactive && HiddenInactiveCount > 0)
                {
                    <span class="text-content-faint">(@HiddenInactiveCount hidden)</span>
                }
            </span>
        </label>

        <LoadGate IsLoading="loading" Label="Searching records">
        @if (records is null)
        {
            <p class="text-sm text-content-subtle">Pick a project (or search RFIs across all projects) to list records.</p>
        }
        else if (FilteredRecords.Count == 0)
        {
            <p class="text-sm text-content-subtle">No @ExplorerRecordTypes.Label(recordType).ToLowerInvariant() records match.</p>
        }
        else
        {
            <div class="space-y-1.5">
                @foreach (var result in FilteredRecords)
                {
                    <button type="button" @key="result.RecordId" @onclick="() => openRecord = result"
                            class="w-full text-left rounded border border-line hover:border-line-strong hover:bg-surface-raised transition px-3 py-2">
                        <div class="flex items-baseline justify-between gap-2">
                            <span class="text-sm text-content truncate">
                                <span class="font-mono text-xs text-content-muted mr-2">@result.Reference</span>@result.Title
                            </span>
                            @if (!string.IsNullOrWhiteSpace(result.StatusLabel))
                            {
                                <Pill Tone="Tone.Info" Class="shrink-0">@result.StatusLabel</Pill>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(result.Summary))
                        {
                            <p class="text-xs text-content-subtle truncate mt-0.5">@result.Summary</p>
                        }
                    </button>
                }
                @if (FilteredRecords.Count == ResultCap)
                {
                    <p class="text-xs text-content-subtle px-1">Showing the first @ResultCap matches — narrow the search for the rest.</p>
                }
            </div>
        }
        </LoadGate>
    </div>
}
