@namespace Jewel.JPMS.Features.Triage.Panels
@inject IXeroTransactionStore Xero

@*
    The Xero explorer: search and read the live Xero transactions in a workspace window — an
    invoice open one side while the email querying it is answered on the other. Same live
    passthrough store as the Finance → Xero page; reading only, recoding stays over there.
*@

@if (openTransaction is { } transaction)
{
    <XeroTransactionView @key="transaction.TransactionId" Transaction="transaction"
                         OnBack="() => openTransaction = null" OnPreview="OnPreview" />
}
else if (Xero.Snapshot() is not { } snapshot)
{
    @if (loadFailed)
    {
        <Notice Tone="Tone.Negative">
            Couldn't read Xero. The reason is in the red bar above — reload to try again.
        </Notice>
    }
    else
    {
        <LoadGate IsLoading="true" Label="Reading Xero" />
    }
}
else if (!snapshot.IsConfigured)
{
    <div class="panel p-6 text-sm text-content-subtle">Xero isn't configured for this environment.</div>
}
else
{
    <div class="space-y-3">
        @if (snapshot.Error is { } error)
        {
            <Notice Tone="Tone.Negative">@error</Notice>
        }
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <SearchInput @bind-Value="search" Placeholder="Search contact, number or reference…" />
            <select class="field" @bind="typeFilter">
                <option value="">All transaction types</option>
                <option value="ACCPAY">Purchase invoices (bills)</option>
                <option value="ACCPAYCREDIT">Supplier credit notes</option>
                <option value="ACCREC">Sales invoices</option>
            </select>
        </div>

        @if (FilteredTransactions.Count == 0)
        {
            <EmptyState Message="No Xero transactions match." />
        }
        else
        {
            <div class="space-y-1.5">
                @foreach (var row in FilteredTransactions)
                {
                    <button type="button" @key="row.TransactionId" @onclick="() => openTransaction = row"
                            class="w-full text-left rounded border border-line hover:border-line-strong hover:bg-surface-raised transition px-3 py-2">
                        <div class="flex items-baseline justify-between gap-2">
                            <span class="text-sm text-content truncate">@(row.ContactName ?? "(no contact)")</span>
                            <span class="text-sm text-content tabular-nums shrink-0">@row.Total.ToString("N2")</span>
                        </div>
                        <div class="flex items-baseline justify-between gap-2 mt-0.5">
                            <span class="text-xs text-content-subtle truncate">@(row.Number ?? row.Reference ?? row.TransactionId) · @TypeLabel(row.Type)</span>
                            <span class="text-xs text-content-subtle shrink-0">@(row.Date?.ToString("d MMM yyyy") ?? "—") · @row.Status</span>
                        </div>
                    </button>
                }
                @if (FilteredTransactions.Count == ResultCap)
                {
                    <p class="text-xs text-content-subtle px-1">Showing the first @ResultCap matches — narrow the search for the rest.</p>
                }
            </div>
        }
    </div>
}
