@namespace Jewel.JPMS.Features.Xero
@using static Jewel.JPMS.Features.Xero.XeroLedgerDisplay

@* The bill's lines exactly as the supplier raised them — the 321/322 CIS labour / materials
   split is theirs and Xero's, and nothing on this card changes it. The order figures above are
   spread over these lines portal-side at approval; the lines themselves are only ever read. *@
<div class="overflow-x-auto">
    <table class="data-table data-table-dense">
        <thead>
            <tr class="text-left eyebrow">
                <th>Xero line — left as raised</th>
                <th class="w-40">Account</th>
                <th class="w-32 text-right">Net</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Lines)
            {
                <tr @key="line.XeroLedgerLineId">
                    <td class="max-w-0">
                        <span class="block truncate text-content" title="@line.Description">@(line.Description ?? "—")</span>
                        @if (line.Type == "ACCPAYCREDIT")
                        {
                            <span class="text-xs font-medium border border-line rounded px-1.5 py-0.5">Credit</span>
                        }
                    </td>
                    <td class="text-content-muted whitespace-nowrap">@(line.AccountCode ?? "—") @(line.AccountName ?? "")</td>
                    <td class="text-right text-content font-medium whitespace-nowrap">@Money(SignedNet(line))</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<XeroLedgerLine> Lines { get; set; } = default!;
}
