@namespace Jewel.JPMS.Features.Xero
@using static Jewel.JPMS.Features.Xero.XeroLedgerDisplay

@* The bill's lines exactly as Dext published them (account codes untouched — the 321/322 CIS
   split is Xero's), each with the coding the portal proposes from its order: shares on the
   order's codes, movable between them — and, since 2026-09-09, across the supplier's other
   open orders — before approval. *@
<div class="overflow-x-auto">
    <table class="data-table">
        <thead>
            <tr class="text-left eyebrow">
                <th>Line</th>
                <th class="w-32">Account</th>
                <th class="w-32 text-right">Net</th>
                <th class="w-[28rem]">Coding from the order</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Lines)
            {
                <tr @key="line.XeroLedgerLineId">
                    <td class="max-w-0">
                        <span class="block truncate text-content" title="@line.Description">@(line.Description ?? "—")</span>
                        @if (line.Type == "ACCPAYCREDIT")
                        {
                            <span class="text-xs font-medium border border-line rounded px-1.5 py-0.5">Credit</span>
                        }
                    </td>
                    <td class="text-content-muted whitespace-nowrap">@(line.AccountCode ?? "—") @(line.AccountName ?? "")</td>
                    <td class="text-right text-content font-medium whitespace-nowrap">@Money(SignedNet(line))</td>
                    <td>
                        <WorkOrderBillShareEditor Shares="SharesFor(line)" LineNet="@line.Net" Orders="Orders"
                                                  CostCenterText="CostCenterText" Disabled="@Busy" OnChanged="OnChanged" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<XeroLedgerLine> Lines { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<WorkOrderBillOrderOption> Orders { get; set; } = default!;
    [Parameter, EditorRequired] public Func<XeroLedgerLine, List<WorkOrderBillShareDraft>> SharesFor { get; set; } = default!;
    [Parameter, EditorRequired] public Func<string?, string> CostCenterText { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
}
