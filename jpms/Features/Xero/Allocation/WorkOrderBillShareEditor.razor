@namespace Jewel.JPMS.Features.Xero

@* A multi-code order's line: its net shared across the order's own codes. The codes are the
   order's and fixed; only the amounts move, and the tally says when they add up. *@
<div class="space-y-1.5">
    @foreach (var share in Shares)
    {
        <div class="flex items-center gap-2">
            <span class="grow min-w-0 truncate text-content" title="@CostCenterText(share.Code)">@CostCenterText(share.Code)</span>
            <input class="field w-32 text-right" type="number" step="0.01" disabled="@Disabled"
                   value="@share.Amount" @onchange="e => share.Amount = ParseAmount(e.Value)" />
        </div>
    }
    <p class="text-xs @(IsBalanced ? "text-content-subtle" : "text-negative")">
        @Money(Total) of @Money(LineNet)@(IsBalanced ? "" : $" — {Money(LineNet - Total)} to place")
    </p>
</div>

@code {
    /// <summary>Page-owned: edited in place so the card's Approve reads the same list.</summary>
    [Parameter, EditorRequired] public List<XeroSplitDraft> Shares { get; set; } = default!;
    [Parameter] public decimal LineNet { get; set; }
    [Parameter, EditorRequired] public Func<string?, string> CostCenterText { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }

    private decimal Total => Shares.Sum(share => share.Amount ?? 0m);
    private bool IsBalanced => Total == LineNet;

    private static decimal? ParseAmount(object? value) =>
        decimal.TryParse(value?.ToString(), System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture, out var amount) ? amount : null;
}
