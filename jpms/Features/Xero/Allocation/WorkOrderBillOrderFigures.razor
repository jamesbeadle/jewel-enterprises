@namespace Jewel.JPMS.Features.Xero

@* The order's money as the card needs it: value, invoiced so far (off the linked bills), and
   what is left once THIS bill is approved. A shortfall goes negative and says so — Approve is
   held while it does. *@
<div class="px-5 py-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
    <StatTile Label="Order value" Value="@Money(Match.OrderValue)" Title="@($"{Match.WorkOrderReference} as approved")" />
    <StatTile Label="Invoiced to date" Value="@Money(Match.InvoicedToDate)" Title="Bills already linked to the order, before this one" />
    <StatTile Label="Remaining after this bill" Title="Order value less invoiced to date less this bill's net">
        <p class="text-xl font-medium @(RemainingAfterBill < 0m ? "text-negative" : "text-content")">@Money(RemainingAfterBill)</p>
        @if (RemainingAfterBill < 0m)
        {
            <p class="text-xs font-medium text-negative mt-1">Over the order's value</p>
        }
    </StatTile>
</div>

@code {
    [Parameter, EditorRequired] public WorkOrderBillMatch Match { get; set; } = default!;
    /// <summary>This bill's net, signed (a credit note gives value back to the order).</summary>
    [Parameter] public decimal BillNet { get; set; }

    private decimal RemainingAfterBill => Match.OrderValue - Match.InvoicedToDate - BillNet;
}
