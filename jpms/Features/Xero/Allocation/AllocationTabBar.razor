@namespace Jewel.JPMS.Features.Xero

@* The incoming queue is split by project: a line whose project is real — saved via Set, or
   suggested by its Xero tracking — sits in that project's tab, so people working a specific
   project approve just their own costs. Dropdown picks alone don't move rows; Set/Allocate
   do. "Unallocated" keeps only the lines nothing points at a project yet. *@
<div class="inline-flex flex-wrap rounded border border-line overflow-hidden">
    <button class="@StatusClass(XeroAllocationStatus.Unallocated)" @onclick="() => OnSwitchStatus.InvokeAsync(XeroAllocationStatus.Unallocated)">
        Unallocated (@UnassignedCount)
    </button>
    @foreach (var tab in ProjectTabs)
    {
        var projectId = tab.ProjectId;
        <button class="@ProjectClass(projectId)" @onclick="() => OnSwitchProject.InvokeAsync(projectId)">
            @tab.Name (@tab.Count)
        </button>
    }
    @* Labour recognition (scope §6): bills whose supplier is a worker on the
       labour registry are settlement of timesheets, not costs to allocate — they
       fall in this section instead of the queue. The count is the outstanding
       (unmarked) lines, the actionable number, like every other tab. *@
    @if (ShowLabour)
    {
        <button class="@LabourClass" @onclick="() => OnSwitchLabour.InvokeAsync()">
            Labour (@LabourOutstandingCount)
        </button>
    }
    @* Work Order bills (2026-09-08): bills whose supplier has an open work order were decided
       when the order was approved — they sit here pre-filled from the order, one card per
       bill, waiting for one Approve. The count is bills, not lines. *@
    @if (ShowWorkOrderBills)
    {
        <button class="@WorkOrderBillsClass" @onclick="() => OnSwitchWorkOrderBills.InvokeAsync()">
            Work Order bills (@WorkOrderBillCount)
        </button>
    }
    <button class="@StatusClass(XeroAllocationStatus.Allocated)" @onclick="() => OnSwitchStatus.InvokeAsync(XeroAllocationStatus.Allocated)">
        Allocated (@AllocatedCount)
    </button>
    <button class="@StatusClass(XeroAllocationStatus.Bucketed)" @onclick="() => OnSwitchStatus.InvokeAsync(XeroAllocationStatus.Bucketed)">
        Buckets (@BucketedCount)
    </button>
    <button class="@StatusClass(XeroAllocationStatus.Disputed)" @onclick="() => OnSwitchStatus.InvokeAsync(XeroAllocationStatus.Disputed)">
        Disputed (@DisputedCount)
    </button>
    <button class="@StatusClass(XeroAllocationStatus.Ignored)" @onclick="() => OnSwitchStatus.InvokeAsync(XeroAllocationStatus.Ignored)">
        Ignored (@IgnoredCount)
    </button>
</div>

@code {
    /// <summary>Which status tab is open, and which of Unallocated's sub-tabs (a project, Labour).</summary>
    [Parameter] public XeroAllocationStatus Active { get; set; }
    [Parameter] public string? ActiveProjectId { get; set; }
    [Parameter] public bool LabourTab { get; set; }

    [Parameter] public int UnassignedCount { get; set; }
    /// <summary>One tab per project with incoming lines pointing at it — built by the page.</summary>
    [Parameter] public IReadOnlyList<(string ProjectId, string Name, int Count)> ProjectTabs { get; set; }
        = Array.Empty<(string, string, int)>();
    [Parameter] public bool ShowLabour { get; set; }
    [Parameter] public int LabourOutstandingCount { get; set; }
    [Parameter] public bool WorkOrderBillsTab { get; set; }
    [Parameter] public bool ShowWorkOrderBills { get; set; }
    [Parameter] public int WorkOrderBillCount { get; set; }
    [Parameter] public int AllocatedCount { get; set; }
    [Parameter] public int BucketedCount { get; set; }
    [Parameter] public int DisputedCount { get; set; }
    [Parameter] public int IgnoredCount { get; set; }

    [Parameter] public EventCallback<XeroAllocationStatus> OnSwitchStatus { get; set; }
    [Parameter] public EventCallback<string> OnSwitchProject { get; set; }
    [Parameter] public EventCallback OnSwitchLabour { get; set; }
    [Parameter] public EventCallback OnSwitchWorkOrderBills { get; set; }

    // The plain Unallocated tab is active only when neither a project tab, Labour nor Work
    // Order bills is open.
    private string StatusClass(XeroAllocationStatus tab) =>
        TabCss(Active == tab && (tab != XeroAllocationStatus.Unallocated || (ActiveProjectId is null && !LabourTab && !WorkOrderBillsTab)));

    private string ProjectClass(string projectId) =>
        TabCss(Active == XeroAllocationStatus.Unallocated && ActiveProjectId == projectId);

    private string LabourClass =>
        TabCss(Active == XeroAllocationStatus.Unallocated && LabourTab);

    private string WorkOrderBillsClass =>
        TabCss(Active == XeroAllocationStatus.Unallocated && WorkOrderBillsTab);

    private static string TabCss(bool active) =>
        (active ? "chip chip-active" : "chip");
}
