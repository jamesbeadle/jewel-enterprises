@namespace Jewel.JPMS.Features.Xero
@using static Jewel.JPMS.Features.Xero.XeroLedgerDisplay

@* One Work Order bill (2026-09-08): the bill, the order(s) it pays and why, a figure per open
   order of the supplier (2026-09-09 — off the bill total, never the Xero lines), and the lines
   as raised — one Approve for the whole bill. *@
<article class="panel mb-4">
    <header class="px-5 py-4 border-b border-line flex items-start justify-between gap-4 flex-wrap">
        <div class="min-w-0">
            <p class="text-content font-medium">
                @(Bill.ContactName ?? "—")
                <span class="text-content-muted font-normal"> · @(Bill.InvoiceNumber ?? "—") · @DateText(Bill.Date)</span>
                @if (IsAwaitingApproval(Bill))
                {
                    <span class="ml-1.5 text-xs font-medium border border-line rounded px-1.5 py-0.5 align-middle"
                          title="Awaiting approval in Xero — Approve confirms its coding to Xero and approves it">Draft</span>
                }
            </p>
            <p class="text-sm text-content-muted mt-1">
                @foreach (var order in OrdersPaid)
                {
                    <span class="text-content mr-2" title="@order.Title">@order.Reference</span>
                }
                <Pill Tone="Match.Rule.ToTone()" Class="align-middle" Title="@Match.Detail">@Match.Rule.Label()</Pill>
            </p>
        </div>
        <div class="flex items-center gap-3 whitespace-nowrap">
            <span class="text-content font-medium">@Money(BillNet) net</span>
            @if (Bill.HasAttachments)
            {
                <button class="btn-secondary" title="View the invoice document" disabled="@Busy"
                        @onclick="() => OnOpenInvoice.InvokeAsync(Bill)">Document</button>
            }
            <button class="btn-secondary" disabled="@Busy"
                    title="Not a bill against a work order — return it to the Unallocated queue for a hand allocation (this visit only; re-check restores the match)"
                    @onclick="() => OnNotWorkOrderBill.InvokeAsync()">Not a work-order bill</button>
        </div>
    </header>

    <WorkOrderBillOrderSlices Orders="Match.SupplierOrders" Slices="Slices" BillNet="@BillNet" Disabled="@Busy" OnChanged="StateHasChanged" />

    <WorkOrderBillLinesTable Lines="Lines" />

    <footer class="px-5 py-4 border-t border-line flex items-center justify-between gap-4 flex-wrap">
        <div class="min-w-0 grow">
            @if (Error is not null)
            {
                <Notice Tone="Tone.Negative">@Error</Notice>
            }
            else if (!SlicesBalance)
            {
                <p class="text-sm text-content-subtle">The order figures must add up to the bill's net before it can be approved.</p>
            }
            else
            {
                <p class="text-sm text-content-subtle">Approve allocates every line, links each order for its figure, writes the tracking to Xero line by line as raised, and approves the bill there.</p>
            }
        </div>
        <button class="btn-primary" disabled="@(Busy || !SlicesBalance || TakesAnOrderOverValue)"
                title="@(TakesAnOrderOverValue ? "A figure would take its order over value" : "Allocate, link and approve this bill in one go")"
                @onclick="() => OnApprove.InvokeAsync()">@(Approving ? "Approving…" : "Approve")</button>
    </footer>
</article>

@code {
    /// <summary>Every unallocated line of the bill; the match rides on each and is read off the first.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<XeroLedgerLine> Lines { get; set; } = default!;
    /// <summary>Page-owned: the bill's figure per open order, seeded from the read's proposal.</summary>
    [Parameter, EditorRequired] public List<WorkOrderBillSliceDraft> Slices { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Approving { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback<XeroLedgerLine> OnOpenInvoice { get; set; }
    [Parameter] public EventCallback OnApprove { get; set; }
    [Parameter] public EventCallback OnNotWorkOrderBill { get; set; }

    private XeroLedgerLine Bill => Lines[0];
    private WorkOrderBillMatch Match => Bill.WorkOrderMatch!;
    private decimal BillNet => Lines.Sum(SignedNet);

    private IEnumerable<WorkOrderBillOrderOption> OrdersPaid =>
        Match.SupplierOrders.Where(order => AmountOn(order) != 0m);

    private decimal AmountOn(WorkOrderBillOrderOption order) =>
        Slices.FirstOrDefault(slice => slice.WorkOrderId == order.WorkOrderId)?.Amount ?? 0m;

    /// <summary>A figure as it counts against the bill: a credit note's figures carry its sign.</summary>
    private decimal Signed(decimal amount) => BillNet < 0m ? -amount : amount;

    private bool SlicesBalance => Slices.Sum(slice => Signed(slice.Amount ?? 0m)) == BillNet && OrdersPaid.Any();

    private bool TakesAnOrderOverValue => OrdersPaid.Any(order => Signed(AmountOn(order)) > order.Remaining);
}
