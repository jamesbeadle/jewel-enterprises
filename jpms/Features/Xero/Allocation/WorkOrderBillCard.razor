@namespace Jewel.JPMS.Features.Xero
@using static Jewel.JPMS.Features.Xero.XeroLedgerDisplay

@* One Work Order bill (2026-09-08): the bill, the order(s) it pays and why, each order's
   figures, and every line's coding as the portal proposes it — one Approve for the whole bill.
   Since 2026-09-09 the lines' shares may sit on several of the supplier's open orders. *@
<article class="panel mb-4">
    <header class="px-5 py-4 border-b border-line flex items-start justify-between gap-4 flex-wrap">
        <div class="min-w-0">
            <p class="text-content font-medium">
                @(Bill.ContactName ?? "—")
                <span class="text-content-muted font-normal"> · @(Bill.InvoiceNumber ?? "—") · @DateText(Bill.Date)</span>
                @if (IsAwaitingApproval(Bill))
                {
                    <span class="ml-1.5 text-xs font-medium border border-line rounded px-1.5 py-0.5 align-middle"
                          title="Awaiting approval in Xero — Approve confirms its coding to Xero and approves it">Draft</span>
                }
            </p>
            <p class="text-sm text-content-muted mt-1">
                @foreach (var order in OrdersPaid)
                {
                    <a class="text-content underline underline-offset-4 hover:text-content-muted mr-2" href="@OrderRoute(order)" title="@order.Title">@order.Reference</a>
                }
                <Pill Tone="Match.Rule.ToTone()" Class="align-middle" Title="@Match.Detail">@Match.Rule.Label()</Pill>
            </p>
        </div>
        <div class="flex items-center gap-3 whitespace-nowrap">
            <span class="text-content font-medium">@Money(Lines.Sum(SignedNet)) net</span>
            @if (Bill.HasAttachments)
            {
                <button class="btn-secondary" title="View the invoice document" disabled="@Busy"
                        @onclick="() => OnOpenInvoice.InvokeAsync(Bill)">Document</button>
            }
            <button class="btn-secondary" disabled="@Busy"
                    title="Not a bill against a work order — return it to the Unallocated queue for a hand allocation (this visit only; re-check restores the match)"
                    @onclick="() => OnNotWorkOrderBill.InvokeAsync()">Not a work-order bill</button>
        </div>
    </header>

    <div class="divide-y divide-line border-b border-line">
        @foreach (var order in OrdersPaid)
        {
            <WorkOrderBillOrderFigures @key="order.WorkOrderId" Order="order" SliceNet="@SliceOn(order)" />
        }
    </div>

    <WorkOrderBillLinesTable Lines="Lines" Orders="Match.SupplierOrders" SharesFor="SharesFor" CostCenterText="CostCenterText"
                             Busy="@Busy" OnChanged="StateHasChanged" />

    <footer class="px-5 py-4 border-t border-line flex items-center justify-between gap-4 flex-wrap">
        <div class="min-w-0 grow">
            @if (Error is not null)
            {
                <Notice Tone="Tone.Negative">@Error</Notice>
            }
            else if (!SharesBalance)
            {
                <p class="text-sm text-content-subtle">Each line's shares must add up to its net before the bill can be approved.</p>
            }
            else
            {
                <p class="text-sm text-content-subtle">Approve allocates every line, links each share to its order, writes the tracking to Xero and approves the bill there.</p>
            }
        </div>
        <button class="btn-primary" disabled="@(Busy || !SharesBalance || TakesAnOrderOverValue)"
                title="@(TakesAnOrderOverValue ? "The bill would take an order over its value" : "Allocate, link and approve this bill in one go")"
                @onclick="() => OnApprove.InvokeAsync()">@(Approving ? "Approving…" : "Approve")</button>
    </footer>
</article>

@code {
    /// <summary>Every unallocated line of the bill; the match rides on each and the bill's rule is read off the first.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<XeroLedgerLine> Lines { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Approving { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter, EditorRequired] public Func<string?, string> CostCenterText { get; set; } = default!;
    /// <summary>The page-owned editable shares of one line (seeded from the server's proposal).</summary>
    [Parameter, EditorRequired] public Func<XeroLedgerLine, List<WorkOrderBillShareDraft>> SharesFor { get; set; } = default!;
    [Parameter] public EventCallback<XeroLedgerLine> OnOpenInvoice { get; set; }
    [Parameter] public EventCallback OnApprove { get; set; }
    [Parameter] public EventCallback OnNotWorkOrderBill { get; set; }

    private XeroLedgerLine Bill => Lines[0];
    private WorkOrderBillMatch Match => Bill.WorkOrderMatch!;
    private static string OrderRoute(WorkOrderBillOrderOption order) => $"/projects/{order.ProjectId}/work-orders";

    /// <summary>The orders the shares currently sit on, in the order the supplier's list has them.</summary>
    private IEnumerable<WorkOrderBillOrderOption> OrdersPaid =>
        Match.SupplierOrders.Where(order => Lines.Any(line => SharesFor(line).Any(share => share.WorkOrderId == order.WorkOrderId)));

    /// <summary>This bill's money on one order: its shares, signed like the lines they come from.</summary>
    private decimal SliceOn(WorkOrderBillOrderOption order) =>
        Lines.Sum(line => SharesFor(line).Where(share => share.WorkOrderId == order.WorkOrderId).Sum(share => share.Amount ?? 0m)
                          * (line.Type == "ACCPAYCREDIT" ? -1m : 1m));

    private bool SharesBalance =>
        Lines.All(line => SharesFor(line).Count > 0 && SharesFor(line).Sum(share => share.Amount ?? 0m) == line.Net);

    private bool TakesAnOrderOverValue => OrdersPaid.Any(order => SliceOn(order) > order.Remaining);
}
