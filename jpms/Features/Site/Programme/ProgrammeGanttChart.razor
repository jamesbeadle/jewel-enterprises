@namespace Jewel.JPMS.Features.Site
@using Jewel.JPMS.Contracts.Site

@* The Gantt: green bars are the live programme (red where slipped past baseline); the thin grey
   bar underneath is the baselined position; the darker fill is progress; an amber segment on a
   task's end is a variation's push (dashed until approved). Beneath the tasks, on the same
   ruler, sit the variations on the programme and the extensions of time. Click a task to edit
   it inline — the editor's draft is its own; the workbench writes the change through. *@
<div class="panel p-4 overflow-x-auto">
    <div class="min-w-[720px]">
        <div class="grid grid-cols-[240px_1fr] border-b border-line-strong pb-1 mb-1">
            <div class="eyebrow">Task</div>
            <div class="relative h-5">
                @foreach (var month in Timeline.MonthMarks)
                {
                    <span class="absolute top-0 text-xs text-content-subtle border-l border-line pl-1" style="@month.Style">@month.Label</span>
                }
            </div>
        </div>

        @foreach (var task in Tasks)
        {
            var slip = SlipDaysFor(task.ProgrammeTaskId);
            <div class="grid grid-cols-[240px_1fr] items-center border-b border-line/60">
                <div class="py-1.5 pr-3">
                    <div class="flex items-center gap-1.5">
                        <button type="button" class="text-sm text-content text-left truncate hover:text-accent" title="Edit task" @onclick="() => ToggleEdit(task)">@task.Title</button>
                        @if (slip > 0)
                        {
                            <Pill Tone="Tone.Negative">+@slip d</Pill>
                        }
                        @foreach (var push in PushesOn(task.ProgrammeTaskId))
                        {
                            <Pill Tone="Tone.Warning" Title="@($"{VariationNumber(push)} pushes this task {push.Effect.DelayDays} day(s)")">@VariationNumber(push) +@push.Effect.DelayDays d</Pill>
                        }
                    </div>
                    @if (PredecessorsOf(task.ProgrammeTaskId).Any())
                    {
                        <div class="flex flex-wrap gap-1 mt-0.5">
                            @foreach (var link in PredecessorsOf(task.ProgrammeTaskId))
                            {
                                <Pill Tone="Tone.Muted">
                                    after @TaskTitle(link.PredecessorTaskId)@(link.LagDays != 0 ? $" {(link.LagDays > 0 ? "+" : "")}{link.LagDays}d" : "")
                                    <button type="button" class="text-content-faint hover:text-negative" title="Remove dependency" @onclick="() => OnRemoveLink.InvokeAsync(link.ProgrammeTaskLinkId)">×</button>
                                </Pill>
                            }
                        </div>
                    }
                </div>
                <div class="relative h-9">
                    @if (Timeline.TodayStyle is { } todayStyle)
                    {
                        <div class="absolute inset-y-0 w-px bg-info/60" style="@todayStyle"></div>
                    }
                    <div class="absolute top-1.5 h-3.5 rounded @(slip > 0 ? "bg-negative/80" : "bg-accent/80")"
                         style="@Timeline.BarStyle(task.PlannedStart, task.PlannedEnd)"
                         title="@task.Title: @DateText(task.PlannedStart) – @DateText(task.PlannedEnd) (@((int)task.ProgressPercent)% complete)">
                        <div class="h-full rounded-l bg-black/35" style="width:@(ProgrammeTimeline.Percent((double)task.ProgressPercent))"></div>
                    </div>
                    @foreach (var push in PushesOn(task.ProgrammeTaskId))
                    {
                        <ProgrammePushBar Timeline="Timeline" Push="push" Variation="VariationOf(push)" />
                    }
                    @if (BaselineTaskFor(task.ProgrammeTaskId) is { } baselined)
                    {
                        <div class="absolute top-[26px] h-1 rounded bg-content-faint/70"
                             style="@Timeline.BarStyle(baselined.PlannedStart, baselined.PlannedEnd)"
                             title="Baseline: @DateText(baselined.PlannedStart) – @DateText(baselined.PlannedEnd)"></div>
                    }
                </div>
            </div>

            @if (editingTaskId == task.ProgrammeTaskId)
            {
                <ProgrammeTaskEditor Edited="task" Busy="Busy" Save="SaveTask" Remove="RemoveTask" OnClose="() => editingTaskId = null" />
            }
        }

        <ProgrammeVariationRows ProjectId="@ProjectId" Timeline="Timeline" Rows="VariationRows" Tasks="Tasks"
                                CanEdit="CanEdit" Busy="Busy" SaveEffect="SaveEffect" RemoveEffect="RemoveEffect" />
        <ProgrammeExtensionRows ProjectId="@ProjectId" Timeline="Timeline" Rows="ExtensionRows"
                                CanEdit="CanEdit" Busy="Busy" SaveDays="SaveExtensionDays" />
    </div>
</div>
<p class="text-xs text-content-subtle mt-2">
    Green bars are the live programme (red where slipped past baseline); the thin grey bar underneath is the baselined position; the darker fill is progress. An amber segment on a task's end is a variation's push — dashed until the variation is approved. Planned dates never move because of a variation; the segment is the push it would make. Click a task to edit it.
</p>
