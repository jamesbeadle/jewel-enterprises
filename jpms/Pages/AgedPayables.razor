@page "/finance/aged-payables"
@inject AuthService Auth
@inject SessionService Session
@inject IXeroAgedPayablesStore Payables
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Aged Payables · JPMS</PageTitle>

@*
    The company Aged Payables (the sidebar's Financials folder, finance roles): everything owed
    to suppliers, aged exactly as Xero's report ages it — but INCLUDING draft bills. The
    accounting procedure leaves purchase invoices in DRAFT until they are coded through the
    portal, and Xero's own aged payables only counts approved bills, so this page is the only
    complete payables picture. Read live from Xero; one row per supplier, expandable to the
    bills behind it, with drafts badged so what Xero's report is missing stays visible.
*@

<Page>
    <PageHeader>
        <SubtitleContent>
            Outstanding supplier bills aged as in Xero — including draft bills still being coded,
            which Xero's own report leaves out.
        </SubtitleContent>
        <Actions>
            <Toolbar>
                <ExportToExcelButton FileName="Aged payables"
                                     Disabled="@(Snapshot?.Error is not null || Rows.Count == 0)"
                                     BuildWorkbook="BuildExportWorkbook" />
                <ToolbarDivider />
                <ToolbarButton Icon="refresh" Label="Refresh from Xero"
                               Busy="@isRefreshing" OnClick="ForceRefreshAsync" />
            </Toolbar>
        </Actions>
    </PageHeader>

    @* The whole page reads off one Xero snapshot, so it arrives in one piece. *@
    <LoadGate IsLoading="@(Snapshot is null)" Prominent="true" Label="Loading the payables position">
        @if (!Snapshot!.IsConfigured)
        {
            <div class="panel-raised px-5 py-4 text-sm text-content-muted">
                Xero isn't connected yet. Add the custom connection's credentials as the
                <span class="font-mono text-content">Xero__ClientId</span> and
                <span class="font-mono text-content">Xero__ClientSecret</span> app settings on the API, then reload.
            </div>
        }
        else if (Snapshot.Error is not null)
        {
            <div class="panel-raised px-5 py-4 text-sm text-content-muted">
                <p class="text-content font-medium mb-1">Xero returned an error</p>
                <p>@Snapshot.Error</p>
            </div>
        }
        else
        {
            @if (Snapshot.Truncated)
            {
                <div class="panel-raised px-5 py-3 text-sm text-content-muted mb-6">
                    Xero holds more outstanding bills than the read's page cap could fetch — these totals are
                    incomplete. Raise the <span class="font-mono text-content">Xero__MaxPages</span> app setting.
                </div>
            }

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-6">
                <div class="panel px-5 py-4">
                    <p class="eyebrow mb-1">Total payables</p>
                    <p class="text-2xl font-semibold text-content">@Money(GrandTotal)</p>
                    <p class="text-xs text-content-subtle mt-1">@Bills.Count @(Bills.Count == 1 ? "bill" : "bills") outstanding · fetched @FetchedText</p>
                </div>
                <div class="panel px-5 py-4">
                    <p class="eyebrow mb-1">Of which draft</p>
                    <p class="text-2xl font-semibold text-content">@Money(DraftTotal)</p>
                    <p class="text-xs text-content-subtle mt-1">@DraftCount awaiting coding — not in Xero's own report</p>
                </div>
                <div class="panel px-5 py-4">
                    <p class="eyebrow mb-1">Overdue</p>
                    <p class="text-2xl font-semibold @(OverdueTotal > 0 ?"text-negative" : "text-content")">@Money(OverdueTotal)</p>
                    <p class="text-xs text-content-subtle mt-1">everything past the Current column</p>
                </div>
            </div>

            <div class="flex items-center justify-between gap-4 mb-3">
                <h2 class="text-sm font-semibold text-content">By supplier</h2>
                @* Xero's report offers the same choice; due date is its default. Recomputed
                   locally — no refetch. *@
                <div class="inline-flex rounded border border-line overflow-hidden text-xs font-medium">
                    <button type="button" class="@BasisClass(PayablesAgeBasis.DueDate)"
                            @onclick="() => SetBasis(PayablesAgeBasis.DueDate)">Age by due date</button>
                    <button type="button" class="@BasisClass(PayablesAgeBasis.InvoiceDate)"
                            @onclick="() => SetBasis(PayablesAgeBasis.InvoiceDate)">Age by invoice date</button>
                </div>
            </div>

            @if (Rows.Count == 0)
            {
                <p class="text-sm text-content-subtle">Nothing is outstanding — every supplier bill Xero holds is settled.</p>
            }
            else
            {
                <RecordsTable Dense="true" MaxHeight="max-h-[70vh]">
                    <thead>
                        <tr>
                            <th>Supplier</th>
                            @foreach (var label in AgedPayablesMaths.BucketLabels)
                            {
                                <th class="text-right whitespace-nowrap">@label</th>
                            }
                            <th class="text-right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Rows)
                        {
                            var isExpanded = expandedSuppliers.Contains(row.Supplier);
                            <tr class="cursor-pointer hover:bg-surface-raised transition" @onclick="() => ToggleExpanded(row.Supplier)">
                                <td class="text-content font-medium whitespace-nowrap">
                                    <span class="inline-flex items-center gap-2">
                                        <svg class="w-3.5 h-3.5 text-content-subtle shrink-0 transition-transform @(isExpanded ?"rotate-90" : "")"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                                        @row.Supplier
                                        @if (row.DraftTotal != 0)
                                        {
                                            <span class="text-xs font-medium border border-line rounded px-1.5 py-0.5 text-content-subtle"
                                                  title="Includes draft bills awaiting coding — not in Xero's own aged payables">Incl. draft</span>
                                        }
                                    </span>
                                </td>
                                @for (var bucket = 0; bucket < AgedPayablesMaths.BucketCount; bucket++)
                                {
                                    var amount = row.Buckets[bucket];
                                    <td class="text-right whitespace-nowrap @BucketCellClass(bucket, amount)">
                                        @(amount == 0 ? "—" : Money(amount))
                                    </td>
                                }
                                <td class="text-right whitespace-nowrap text-content font-semibold">@Money(row.Total)</td>
                            </tr>
                            @if (isExpanded)
                            {
                                @foreach (var bill in row.Bills)
                                {
                                    <tr class="bg-surface-raised/50">
                                        <td class="pl-10 whitespace-nowrap">
                                            @(bill.Number ?? bill.Reference ?? "—")
                                            @if (bill.IsCreditNote)
                                            {
                                                <span class="ml-1.5 text-xs font-medium border border-line rounded px-1.5 py-0.5">Credit</span>
                                            }
                                            @if (bill.IsDraft)
                                            {
                                                <span class="ml-1.5 text-xs font-medium border border-line rounded px-1.5 py-0.5"
                                                      title="Draft in Xero — awaiting coding through the portal; not in Xero's own aged payables">Draft</span>
                                            }
                                            <span class="block text-xs text-content-subtle">
                                                @DateText(bill.Date) · due @DateText(bill.DueDate)
                                            </span>
                                        </td>
                                        @for (var bucket = 0; bucket < AgedPayablesMaths.BucketCount; bucket++)
                                        {
                                            var inBucket = AgedPayablesMaths.BucketFor(bill, today, basis) == bucket;
                                            var amount = inBucket ? AgedPayablesMaths.SignedAmountDue(bill) : 0m;
                                            <td class="text-right whitespace-nowrap @(amount < 0 ?"text-negative" : "text-content-muted")">
                                                @(inBucket ? Money(amount) : "")
                                            </td>
                                        }
                                        <td class="text-right whitespace-nowrap @(AgedPayablesMaths.SignedAmountDue(bill) < 0 ?"text-negative" : "text-content-muted")">
                                            @Money(AgedPayablesMaths.SignedAmountDue(bill))
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                    <tfoot class="bg-surface-raised border-t border-line">
                        <tr class="font-semibold">
                            <td class="text-content">All suppliers</td>
                            @foreach (var total in BucketTotals)
                            {
                                <td class="text-right whitespace-nowrap text-content">@Money(total)</td>
                            }
                            <td class="text-right whitespace-nowrap text-content">@Money(GrandTotal)</td>
                        </tr>
                    </tfoot>
                </RecordsTable>
            }
        }
    </LoadGate>
</Page>

@code {
    private bool isRefreshing;
    private PayablesAgeBasis basis = PayablesAgeBasis.DueDate;
    private readonly HashSet<string> expandedSuppliers = new(StringComparer.OrdinalIgnoreCase);

    // One "as of" per render pass keeps every bucket, tile and export on the same day even
    // across a midnight rollover mid-session.
    private DateTime today = DateTime.Today;

    private XeroAgedPayablesSnapshot? Snapshot => Payables.Snapshot();

    private IReadOnlyList<XeroPayableBill> Bills =>
        Snapshot?.Bills ?? (IReadOnlyList<XeroPayableBill>)Array.Empty<XeroPayableBill>();

    private IReadOnlyList<AgedPayablesMaths.SupplierRow> Rows =>
        AgedPayablesMaths.SummariseBySupplier(Bills, today, basis);

    private IReadOnlyList<decimal> BucketTotals => AgedPayablesMaths.BucketTotals(Rows);

    private decimal GrandTotal => Bills.Sum(AgedPayablesMaths.SignedAmountDue);

    private decimal DraftTotal => Bills.Where(bill => bill.IsDraft).Sum(AgedPayablesMaths.SignedAmountDue);

    private int DraftCount => Bills.Count(bill => bill.IsDraft);

    private decimal OverdueTotal =>
        Bills.Where(bill => AgedPayablesMaths.IsOverdue(bill, today, basis)).Sum(AgedPayablesMaths.SignedAmountDue);

    private string FetchedText =>
        Snapshot?.FetchedAtUtc is { } fetched ? fetched.ToLocalTime().ToString("HH:mm") : "—";

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        Payables.OnChange += StateHasChanged;

        // Revalidate cached data in the background on tab entry (stale-while-revalidate) —
        // the store's fetch-once guard handles the very first load.
        _ = Payables.RefreshAsync();
    }

    private async Task ForceRefreshAsync()
    {
        today = DateTime.Today;
        isRefreshing = true;
        try { await Payables.RefreshAsync(force: true); }
        finally { isRefreshing = false; }
    }

    private void SetBasis(PayablesAgeBasis newBasis)
    {
        basis = newBasis;
        today = DateTime.Today;
    }

    private string BasisClass(PayablesAgeBasis candidate) =>
        "px-3 py-1.5 transition " + (basis == candidate
            ? "bg-surface-raised text-content font-semibold"
            : "text-content-subtle hover:text-content");

    private void ToggleExpanded(string supplier)
    {
        if (!expandedSuppliers.Remove(supplier)) expandedSuppliers.Add(supplier);
    }

    // Overdue money reads negative-red only when it's real money owed; a credit sitting in an
    // aged column stays quiet (it reduces what's owed, it isn't a risk).
    private static string BucketCellClass(int bucket, decimal amount) =>
        amount == 0 ? "text-content-subtle"
        : amount < 0 ? "text-negative"
        : bucket > 0 ? "text-content font-medium"
        : "text-content-muted";

    // Pence shown: this page gets reconciled against Xero's own report to the penny.

    // One workbook, two sheets, both computed from the same maths as the page so the export
    // can never disagree with the screen.
    private ExcelWorkbook? BuildExportWorkbook(bool _)
    {
        if (Snapshot is null || Snapshot.Error is not null) return null;

        var rows = Rows;
        if (rows.Count == 0) return null;

        var workbook = new ExcelWorkbook();

        var summaryColumns = new List<ExcelColumn> { new("Supplier") };
        summaryColumns.AddRange(AgedPayablesMaths.BucketLabels.Select(label => new ExcelColumn(label, ExcelFormat.Currency)));
        summaryColumns.Add(new ExcelColumn("Total", ExcelFormat.Currency));
        var summarySheet = workbook.AddSheet("Summary", summaryColumns.ToArray());
        foreach (var row in rows)
            summarySheet.AddRow(new object?[] { row.Supplier }
                .Concat(row.Buckets.Cast<object?>())
                .Append(row.Total)
                .ToArray());
        summarySheet.AddRow(new object?[] { "All suppliers" }
            .Concat(BucketTotals.Cast<object?>())
            .Append(GrandTotal)
            .ToArray());

        var detailSheet = workbook.AddSheet("Detail",
            new ExcelColumn("Supplier"),
            new ExcelColumn("Type"),
            new ExcelColumn("Number"),
            new ExcelColumn("Reference"),
            new ExcelColumn("Date", ExcelFormat.Date),
            new ExcelColumn("Due", ExcelFormat.Date),
            new ExcelColumn("Status"),
            new ExcelColumn("Ageing"),
            new ExcelColumn("Amount due", ExcelFormat.Currency));
        foreach (var row in rows)
        {
            foreach (var bill in row.Bills)
            {
                detailSheet.AddRow(
                    row.Supplier,
                    bill.IsCreditNote ? "Credit note" : "Bill",
                    bill.Number,
                    bill.Reference,
                    bill.Date,
                    bill.DueDate,
                    bill.Status,
                    AgedPayablesMaths.BucketLabels[AgedPayablesMaths.BucketFor(bill, today, basis)],
                    AgedPayablesMaths.SignedAmountDue(bill));
            }
        }

        return workbook;
    }

    public void Dispose() => Payables.OnChange -= StateHasChanged;
}
