@page "/control-centre"
@page "/requests/triage"
@* The second route is the legacy alias: the page lived at /requests/triage before the section
   became the Control Centre (2026-08-07); old bookmarks and links still land here. *@
@using Jewel.JPMS.Contracts.Audit
@using Jewel.JPMS.Contracts.DocumentControl
@using Jewel.JPMS.Contracts.MailboxCompose
@using Jewel.JPMS.Features.Triage
@using static Jewel.JPMS.Features.Triage.RecordLinkVocabulary
@using Jewel.JPMS.Features.Procurement
@using Jewel.JPMS.Contracts.Todos
@using Jewel.JPMS.Features.Todos
@using Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Features.Triage.Queue
@using Jewel.JPMS.Features.Triage.Workspace
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject IIntakeQueue Intake
@inject ProjectStageFilter StageFilter
@inject TriageSortStorage SortStorage
@inject ITodoStore Todos
@inject IRequestRegister RequestRegister
@inject ICommandSender Commands
@inject IWorkOrderAttachmentStore WorkOrderAttachments
@inject IQueryClient Queries
@inject ControlCentreOpenEmail OpenEmail
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel Projects
@inject Jewel.JPMS.Features.Subcontractors.SubcontractorsReadModel Subcontractors
@inject Jewel.JPMS.Features.CostCenters.CostCentersReadModel CostCenters
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Control Centre · JPMS</PageTitle>

@*
    Live-read triage. The mailbox is the single source of truth and nothing ever moves — triage just
    adds/removes category tags on the email. The Queue is Inbox messages with no JPMS tag (read live);
    the Discarded tab is messages tagged "JPMS/Discarded". Discard/restore/assign add or remove tags,
    each verified by reading the categories back. Nothing about un-triaged mail is stored in the database.
*@

@{
    @*
        The two page-owned pane contents left in the workspace (every other pane is a component
        that owns its data or takes an explicit interface): thin dispatchers on `view`, so the
        page stays the single orchestrator it always was.
    *@

    RenderFragment InboxPaneContent =@<div class="space-y-4 lg:pr-1">
        <InboxPaneHeader View="view" Total="InboxTotal" LoadError="@loadError" OnSwitchView="SwitchView" />

        @if (view == QueueView.Active)
        {
            <QueueInboxList Unassigned="unassigned"
                            UnassignedArrived="unassignedArrived"
                            UnassignedError="@unassignedError"
                            OnReturnUnassigned="ReturnUnassigned"
                            Arrived="queueArrived"
                            LoadError="@loadError"
                            Items="items"
                            Total="total"
                            ListLoading="listLoading"
                            Busy="busy"
                            NewestFirst="newestFirst"
                            OnSetSort="newest => SetSortAsync(newest)"
                            SelectedId="@selected?.Id"
                            ParkedEmailIds="parkedTriageByEmailId.Keys"
                            OnSelect="item => Select(item)"
                            PageIndex="queueIndex"
                            PageCount="QueuePageCount"
                            HasNext="@(queueNext is not null)"
                            OnPrevious="PreviousPage"
                            OnNext="NextPage" />
        }
        else if (view == QueueView.Discarded)
        {
            <DiscardedInboxList Arrived="discardedArrived"
                                LoadError="@loadError"
                                Items="discardedItems"
                                Total="discardedTotal"
                                ListLoading="listLoading"
                                SelectedId="@selected?.Id"
                                OnSelect="item => Select(item)"
                                PageIndex="discardedIndex"
                                PageCount="DiscardedPageCount"
                                HasNext="@(discardedNext is not null)"
                                OnPrevious="PreviousDiscarded"
                                OnNext="NextDiscarded" />
        }
        else
        {
            <TaggedInboxBrowser SearchText="@taggedSearch"
                                OnSearchInput="OnTaggedSearchInput"
                                OnClearSearch="ClearTaggedSearchAsync"
                                SearchActive="TaggedSearchActive"
                                PathwayDisabledTitle="@PathwayDisabledTitle"
                                PathwayBucketFilter="@pathwayBucketFilter"
                                OnSetPathwayFilter="bucket => SetPathwayFilter(bucket)"
                                Arrived="taggedArrived"
                                FilterOpen="filterOpen"
                                OnToggleFilterMenu="ToggleFilterMenu"
                                OnClearTagFilters="ClearTagFilters"
                                KnownTags="knownTags"
                                SelectedTags="selectedTags"
                                OnToggleTag="tag => ToggleTag(tag)"
                                SearchRecord="taggedSearchRecord"
                                Searching="taggedSearching"
                                SearchResults="taggedSearchResults"
                                SearchPending="@taggedSearchPending"
                                LoadError="@loadError"
                                Items="taggedItems"
                                Total="taggedTotal"
                                ListLoading="listLoading"
                                SelectedId="@selected?.Id"
                                ParkedEmailIds="parkedTriageByEmailId.Keys"
                                OnSelect="item => Select(item)"
                                PageIndex="taggedIndex"
                                PageCount="TaggedPageCount"
                                HasNext="@(taggedNext is not null)"
                                OnPrevious="PreviousTagged"
                                OnNext="NextTagged" />
        }
    </div>;

    RenderFragment EmailPaneContent =@<div>
        @if (selected is null)
        {
            @if (view == QueueView.Active)
            {
                <TriageNoticesStack ComposeOutcome="composeOutcome"
                                    OnDismissComposeOutcome="() => composeOutcome = null"
                                    LinkNote="@linkNote"
                                    OnDismissLinkNote="() => linkNote = null"
                                    PoEmailNote="@poEmailNote"
                                    PoEmailNoteIsSuccess="poEmailNoteIsSuccess"
                                    OnDismissPoEmailNote="() => poEmailNote = null"
                                    OutboxNote="@outboxNote"
                                    OnDismissOutboxNote="() => outboxNote = null" />
            }
            <div class="panel p-8 text-center text-sm text-content-subtle">
                @SelectPrompt
            </div>
        }
        else if (view == QueueView.Active)
        {
            <QueueEmailReadingPane Selected="selected"
                                   Detail="detail"
                                   DetailLoading="detailLoading"
                                   Thread="thread"
                                   ThreadLoading="threadLoading"
                                   ThreadError="@threadError"
                                   ThreadMatchedBySubject="threadMatchedBySubject"
                                   StagedDocumentControlIds="stagedDocControlIds"
                                   Busy="busy"
                                   OnToggleDocumentTriage="tick => ToggleDocControl(tick.AttachmentId, tick.Ticked)"
                                   OnSelectMessage="message => Select(message)"
                                   OnRetryThread="() => LoadThreadAsync(selected!)"
                                   OnPreviewAttachment="OpenEmailAttachmentPreview"
                                   ComposerOpen="replyOpen"
                                   OnOpenComposer="forward => OpenReplyComposer(forward)">
                <ReplyComposerForm IsForward="replyIsForward"
                                   To="@replyToField" ToChanged="OnReplyToInput"
                                   Cc="@replyCcField" CcChanged="OnReplyCcInput"
                                   Bcc="@replyBccField" BccChanged="OnReplyBccInput"
                                   ShowBcc="replyShowBcc" ShowBccChanged="shown => replyShowBcc = shown"
                                   Subject="@replySubject" SubjectChanged="OnReplySubjectInput"
                                   Body="@replyBody" BodyChanged="html => replyBody = html"
                                   Attachments="replyAttachments" AttachmentsChanged="OnReplyAttachmentsChanged"
                                   Projects="ProjectOptionsFor(ComposeContextProjectId)" ProjectId="@ComposeContextProjectId"
                                   OriginalAttachments="@detail?.Attachments" OriginalMessageId="@selected?.Id"
                                   ThreadConversationId="@(string.IsNullOrEmpty(selected?.ConversationId) ? null : selected!.ConversationId)" ThreadSubject="@selected?.Subject"
                                   OnDiscard="DiscardReplyDraft" />
            </QueueEmailReadingPane>
        }
        else if (view == QueueView.Discarded)
        {
            <DiscardedEmailPanel Selected="selected"
                                 Detail="detail"
                                 DetailLoading="detailLoading"
                                 Thread="thread"
                                 ThreadLoading="threadLoading"
                                 ThreadError="@threadError"
                                 ThreadMatchedBySubject="threadMatchedBySubject"
                                 StagedDocumentControlIds="stagedDocControlIds"
                                 Busy="busy"
                                 ActionError="@actionError"
                                 OnToggleDocumentTriage="tick => ToggleDocControl(tick.AttachmentId, tick.Ticked)"
                                 OnSelectMessage="message => Select(message)"
                                 OnRetryThread="() => LoadThreadAsync(selected!)"
                                 OnPreviewAttachment="OpenEmailAttachmentPreview"
                                 OnRestore="DoRestore" />
        }
        else
        {
            <TaggedEmailManagePanel Selected="selected"
                                    Detail="detail"
                                    DetailLoading="detailLoading"
                                    Thread="thread"
                                    ThreadLoading="threadLoading"
                                    ThreadError="@threadError"
                                    ThreadMatchedBySubject="threadMatchedBySubject"
                                    StagedDocumentControlIds="stagedDocControlIds"
                                    Busy="busy"
                                    ActionError="@actionError"
                                    OnToggleDocumentTriage="tick => ToggleDocControl(tick.AttachmentId, tick.Ticked)"
                                    OnSelectMessage="message => Select(message)"
                                    OnRetryThread="() => LoadThreadAsync(selected!)"
                                    OnPreviewAttachment="OpenEmailAttachmentPreview"
                                    OnRemoveTag="DoRemoveTag"
                                    LinkRecordType="linkRecordType"
                                    LinkTypeOptions="TaggedLinkTypeOptions"
                                    OnLinkTypeChanged="OnLinkRecordTypeChanged"
                                    ProjectId="@triageProjectId"
                                    ProjectOptions="ProjectOptionsFor(triageProjectId)"
                                    OnProjectChanged="OnTriageProjectChanged"
                                    RecordsLoading="linkRecordsLoading"
                                    LinkRecordId="@linkRecordId"
                                    Records="ProjectRecords()"
                                    OnRecordChanged="OnTaggedRecordChanged"
                                    OnAddLink="DoAddTagLink" />
        }
    </div>;


}

<Page Bare="true">
    @if (!CanTriage)
    {
        <div class="panel p-8 text-center">
            <p class="text-sm text-content">You don't have access to the Control Centre.</p>
            <p class="text-xs text-content-subtle mt-1">The Control Centre is available to administrators and project managers.</p>
        </div>
    }
    else
    {
        @*
            The Control Centre workspace: two side-by-side windows, each with the same icon rail, split
            by a draggable divider (1/3 : 2/3 until dragged). Any content loads either side and always
            remembers where it was — data is gathered by jumping around windows, side by side, instead
            of through modals. On mobile there is one window; the icons still carry the full context.
        *@
        <section class="px-3 md:px-4 pt-3 pb-4 h-[calc(100dvh-5.25rem)] min-h-[34rem] flex flex-col">
        @* One busy gate for the WHOLE workspace — bar and both windows. It used to sit on the
           triage bar and the email detail panel only, so pressing "Create now" from a pathway
           pane left the pane you'd just clicked (and everything else below the bar) uncovered —
           only "the top bit" dimmed. Any in-flight action (Apply, Create now, discard, restore,
           tag changes) covers everything the action might touch.

           As a gate it also SILENCES every gate inside it: the inbox list refreshing its page, a
           pathway pane reading its register, the Xero pane. One action, one jewel — not the three
           that used to pulse at once while an Apply ran. z-30 because the inbox pane's sticky tab
           bar is z-10 (later in the DOM, so it would paint over a bare z-10 veil) and the
           tag-filter dropdown is z-20. *@
        <LoadGate Overlay="true" IsLoading="busy" Label="@busyLabel"
                  Class="flex-1 min-h-0 flex flex-col" OverlayClass="z-30">
            @* The selected email is global to both windows, so its bar sits above the split. *@
            @if (view == QueueView.Active && selected is not null)
            {
                <TriageBar Selected="selected"
                           Projects="@AllProjects"
                           ProjectId="@triageProjectId"
                           OnProjectPicked="OnTriageProjectPicked"
                           @bind-RelevantEventStaged="relevantEventStaged"
                           @bind-TriageEntireThread="triageEntireThread"
                           @bind-UseThreadTags="useThreadTags"
                           ThreadCount="thread.Count"
                           ThreadTags="@SelectedThreadTags"
                           ProjectAutoMatched="projectAutoMatched"
                           ActionError="@actionError"
                           @bind-DiscardArmed="discardArmed"
                           PendingSummary="@PendingSummary"
                           DecisionsMissing="TriageDecisionsMissing"
                           DecisionsMissingHint="@DecisionsMissingHint"
                           ProjectMissing="ProjectMissing"
                           ProjectMissingHint="@ProjectMissingHint"
                           Busy="busy"
                           ApplyLabel="@ApplyButtonLabel"
                           OutboxSendCount="OutboxSendCount"
                           OnApply="saveAsDraftOnly => DoApplyAll(saveAsDraftOnly)" />
            }
            else if (view == QueueView.Active && queuedReplies.Count > 0)
            {
                <OutboxOnlyBar ActionError="@actionError"
                               PendingSummary="@PendingSummary"
                               Busy="busy"
                               ApplyLabel="@ApplyButtonLabel"
                               OutboxSendCount="OutboxSendCount"
                               OnApply="saveAsDraftOnly => DoApplyAll(saveAsDraftOnly)" />
            }
            <div class="flex-1 min-h-0">
            <PanelWorkspace State="workspace"
                            EmailAvailable="@(selected is not null)"
                            PreviewAvailable="@(workspace.Preview is not null)"
                            ClientBadge="@PathwayBadge(PathwayPaneConfig.Client)"
                            SubcontractorBadge="@PathwayBadge(PathwayPaneConfig.Subcontractor)"
                            SupplierBadge="@PathwayBadge(PathwayPaneConfig.Supplier)"
                            InternalBadge="@PathwayBadge(PathwayPaneConfig.Internal)"
                            OutboxBadge="@OutboxSendCount">
                <InboxContent>@InboxPaneContent</InboxContent>
                <EmailContent>@EmailPaneContent</EmailContent>
                <EmailMirrorContent>
                    <EmailMirrorPane Selected="@(view == QueueView.Active ? selected : null)"
                                     Detail="detail"
                                     DetailLoading="detailLoading"
                                     Thread="thread"
                                     ThreadLoading="threadLoading"
                                     ThreadError="@threadError"
                                     ThreadMatchedBySubject="threadMatchedBySubject"
                                     ShowDocumentTriageTick="true"
                                     StagedDocumentControlIds="stagedDocControlIds"
                                     Busy="busy"
                                     OnToggleDocumentTriage="tick => ToggleDocControl(tick.AttachmentId, tick.Ticked)"
                                     OnSelectMessage="message => Select(message)"
                                     OnRetryThread="() => LoadThreadAsync(selected!)"
                                     OnPreviewAttachment="OpenEmailAttachmentPreview" />
                </EmailMirrorContent>
                <ClientContent>@PathwayPaneFragment(PathwayPaneConfig.Client, PanelKind.Client)</ClientContent>
                <SubcontractorContent>@PathwayPaneFragment(PathwayPaneConfig.Subcontractor, PanelKind.Subcontractor)</SubcontractorContent>
                <SupplierContent>@PathwayPaneFragment(PathwayPaneConfig.Supplier, PanelKind.Supplier)</SupplierContent>
                <InternalContent>@PathwayPaneFragment(PathwayPaneConfig.Internal, PanelKind.Internal)</InternalContent>
                <RecordsContent>
                    <RecordExplorerPane Projects="@ProjectOptionsFor(null)" OnPreview="OpenRecordPreview"
                                        OnReply="message => StartOutboxReply(message, PanelKind.Records)"
                                        OnForward="message => StartOutboxForward(message, PanelKind.Records)" />
                </RecordsContent>
                <PreviewContent>
                    <PreviewPane Request="@workspace.Preview" OnClose="() => workspace.ClosePreview()" />
                </PreviewContent>
                <XeroContent><XeroExplorerPane OnPreview="OpenXeroPreview" /></XeroContent>
                <ComposeContent>
                    <NewEmailComposerPane ProjectOptionsFor="ProjectOptionsFor"
                                          LinkableRecordTypes="RecordTypeOptions"
                                          RecordTypeLabel="RecordTypeLabel"
                                          OnClosed="() => workspace.Close(PanelKind.Compose)"
                                          OnSent="outcome => composeOutcome = outcome" />
                </ComposeContent>
                <OutboxContent>
                    <OutboxPane QueuedReplies="queuedReplies"
                                OnChanged="StateHasChanged"
                                @bind-ComposeAnchor="outboxComposeAnchor"
                                ComposeAnchorIsForward="@outboxComposeAnchorIsForward"
                                CurrentReplyPending="@ReplyDraftPending"
                                CurrentReplyIsForward="@replyIsForward"
                                CurrentReplySubject="@replySubject"
                                OnEditCurrentReply="ShowCurrentReplyComposer"
                                OnDiscardCurrentReply="DiscardReplyDraft"
                                Projects="@ProjectOptionsFor(null)"
                                ProjectId="@NullIfBlank(triageProjectId)" />
                </OutboxContent>
            </PanelWorkspace>
            </div>
        </LoadGate>
        </section>

        @if (RecentTriage.Count > 0)
        {
            <RecentTriageFold Entries="RecentTriage" Projects="AllProjects" />
        }
    }
</Page>


@code {
    // One pathway pane's workspace fragment — the four panes are one component fed by config
    // (tagging sections, category registers, the pathway's own actions), sharing the page's one
    // staged list, staged actions and Apply. Registers browse whatever the view; tagging and
    // actions engage only for the open QUEUE email (OpenQueueEmailSubject is blank otherwise).
    private RenderFragment PathwayPaneFragment(PathwayPaneConfig config, PanelKind kind) => __builder =>
    {
        <PathwayPane Config="config"
                     EmailKey="@(selected?.Id ?? "")"
                     ProjectId="@triageProjectId"
                     ProjectName="@TriageProjectName"
                     EmailSubject="@OpenQueueEmailSubject"
                     LockedPathway="@(FixedPathway is { } fp ? TriagePathways.Label(fp) : null)"
                     Picked="pickedRecords"
                     OnStagingChanged="StateHasChanged"
                     OnEngaged="OnPathwayEngaged"
                     OnClose="() => ClosePathwayPane(kind)"
                     OnPreview="document => OpenPathwayPreview(document, kind)"
                     OnReply="message => StartOutboxReply(message, kind)"
                     OnForward="message => StartOutboxForward(message, kind)"
                     Projects="@ProjectOptionsFor(null)"
                     StagedActions="stagedSystemActions"
                     StagedCreate="@stagedCreate"
                     StagedCreateChanged="v => stagedCreate = v"
                     CreatedRecords="createdNowRecords"
                     OnCreateNow="() => DoCreateStagedNow()"
                     Busy="@busy"
                     TodoRows="createTodoRows"
                     TodoAssigneeOptions="@todoAssigneeOptions"
                     TodoProjectNote="@TodoProjectNote"
                     EmailAttachments="@(detail?.Attachments ?? Array.Empty<IntakeAttachment>())"
                     SenderEmail="@(selected?.FromEmail ?? "")"
                     InternetMessageId="@selected?.InternetMessageId"
                     RecipientEmails="@OpenEmailRecipients" />
    };
}
