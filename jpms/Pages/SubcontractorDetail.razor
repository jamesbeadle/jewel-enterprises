@page "/directory/{SubcontractorId}"
@using Jewel.JPMS.Contracts.Subcontractors
@using Jewel.JPMS.Features.Directory
@inject AuthService Auth
@inject SessionService Session
@inject ISubcontractorStore SubcontractorStore
@inject UserInviteService Invites
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@PageTitleText · JPMS</PageTitle>

<Page>
    @if (!CanAccess)
    {
        <PageHeader Title="Not available" />
        <p class="text-content-muted">The company directory is restricted to administrators, the managing and finance directors, and project managers.</p>
    }
    else if (!SubcontractorStore.IsLoaded)
    {
        @* Directory fetch still in flight — don't flash "not found" before it lands. *@
        <div>
            <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
        </div>
    }
    else if (subcontractor is null)
    {
        <PageHeader Title="Subcontractor not found" />
        <p class="text-content-muted">
            <a class="text-content underline" href="/directory">Back to directory</a>.
        </p>
    }
    else
    {
        <nav class="mb-4 text-sm">
            <a href="/directory" class="text-content-subtle hover:text-content underline underline-offset-4">Subcontractors</a>
            <span class="text-content-subtle mx-2">/</span>
            <span class="text-content-muted font-medium">@subcontractor.CompanyName</span>
        </nav>

        <PageHeader>
            <TitleContent>
                @subcontractor.CompanyName
                @if (subcontractor.XeroLinked)
                {
                    <span class="inline-flex items-center gap-1 rounded-full bg-surface-raised border border-line px-2 py-0.5 text-xs font-medium text-content-muted"
                          title="@XeroLinkTitle(subcontractor)">
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
                        Linked to Xero
                    </span>
                }
            </TitleContent>
            <SubtitleContent>
                @ContactLine(subcontractor)
            </SubtitleContent>
            <Actions>
                @if (CanManageXeroLink && !subcontractor.XeroLinked)
                {
                    <button type="button" class="btn-secondary shrink-0"
                            title="Link this record to the Xero contact its bills arrive under — no second record is created"
                            @onclick="OpenXeroLink">Link to Xero contact…</button>
                }
                @if (CanManageXeroLink)
                {
                    @foreach (var link in subcontractor.XeroLinks)
                    {
                        <InlineConfirm Label="@($"Unlink from {link.XeroContactName}")"
                                       Question="Remove this Xero link? Click again to confirm"
                                       Title="@($"Linked {DateText(link.LinkedAt)} by {link.LinkedByEmail}. Only the link is removed; the record stays.")"
                                       Busy="xeroBusy" OnConfirm="() => UnlinkFromXero(link.XeroContactId)" />
                    }
                }
                <button type="button" class="btn-secondary shrink-0"
                        title="Edit the company name and contact details — rename to match Xero so invoices line up on WO Allocation"
                        @onclick="OpenEdit">Edit details…</button>
            </Actions>
        </PageHeader>

        <XeroLinkModal @ref="xeroLinkModal" />
        @if (xeroError is not null)
        {
            <Notice Tone="Tone.Negative" Class="mb-4">@xeroError</Notice>
        }

        @* Trades are managed here: each is a chip from the curated list, so when a company changes
           what it does (no longer a bricklayer, now a hod carrier) the record is updated in place. *@
        <div class="panel p-4 mb-6">
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-sm font-semibold text-content">Trades</h2>
                @if (tradesNote is not null)
                {
                    <span class="text-xs text-content-subtle">@tradesNote</span>
                }
            </div>
            @if (tradesError is not null)
            {
                <Notice Tone="Tone.Negative" Class="mb-3">@tradesError</Notice>
            }
            <div class="flex flex-wrap gap-1.5 mb-3">
                @if (subcontractor.Trades.Count == 0)
                {
                    <span class="text-sm text-content-subtle italic">No trades recorded.</span>
                }
                @foreach (var trade in subcontractor.Trades)
                {
                    <Pill Tone="Tone.Muted">
                        @trade.Name
                        <button type="button" class="text-content-subtle hover:text-content" title="Remove @trade.Name"
                                disabled="@tradesBusy" @onclick="() => RemoveTrade(trade.TradeId)">×</button>
                    </Pill>
                }
            </div>
            <div class="flex flex-wrap gap-2">
                @* The curated list is a second fetch, and an empty picker reads as "there are no
                   other trades" — the cue to type a new one, which would duplicate an existing
                   trade under a slightly different name. Disabled says "not yet" without a spinner
                   in the middle of a row of controls. *@
                <select class="field w-56" value="" @onchange="AddExistingTrade"
                        disabled="@(tradesBusy || !SubcontractorStore.TradesLoaded)">
                    <option value="">@(SubcontractorStore.TradesLoaded ? "Add a trade…" : "Loading trades…")</option>
                    @foreach (var trade in SubcontractorStore.Trades().Where(t => !subcontractor.HasTrade(t.TradeId)))
                    {
                        <option value="@trade.TradeId">@trade.Name</option>
                    }
                </select>
                <input class="field w-56" placeholder="New trade, e.g. Hod carrier" @bind="newTradeName" @bind:event="oninput" />
                <button type="button" class="btn-secondary" disabled="@(tradesBusy || string.IsNullOrWhiteSpace(newTradeName))" @onclick="AddNewTrade">
                    @(tradesBusy ? "Saving…" : "Add new trade")
                </button>
            </div>
        </div>

        @* Contacts: the people on this record beyond its primary contact line. A consolidated
           master keeps every merged email/phone here. *@
        <div class="panel p-4 mb-6">
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-sm font-semibold text-content">Contacts</h2>
                @if (contactsNote is not null)
                {
                    <span class="text-xs text-content-subtle">@contactsNote</span>
                }
            </div>
            @if (contactsError is not null)
            {
                <Notice Tone="Tone.Negative" Class="mb-3">@contactsError</Notice>
            }
            @if (!SubcontractorStore.ContactsLoadedFor(subcontractor.SubcontractorId))
            {
                <LoadGate IsLoading="true" Label="Loading" />
            }
            else if (Contacts.Count == 0)
            {
                <p class="text-sm text-content-subtle italic mb-3">No additional contacts on this record.</p>
            }
            else
            {
                <table class="data-table data-table-dense mb-3">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th class="w-24"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contact in Contacts)
                        {
                            <tr>
                                <td class="text-content font-medium">@Dash(contact.Name)</td>
                                <td>@Dash(contact.Email)</td>
                                <td>@Dash(contact.Phone)</td>
                                <td class="text-right whitespace-nowrap">
                                    <button type="button" class="text-xs text-content-subtle hover:text-content underline underline-offset-2 mr-2"
                                            disabled="@contactBusy" @onclick="() => EditContact(contact)">Edit</button>
                                    <button type="button" class="text-xs text-content-subtle hover:text-negative underline underline-offset-2"
                                            disabled="@contactBusy" @onclick="() => RemoveContact(contact.CompanyContactId)">Remove</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2 items-end">
                <div>
                    <FormField Label="Name">
                    <input class="field" @bind="cName" />
                    </FormField>
                </div>
                <div>
                    <FormField Label="Email">
                    <input class="field" @bind="cEmail" />
                    </FormField>
                </div>
                <div>
                    <FormField Label="Phone">
                    <input class="field" @bind="cPhone" />
                    </FormField>
                </div>
                <div class="flex gap-2">
                    <button type="button" class="btn-secondary" disabled="@contactBusy" @onclick="SaveContact">
                        @(contactBusy ? "Saving…" : editingContactId is null ? "Add contact" : "Save contact")
                    </button>
                    @if (editingContactId is not null)
                    {
                        <button type="button" class="btn-neutral" disabled="@contactBusy" @onclick="CancelEditContact">Cancel</button>
                    }
                </div>
            </div>
        </div>

        @* Portal access: invites the record's contact to the subcontractor portal. The login is
           linked to this record server-side, scoping their session to their own company's data. *@
        <div class="panel p-4 mb-6">
            <div class="flex items-center justify-between mb-2">
                <h2 class="text-sm font-semibold text-content">Portal access</h2>
            </div>
            @if (inviteError is not null)
            {
                <Notice Tone="Tone.Negative" Class="mb-3">@inviteError</Notice>
            }
            @if (inviteResult is not null)
            {
                <Notice Tone="Tone.Positive" Class="mb-3">
                    <p class="mb-1">Invite sent to <span class="font-medium">@inviteResult.Email</span>. If the email doesn't arrive, share this link (valid until @DateText(inviteResult.ExpiresAt)):</p>
                    <code class="block break-all text-xs bg-white/60 rounded px-2 py-1">@inviteResult.InviteLink</code>
                </Notice>
            }
            <div class="flex flex-wrap items-center gap-3">
                <button type="button" class="btn-secondary" disabled="@(inviteBusy || string.IsNullOrWhiteSpace(subcontractor.ContactEmail))" @onclick="InviteToPortal">
                    @(inviteBusy ? "Inviting…" : inviteResult is null ? "Invite to portal" : "Re-send invite")
                </button>
                <span class="text-xs text-content-subtle">
                    @(string.IsNullOrWhiteSpace(subcontractor.ContactEmail)
                        ? "Add a contact email to this record before inviting."
                        : $"Sends a set-password link to {subcontractor.ContactEmail}.")
                </span>
            </div>
        </div>

        @* Statement of account: this record's work orders across every project with the invoices
           claimed against each — downloadable as the branded PDF, or drafted to the contact by
           email (shared-mailbox convention: a human reviews and sends from Outlook). *@
        <div class="panel p-4 mb-6">
            <div class="flex items-center justify-between mb-2">
                <h2 class="text-sm font-semibold text-content">Statement of account</h2>
            </div>
            <p class="text-xs text-content-subtle mb-3">
                Every work order this company holds, grouped by project, with the invoices claimed
                against each order and the remaining balances — generated from the register, so it's
                always current.
            </p>
            <div class="flex flex-wrap items-center gap-3">
                <a class="btn-secondary" href="@($"/api/subcontractors/{subcontractor.SubcontractorId}/statement/pdf")"
                   target="_blank" rel="noopener">
                    Download PDF
                </a>
                <button type="button" class="btn-secondary" @onclick="() => statementOpen = true">
                    Email statement…
                </button>
            </div>
        </div>

        <SubcontractorComplianceList SubcontractorId="@subcontractor.SubcontractorId" />

        <SubcontractorStatementModal IsOpen="@statementOpen"
                                     SubcontractorId="@subcontractor.SubcontractorId"
                                     SubcontractorName="@subcontractor.CompanyName"
                                     OnClose="() => statementOpen = false" />

        <Modal IsOpen="editOpen" Title="Edit company details" ShowFooter="true"
               ConfirmLabel="@(editBusy ? "Saving…" : "Save changes")" CancelLabel="Cancel"
               OnCancel="CloseEdit" OnConfirm="SaveEdit" Class="max-w-lg w-full">
            @if (editError is not null)
            {
                <Notice Tone="Tone.Negative" Class="mb-3">@editError</Notice>
            }
            <div class="space-y-3">
                <div>
                    <FormField Label="Company name">
                    <input class="field" @bind="eCompany" />
                    </FormField>
                    <p class="text-xs text-content-subtle mt-1">
                        Set this to the supplier's exact name in Xero so their purchase invoices match
                        this company's work orders on the WO Allocation tab.
                    </p>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <FormField Label="Contact name">
                        <input class="field" @bind="eContact" />
                        </FormField>
                    </div>
                    <div>
                        <FormField Label="Email">
                        <input class="field" @bind="eEmail" />
                        </FormField>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <FormField Label="Phone">
                        <input class="field" @bind="ePhone" />
                        </FormField>
                    </div>
                    <div>
                        <FormField Label="Payment terms (days)">
                        <input class="field" type="number" min="0" max="365" @bind="eTermsDays" />
                        </FormField>
                        <p class="text-xs text-content-subtle mt-1">
                            Printed on this company's purchase orders ("@(eTermsDays) day terms").
                            Every company starts on 30 days.
                        </p>
                    </div>
                </div>
                <div>
                    <FormField Label="Address line">
                    <input class="field" @bind="eAddressLine" />
                    </FormField>
                    <p class="text-xs text-content-subtle mt-1">
                        With the town, county and postcode this prints letter-style at the top of
                        the company's purchase orders.
                    </p>
                </div>
                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <FormField Label="Town">
                        <input class="field" @bind="eTown" />
                        </FormField>
                    </div>
                    <div>
                        <FormField Label="County">
                        <input class="field" @bind="eCounty" />
                        </FormField>
                    </div>
                    <div>
                        <FormField Label="Postcode">
                        <input class="field" @bind="ePostcode" />
                        </FormField>
                    </div>
                </div>
            </div>
        </Modal>
    }
</Page>

