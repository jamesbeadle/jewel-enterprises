@page "/projects/{ProjectId}/variations/{VariationOrderId}"
@* The old /voq/ route is kept so links already sent out — in mail, to-dos and bookmarks —
   still land here. Blazor matches both to this page; nothing else needs a redirect. *@
@page "/projects/{ProjectId}/voq/{VariationOrderId}"
@using Jewel.JPMS.Contracts.Variations
@using Jewel.JPMS.Features.RecordLinks
@using Jewel.JPMS.Features.Triage
@using Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Features.Variations
@inject AuthService Auth
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel ProjectList
@inject SessionService Session
@inject IVariationStore Variations
@inject IArchitectInstructionStore Instructions
@inject ISubcontractorStore Subcontractors
@inject IRequestRegister RequestRegister
@inject RecordActivityReadModel Activity
@inject IQueryClient Queries
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IValuationReportStore Valuation
@implements IDisposable

<PageTitle>Variation · JPMS</PageTitle>

<Page>
    @if (!orderLoaded)
    {
        @* Tab chrome first, the record when it lands — "could not be found" must never flash over a
           fetch that is still running. *@
        <ProjectPageShell ProjectId="@ProjectId" ActiveTab="variations">
            <LoadGate IsLoading="true" Prominent="true" Label="Loading variation" />
        </ProjectPageShell>
    }
    else if (order is null)
    {
        <ProjectPageShell ProjectId="@ProjectId" ActiveTab="variations">
            @* A failed fetch and a missing record both leave `order` null — say which. *@
            <p class="text-sm text-content-subtle italic">@(error ?? "That variation order could not be found.")</p>
        </ProjectPageShell>
    }
    else
    {
        <ProjectPageShell ProjectId="@ProjectId" ActiveTab="variations">
            @* Portal-accepted variation orders (subcontractor variation requests) have no originating request. *@
            @if (!string.IsNullOrWhiteSpace(order.RequestId))
            {
                <a href="@RequestHref" class="text-sm text-content-muted hover:text-content inline-flex items-center gap-1 mb-4">
                    &larr; Originating request
                </a>
            }
            else
            {
                <a href="@($"/projects/{ProjectId}/variations")" class="text-sm text-content-muted hover:text-content inline-flex items-center gap-1 mb-4">
                    &larr; Variations
                </a>
            }

            @* Everything that acts on the variation is in this bar — the status pill, the one
               primary button and the Actions menu (the PDF download first). The panels below hold
               the record's facts and the editors / dialogs the menu opens; none carries a button. *@
            <VariationHeaderBar Order="order" Busy="busy"
                                StatusMenuItems="StatusMenuItems" ActionMenuItems="ActionMenuItems"
                                PrimaryLabel="@PrimaryLabel" OnPrimary="RunPrimary" />

            @* The same tab bar as the request page: the chain's documents as tabs, this record active.
               The Request / RFI tabs land back on the containing request page (the RFI tab straight
               onto its official pane). *@
            <RecordTabBar ProjectId="@ProjectId" ActiveId="variation"
                          Request="request" Variation="order"
                          ActivityFor="TabActivity" />

            @if (error is not null)
            {
                <Notice Tone="Tone.Negative" Class="mb-4">@error</Notice>
            }

            @* Seeded (historic) variations predate the request link — say so here, and let the
               menu's "Link originating request…" repair it on the record. *@
            @if (string.IsNullOrWhiteSpace(order.RequestId))
            {
                <Notice Tone="Tone.Warning" Class="mb-4">
                    This variation isn't linked to the request (RFI) it was raised from, so its history can't be traced yet.
                    @(CanManage ? "Link it from Actions to complete the chain." : "A project manager or QS can attach the right RFI from Actions.")
                </Notice>
            }

            @* A variation at Awaiting AI is, by definition, waiting for a document — so say whether it
               has arrived, right here, rather than making someone go and look. Once instructions are
               linked they stay on show at every stage: they are the evidence behind the figures. *@
            @if (linkedInstructions.Count > 0)
            {
                <div class="rounded bg-surface-raised border border-line px-3 py-2 mb-4 flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span class="eyebrow">Architect's Instruction</span>
                    @foreach (var instruction in linkedInstructions)
                    {
                        <a href="@($"/projects/{ProjectId}/architect-instructions")"
                           title="@instruction.Title"
                           class="text-sm text-content hover:underline font-mono">@instruction.DisplayReference</a>
                    }
                    <span class="text-xs text-content-subtle">
                        @(linkedInstructions.Any(instruction => instruction.HasFile)
                            ? "· document on file"
                            : "· document still awaited")
                    </span>
                </div>
            }
            else if (order.Status == VariationOrderStatus.AwaitingArchitectInstruction && instructionsLoaded)
            {
                @* "None is linked yet" is the one thing this page must not say before it has
                   looked, so the line waits for the fetch rather than being gated: a jewel in
                   place of two lines of advice announces a wait nobody is watching for. *@
                <div class="rounded bg-surface-raised border border-line px-3 py-2 mb-4 text-sm text-content-subtle">
                    Waiting on a formal Architect's Instruction. None is linked yet —
                    <a href="@($"/projects/{ProjectId}/architect-instructions")" class="text-accent hover:underline">file or link one</a>
                    when it arrives, then approve the variation to write the contract figures.
                </div>
            }

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                <div class="lg:col-span-2 space-y-5">
                    <VariationDocumentPanel Order="order" CanManage="CanManage" Busy="busy"
                                            @bind-Editing="editingSections"
                                            OnSaved="saved => order = saved" />

                    @if (ApprovedOrder is not null && VariationLines.Count > 0)
                    {
                        <VariationLinesTable Lines="VariationLines" VariationRef="@ApprovedOrder!.VariationRef" />
                    }

                    @* ---- Conversation: the typed record — internal notes plus the shared thread the
                           client portal reads and writes (threaded replies). Distinct from the email
                           Communications below on purpose: clients never see email. *@
                    <VariationConversation VariationOrderId="@VariationOrderId" />

                    @* ---- Communications: the mail behind this record, read live by tag ----
                           Emails tagged to the record's quoting reference or (once approved) its V-ref
                           in mailbox triage appear here, so the correspondence behind the variation is
                           visible where the record lives — not only on the project's Communications tab. *@
                    <div class="panel p-5">
                        <RecordCorrespondencePanel Type="RecordType.VariationQuote" RecordId="@VariationOrderId"
                                                   RecordReference="@order.Reference" ProjectId="@ProjectId"
                                                   Emails="emails" Loaded="emailsLoaded" Error="@emailsError"
                                                   OnReload="LoadEmailsAsync">
                            <EmptyMessage>
                                No emails are tagged to this variation yet. Tag an email to
                                <span class="font-medium not-italic text-content">@order.Reference</span>@(ApprovedOrder is not null ? $" or {order.VariationRef}" : "")
                                in mailbox triage and it appears here.
                            </EmptyMessage>
                        </RecordCorrespondencePanel>
                    </div>
                </div>

                <div class="space-y-5">
                    <VariationDetailsCard Order="order"
                                          DetailsLoaded="Subcontractors.IsLoaded"
                                          SelectedSubName="@SelectedSubName()"
                                          CanEditEstimate="CanEditEstimate"
                                          Busy="busy"
                                          @bind-EditingEstimate="editingEstimate"
                                          OnSaved="saved => order = saved" />

                    @if (ApprovedOrder is not null)
                    {
                        var approved = ApprovedOrder!;
                        <ApprovedFiguresPanel Approved="approved"
                                              Reference="@order.Reference"
                                              CanManage="CanManage"
                                              Busy="busy"
                                              ValuationLinesReady="ValuationLinesReady"
                                              CostCentres="ApprovedCostCentres"
                                              LineCount="VariationLines.Count"
                                              @bind-Revising="revisingValue"
                                              ReviseValue="ReviseVoValue"
                                              @bind-ReturningToQuoting="returningToQuoting"
                                              OnReturnToQuoting="ReturnToQuoting"
                                              @bind-RejectingOrder="rejectingOrder"
                                              OnReject="RejectOrder" />

                        <Modal IsOpen="editLinesModalOpen"
                               Title="@($"Edit lines — {order.DisplayNumber}")"
                               ShowFooter="false"
                               OnCancel="CloseEditLines"
                               Class="max-w-3xl">
                            <VariationApprovePanel ShowHeading="false"
                                                   InitialLines="@CurrentLineInputs"
                                                   SubmitLabel="Save lines"
                                                   HelpOverride="Editing re-prices these lines on the Valuation Report and moves the CVR and cost-centre budgets by the difference. Nothing else changes."
                                                   Busy="@busy"
                                                   SubmitError="@editLinesError"
                                                   OnApprove="SaveLinesEdit" />
                        </Modal>
                    }
                    else if (CanManage && order.Status.IsPreApproval())
                    {
                        @* The staged build-up stays on show (it IS the estimate); its dialog, the
                           approve modal and the tender dialog open from the bar. *@
                        <StagedBuildUpPanel @key="VariationOrderId" Order="order" Busy="busy"
                                            @bind-DialogOpen="buildUpDialogOpen"
                                            OnStaged="OnBuildUpStaged" />
                        <VariationApproveOffer Order="order" Busy="busy"
                                               @bind-ModalOpen="approveModalOpen"
                                               OnApprove="ApproveWithLines" />
                        <RecordAgreedTenderPanel VariationOrderId="@VariationOrderId" Busy="busy"
                                                 @bind-IsOpen="recordingTender"
                                                 OnRecorded="OnTenderRecorded" />
                    }
                </div>
            </div>

            @* ---- Dialogs the bar opens ------------------------------------------------------------ *@

            @* Retitling is allowed at EVERY stage, approved ones included: a badly worded title is
               worth fixing whenever it is spotted, and it is the number — not the wording — that the
               client's paperwork is keyed to. What has already been claimed keeps the wording it was
               issued with (the handler rewrites nothing downstream). *@
            <Modal IsOpen="renamingOrder"
                   Title="@($"Edit title — {order.DisplayNumber}")"
                   ConfirmLabel="Save title"
                   ConfirmDisabled="@(busy || string.IsNullOrWhiteSpace(renameTitle))"
                   OnCancel="CancelRename"
                   OnConfirm="SaveTitle"
                   Class="max-w-xl">
                <div class="space-y-3">
                    @if (renameError is not null)
                    {
                        <Notice Tone="Tone.Negative">@renameError</Notice>
                    }
                    <FormField Label="Title" Value="@renameTitle" OnChange="v => renameTitle = v" Required="true" />
                    @if (order.Status == VariationOrderStatus.Approved)
                    {
                        <p class="text-xs text-content-subtle">
                            Valuation lines and CVR entries already written for
                            <span class="font-mono">@order.VariationRef</span> keep the title they were issued with —
                            this record and anything written from here on read the new one.
                        </p>
                    }
                </div>
            </Modal>

            @if (CanManage && string.IsNullOrWhiteSpace(order.RequestId))
            {
                <OriginatingRequestRepair VariationOrderId="@VariationOrderId"
                                          Candidates="@LinkCandidateOptions"
                                          @bind-IsOpen="linkingRequest"
                                          OnLinked="ReloadAsync" />
            }

            @if (CanManage && ApprovedOrder is null)
            {
                <DeleteVariationPanel Reference="@order.DisplayNumber" Busy="busy"
                                      @bind-IsOpen="deletingOrder"
                                      OnDelete="DeleteOrder" />
            }

            <DeclineVariationModal Order="order" @bind-IsOpen="decliningOrder" Busy="busy" Error="@error"
                                   OnConfirm="RejectOrder" />
        </ProjectPageShell>
    }
</Page>
