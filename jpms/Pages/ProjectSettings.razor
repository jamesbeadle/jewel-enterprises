@page "/projects/{ProjectId}/settings"
@using Jewel.JPMS.Features.Projects
@inject AuthService Auth
@inject SessionService Session
@inject ProjectListReadModel Projects
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Project settings · JPMS</PageTitle>

@*
    The project's ONE settings page — the three per-section Setup tabs recombined so "Setup" means
    a single place: Details (identity, site address and Xero mapping), Deposits, retentions & valuation (the
    money-side profile), Contract (the executed document and the terms every clause citation is argued from),
    and Correspondence (the profile that routes every document the project issues). The old /setup,
    /financials-setup and /operations-setup routes redirect here.
*@

<Page>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="settings">
        @if (Project is not null)
        {
            <div class="flex flex-wrap items-center gap-2 mb-5 text-sm">
                @foreach (var pane in Panes)
                {
                    <button type="button" class="@PaneClass(pane)" @onclick="() => activePane = pane">@pane</button>
                }
            </div>

            @switch (activePane)
            {
                case DetailsPane:
                    <div class="flex items-center justify-end mb-3">
                        <ProjectDetailsEditor ProjectId="@ProjectId" />
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4 mb-3">
                        <StatTile Label="Stage"           Value="@Project.Stage.DisplayName()" />
                        <StatTile Label="Entity"          Value="@Project.Organisation.ShortCode()" />
                        <StatTile Label="Project Manager" Value="@Project.ProjectManagerEmail" />
                        <StatTile Label="Client"          Value="@Project.ClientName" />
                        <StatTile Label="Site address"    Value="@SiteAddress(Project)" />
                        <StatTile Label="Xero site"       Value="@XeroSite(Project)" />
                        <StatTile Label="Xero contact"    Value="@XeroContact(Project)" />
                    </div>
                    @* Created is the system's own stamp — a secondary fact here, never a lead date. *@
                    <p class="text-xs text-content-subtle mb-6">Created @DateText(Project.CreatedAt)</p>
                    break;
                case ContractPane:
                    <ProjectContractPanel ProjectId="@ProjectId" />
                    break;
                case RetentionPane:
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4 mb-6">
                        <NextValuationDateEditor ProjectId="@ProjectId" />
                    </div>
                    <ProjectRetentionPanel ProjectId="@ProjectId" />
                    break;
                default:
                    <ProjectCorrespondencePanel ProjectId="@ProjectId" />
                    break;
            }
        }
    </ProjectPageShell>
</Page>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    private const string DetailsPane = "Details";
    private const string RetentionPane = "Deposits, retentions & valuation";
    private const string ContractPane = "Contract";
    private const string CorrespondencePane = "Correspondence";
    private static readonly string[] Panes = { DetailsPane, RetentionPane, ContractPane, CorrespondencePane };

    private string activePane = DetailsPane;

    private Project? Project => Projects.Find(ProjectId);

    // The site address as one line — the record's free-text parts joined in order, "Not set" when
    // nothing has been recorded. Town + Postcode are what "Find subcontractors" searches near.
    private static string SiteAddress(Project project)
    {
        var joined = string.Join(", ",
            new[] { project.AddressLine, project.Town, project.Postcode }
                .Where(part => !string.IsNullOrWhiteSpace(part))
                .Select(part => part.Trim()));
        return joined.Length == 0 ? "Not set" : joined;
    }

    // The project's option in Xero's "Sites" tracking category — "Not set" is worth surfacing
    // because the Xero write-back refuses to run until it is mapped.
    private static string XeroSite(Project project) =>
        string.IsNullOrWhiteSpace(project.XeroSiteName) ? "Not set" : project.XeroSiteName;

    // The Xero customer the project's sales invoices are raised on — "Not mapped" is worth
    // surfacing because Raise in Xero is blocked until it is.
    private static string XeroContact(Project project) =>
        string.IsNullOrWhiteSpace(project.XeroContactId) ? "Not mapped"
            : string.IsNullOrWhiteSpace(project.XeroContactName) ? project.XeroContactId : project.XeroContactName;

    private string PaneClass(string pane) =>
        pane == activePane
            ? "px-3 py-1.5 rounded bg-accent text-accent-ink font-medium"
            : "px-3 py-1.5 rounded text-content-muted hover:text-content hover:bg-surface-raised";

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        // Re-render when the project list refreshes (e.g. after "Edit details" saves) so the stats
        // pick up the new stage / entity / project manager without a page reload.
        Projects.OnChanged += StateHasChanged;
        if (Projects.Current is null) await Projects.RefreshAsync(CancellationToken.None);
    }

    public void Dispose() => Projects.OnChanged -= StateHasChanged;
}
