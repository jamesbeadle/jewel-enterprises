@page "/sales/leads"
@using Jewel.JPMS.Contracts.Sales
@using Jewel.JPMS.Features.Sales
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject LeadListReadModel Leads
@inject SalesStrategyListReadModel Strategies
@implements IDisposable

<PageTitle>Leads · JPMS</PageTitle>

@*
    Sales → Leads (2026-09-06): the one register of everyone Jewel might convince to build with
    it, whatever found them — a sales strategy, an inbound enquiry, a referral, an architect, a
    past client, or someone typing it in. Every lead climbs the same short ladder (New →
    Contacted → Engaged → Site visit → Proposal → Won / Lost, Nurture for the parked) so
    strategies can be compared on how far their leads get. Open leads by default; stage chips,
    a strategy filter and a search narrow the table; a row opens the lead's page. Won is never
    set here — it happens on the lead page and creates the client and the project shell.
*@

<Page>
    <WorkspaceSectionNav />
    <PageHeader>
        <SubtitleContent>
            Everyone we might convince to build with Jewel — to upgrade their house or have a new one built —
            and the property the work would be on. Every lead lands here whatever found it; the strategy that
            found it is named on the row, so a strategy is judged by how far its leads climb.
        </SubtitleContent>
        <Actions>
            @if (CanWork)
            {
                <button type="button" class="btn-primary shrink-0" @onclick="OpenCapture">New lead</button>
            }
        </Actions>
    </PageHeader>

    @if (dataFailed && Leads.Current is null)
    {
        <div class="panel p-6 max-w-3xl">
            <p class="text-sm text-negative">The lead register couldn't be loaded — the error banner has the detail. Reload the page to retry.</p>
        </div>
    }
    else
    {
        @* The four figures and the register are one wait, not five: every one of them is counted
           off the lead read the page opens with, and the strategy named on each row comes with it.
           So one gate covers the pair and they arrive together, rather than four tiles and a table
           each pulsing on their own account for a single fetch. *@
        <LoadGate IsLoading="@LoadState.UntilAllPresent(Leads.Current, Strategies.Current)" Prominent="true" Label="Loading leads">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <StatTile Label="Open leads" Value="@Open.Count.ToString()" />
            <StatTile Label="Open pipeline" Value="@WholeMoney(Open.Sum(lead => lead.EstimatedValue ?? 0m))" />
            <StatTile Label="Won this year" Value="@WonThisYear.ToString()" />
            <StatTile Label="New in the last 30 days" Value="@NewRecently.ToString()" />
        </div>

        <Panel Title="Lead register" BodyClass="p-0">
            <HeaderActions>
                <SearchInput @bind-Value="search" Placeholder="Search name, company, postcode, ref" Width="w-56" />
                <SearchSelect Options="@StrategyOptions" Value="@strategyFilter" ValueChanged="v => strategyFilter = v"
                              Placeholder="All strategies" WidthClass="w-56" />
            </HeaderActions>
            <ChildContent>
                <div class="flex flex-wrap items-center gap-1.5 px-6 py-4 border-b border-line">
                    <button type="button" class="@ChipClass(stageFilter is null)" @onclick="() => stageFilter = null">
                        Open <span class="ml-1 text-content-faint">@Open.Count</span>
                    </button>
                    @foreach (var stage in LeadStageExtensions.Ladder)
                    {
                        var s = stage;
                        var count = All.Count(lead => lead.Stage == s);
                        <button type="button" class="@ChipClass(stageFilter == s)" title="@s.Meaning()" @onclick="() => stageFilter = s">
                            @s.DisplayName() <span class="ml-1 text-content-faint">@count</span>
                        </button>
                    }
                </div>

                @if (All.Count == 0)
                {
                    <p class="px-6 py-8 text-sm text-content-subtle italic">
                        No leads yet. Add the first with New lead — or write down how you mean to find them under
                        <a href="/sales/strategies" class="text-info underline underline-offset-4">Strategies</a>.
                    </p>
                }
                else if (Rows.Count == 0)
                {
                    <p class="px-6 py-8 text-sm text-content-subtle italic">No leads match this view.</p>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Ref</th>
                                    <th>Lead</th>
                                    <th>Property</th>
                                    <th>The work</th>
                                    <th>Found by</th>
                                    <th>Stage</th>
                                    <th class="text-right">Value</th>
                                    <th>Owner</th>
                                    <th>Captured</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lead in Rows)
                                {
                                    var row = lead;
                                    <tr class="is-clickable cursor-pointer" @key="row.LeadId" @onclick="() => OpenLead(row)">
                                        <td class="whitespace-nowrap font-mono text-xs">@row.Reference</td>
                                        <td>
                                            <p class="text-content font-medium">@(string.IsNullOrWhiteSpace(row.ContactName) ? row.CompanyName : row.ContactName)</p>
                                            <p class="text-xs text-content-subtle">
                                                @(string.IsNullOrWhiteSpace(row.ContactName) ? row.ProspectKind.DisplayName() : string.IsNullOrWhiteSpace(row.CompanyName) ? row.ProspectKind.DisplayName() : $"{row.CompanyName} · {row.ProspectKind.DisplayName()}")
                                            </p>
                                        </td>
                                        <td>
                                            <p class="max-w-xs truncate" title="@row.PropertyAddress">@(string.IsNullOrWhiteSpace(row.PropertyAddress) ? "—" : row.PropertyAddress)</p>
                                            @if (!string.IsNullOrWhiteSpace(row.Postcode))
                                            {
                                                <p class="text-xs text-content-subtle">@row.Postcode</p>
                                            }
                                        </td>
                                        <td><span class="line-clamp-2 max-w-sm" title="@row.Summary">@(string.IsNullOrWhiteSpace(row.Summary) ? "—" : row.Summary)</span></td>
                                        <td class="whitespace-nowrap">
                                            @if (row.StrategyId is not null)
                                            {
                                                <a href="/sales/strategies/@row.StrategyId" class="text-info hover:underline underline-offset-4" @onclick:stopPropagation="true">@(row.StrategyName ?? "Strategy")</a>
                                            }
                                            else
                                            {
                                                <span>@row.Source.DisplayName()</span>
                                            }
                                        </td>
                                        <td><LeadStagePill Stage="@row.Stage" /></td>
                                        <td class="text-right whitespace-nowrap">@(row.EstimatedValue is { } v ? WholeMoney(v) : "—")</td>
                                        <td class="whitespace-nowrap text-xs">@OwnerLabel(row.OwnerEmail)</td>
                                        <td class="whitespace-nowrap text-xs" title="@DateTimeText(row.CapturedAt.ToLocalTime())">@DateText(row.CapturedAt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </ChildContent>
        </Panel>
        </LoadGate>
    }

    <LeadFormModal IsOpen="@captureOpen" Strategies="@Strategies.Current" OnSaved="OnCapturedAsync" OnCancel="() => captureOpen = false" />
</Page>

@code {
    private bool dataFailed;
    private bool captureOpen;
    private string search = "";
    private string strategyFilter = "";
    private LeadStage? stageFilter;

    private IReadOnlyList<Lead> All => Leads.Current ?? Array.Empty<Lead>();
    private List<Lead> Open => All.Where(lead => lead.Stage.IsOpen()).ToList();
    private int WonThisYear => All.Count(lead => lead.Stage == LeadStage.Won && lead.StageChangedAt.Year == DateTimeOffset.Now.Year);
    private int NewRecently => All.Count(lead => lead.CapturedAt >= DateTimeOffset.UtcNow.AddDays(-30));

    // The client-side sales-team check mirrors the API's SalesRoles.SalesTeam (the API is the gate).
    private bool CanWork => Session.ActiveRole is Role.Admin or Role.ManagingDirector or Role.FinanceDirector
        or Role.ProjectManager or Role.QuantitySurveyor or Role.SalesMarketing;

    private IReadOnlyList<Lead> Rows
    {
        get
        {
            IEnumerable<Lead> rows = stageFilter is { } stage ? All.Where(lead => lead.Stage == stage) : Open;
            if (!string.IsNullOrWhiteSpace(strategyFilter))
                rows = rows.Where(lead => lead.StrategyId == strategyFilter);
            if (!string.IsNullOrWhiteSpace(search))
            {
                var needle = search.Trim();
                rows = rows.Where(lead =>
                    lead.Reference.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || lead.ContactName.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || lead.CompanyName.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || lead.PropertyAddress.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || lead.Postcode.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || lead.Summary.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || lead.ContactEmail.Contains(needle, StringComparison.OrdinalIgnoreCase));
            }
            return rows.ToList();
        }
    }

    private IReadOnlyList<SearchSelect.Option> StrategyOptions =>
        (Strategies.Current ?? Array.Empty<SalesStrategyOverview>())
            .Select(row => new SearchSelect.Option(row.Strategy.StrategyId, row.Funnel.Leads == 0 ? row.Strategy.Name : $"{row.Strategy.Name} ({row.Funnel.Leads})"))
            .ToList();

    private static string ChipClass(bool active) =>
        (active ? "chip chip-active" : "chip");

    private static string OwnerLabel(string email)
    {
        var at = email.IndexOf('@');
        return at > 0 ? email[..at] : email;
    }

    protected override async Task OnInitializedAsync()
    {
        Leads.OnChanged += StateHasChanged;
        Strategies.OnChanged += StateHasChanged;
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            await Task.WhenAll(
                Leads.RefreshAsync(CancellationToken.None),
                Strategies.RefreshAsync(CancellationToken.None));
        }
        catch { dataFailed = true; } // the query client has already toasted the detail
    }

    private void OpenCapture() => captureOpen = true;

    private void OpenLead(Lead lead) => Nav.NavigateTo($"/sales/leads/{lead.LeadId}");

    private async Task OnCapturedAsync(Lead lead)
    {
        captureOpen = false;
        // Post-write reload: swallow query failures (the toast already reported them).
        try { await Leads.RefreshAsync(CancellationToken.None); }
        catch (OperationCanceledException) { throw; }
        catch { }
        Nav.NavigateTo($"/sales/leads/{lead.LeadId}");
    }

    public void Dispose()
    {
        Leads.OnChanged -= StateHasChanged;
        Strategies.OnChanged -= StateHasChanged;
    }
}
