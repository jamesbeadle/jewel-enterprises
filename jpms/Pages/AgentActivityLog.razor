@page "/agents/activity"
@inject AuthService Auth
@inject SessionService Session
@inject IQueryClient Queries
@inject NavigationManager Nav

<PageTitle>Agent activity · JPMS</PageTitle>

@*
    Every agent run, newest first — chat turns today, and the scheduled sweeps when they land.

    Two jobs. Accountability: when the machine acted, on whose behalf, what it touched, and whether
    a human was in the loop. And cost: token counts are the ground truth for what the assistant is
    spending, which is the promise the chat panel's billed-usage strip makes to the user.

    Gated to administrators and directors — the people who authorise the spend are the people who
    should see it, mirroring the API's AiRoles.AllowedToUseAssistant.
*@

<Page CanAccess="CanSee" AccessDeniedMessage="You do not have access to the agent activity log.">
        <PageHeader>
            <SubtitleContent>
                Every run the assistant has made, newest first. Rows marked
                <span class="text-content">unattended</span> ran with nobody watching.
            </SubtitleContent>
        </PageHeader>

        <div class="flex flex-wrap items-center gap-2 mb-4">
            <button type="button" @onclick="() => SetFilter(false)" class="@FilterClass(false)">All runs</button>
            <button type="button" @onclick="() => SetFilter(true)" class="@FilterClass(true)">Unattended only</button>
        </div>

        <LoadGate IsLoading="@(rows is null && !dataFailed)" Prominent="true" Label="Loading activity">
            @if (dataFailed)
            {
                <div class="panel p-5">
                    <p class="text-sm text-content-muted">
                        The activity log could not be loaded. The error toast carries the reference.
                    </p>
                </div>
            }
            else if (rows!.Count == 0)
            {
                <div class="panel p-5">
                    <p class="text-sm text-content-muted">
                        @(autonomousOnly
                            ? "Nothing has run unattended yet — no scheduled agents are live."
                            : "No agent has run yet.")
                    </p>
                </div>
            }
            else
            {
                <div class="panel overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>When</th>
                                    <th>Agent</th>
                                    <th>Ran as</th>
                                    <th>Action</th>
                                    <th>Outcome</th>
                                    <th>Tools</th>
                                    <th class="text-right">Took</th>
                                    <th class="text-right">Tokens</th>
                                    <th class="text-right">Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in rows)
                                {
                                    <tr class="@(string.IsNullOrWhiteSpace(row.Route) ?"" : "is-clickable")"
                                        @onclick="() => Open(row)">
                                        <td class="whitespace-nowrap">@row.OccurredAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                        <td class="text-content">@row.AgentKey</td>
                                        <td>
                                            <span class="block truncate max-w-[14rem]" title="@row.ActorEmail">@row.ActorEmail</span>
                                            @if (row.IsAutonomous)
                                            {
                                                <span class="mt-0.5 inline-block rounded bg-surface-raised border border-line px-1.5 py-0.5 text-xs text-content-subtle">unattended</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="block text-content">@row.Action</span>
                                            <span class="block truncate max-w-[22rem] text-xs text-content-subtle" title="@row.Summary">@row.Summary</span>
                                        </td>
                                        <td><span class="@OutcomeClass(row.Outcome)">@OutcomeLabel(row.Outcome)</span></td>
                                        <td class="text-xs text-content-subtle">
                                            <span class="block truncate max-w-[16rem]" title="@row.ToolsUsed">@(string.IsNullOrWhiteSpace(row.ToolsUsed) ? "—" : row.ToolsUsed)</span>
                                        </td>
                                        <td class="text-right whitespace-nowrap">@FormatDuration(row.DurationMs)</td>
                                        <td class="text-right whitespace-nowrap">@row.TotalTokens.ToString("N0")</td>
                                        <td class="text-right whitespace-nowrap">
                                            @(row.CostPence > 0 ? row.CostDisplay : "—")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-4 flex flex-wrap items-center gap-6 text-xs text-content-subtle">
                    <span>@rows.Count runs</span>
                    <span>@rows.Sum(row => row.TotalTokens).ToString("N0") tokens</span>
                    @if (rows.Any(row => row.CostPence > 0))
                    {
                        <span>@FormatPence(rows.Sum(row => row.CostPence)) total</span>
                    }
                    else
                    {
                        <span title="Set Anthropic__InputPencePerMillion and Anthropic__OutputPencePerMillion">
                            Cost rate not configured — token counts are exact
                        </span>
                    }
                </div>
            }
        </LoadGate>
</Page>

@code {
    private bool dataFailed;
    private bool autonomousOnly;

    // Null means no fetch has landed — never render a count from it (CLAUDE.md loading states).
    private IReadOnlyList<AgentActivity>? rows;

    private bool CanSee =>
        Session.ActiveRole is { } role && DesktopNavigation.CanUseAssistant(role);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (CanSee) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        dataFailed = false;
        rows = null;
        try
        {
            rows = await Queries.AskAsync(
                new ListAgentActivity(AutonomousOnly: autonomousOnly ? true : null),
                CancellationToken.None);
        }
        catch
        {
            dataFailed = true;
        }
    }

    private async Task SetFilter(bool onlyAutonomous)
    {
        if (autonomousOnly == onlyAutonomous) return;
        autonomousOnly = onlyAutonomous;
        await LoadAsync();
    }

    private string FilterClass(bool value) =>
        autonomousOnly == value
            ? "chip"
            : "chip";

    private void Open(AgentActivity row)
    {
        if (!string.IsNullOrWhiteSpace(row.Route)) Nav.NavigateTo(row.Route);
    }

    private static string OutcomeLabel(AgentOutcome outcome) => outcome switch
    {
        AgentOutcome.Ok => "Ok",
        AgentOutcome.Failed => "Failed",
        AgentOutcome.Refused => "Refused",
        AgentOutcome.NotConfigured => "Not configured",
        AgentOutcome.Truncated => "Cut short",
        _ => outcome.ToString()
    };

    private static string OutcomeClass(AgentOutcome outcome)
    {
        var baseClass = "inline-block rounded px-2 py-0.5 text-xs font-medium";
        return outcome switch
        {
            AgentOutcome.Ok => $"{baseClass} bg-accent/10 text-accent",
            AgentOutcome.Failed => $"{baseClass} bg-negative/10 text-negative",
            AgentOutcome.NotConfigured => $"{baseClass} bg-negative/10 text-negative",
            AgentOutcome.Refused => $"{baseClass} bg-negative/10 text-negative",
            _ => $"{baseClass} bg-surface-raised text-content-subtle"
        };
    }

    private static string FormatDuration(int milliseconds) =>
        milliseconds < 1000 ? $"{milliseconds}ms" : $"{milliseconds / 1000.0:0.0}s";

    private static string FormatPence(decimal pence) =>
        pence >= 100m ? $"£{pence / 100m:0.00}" : $"{pence:0.0}p";
}
