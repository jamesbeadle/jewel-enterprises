@page "/projects/{ProjectId}/building-control/inspections/{InspectionId}"
@using Jewel.JPMS.Contracts.BuildingControl
@using Jewel.JPMS.Contracts.MailboxCompose
@using Jewel.JPMS.Features.BuildingControl
@using Jewel.JPMS.Features.Triage.Panels
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject BuildingControlReadModel BuildingControl
@inject IBuildingControlAttachmentClient Attachments
@inject ICommandSender Commands
@inject IQueryClient Queries
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel ProjectList
@inject IIntakeQueue Intake
@implements IDisposable

<PageTitle>Building Control Inspection · JPMS</PageTitle>

@*
    One inspection stage: its status ladder and dates, the photo evidence and the inspector's
    site report, and the correspondence read live by its JPMS/BCI-#### tag — the inspector's
    booking email, the follow-up, the report arriving. Replying from here sends from the projects
    mailbox and files itself back into this list.
*@

<Page>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="building-control">
        @* The stage record, its photos and its documents are one load, so they gate together.
           The correspondence below keeps a gate of its own because it reloads on its own — a
           reply sent, an email linked — and the cascade silences it while this one speaks. *@
        <LoadGate IsLoading="@(!BuildingControl.LoadedFor(ProjectId) && !dataFailed)" Prominent="true" Label="Loading inspection">
        @if (Inspection is null)
        {
            <p class="text-sm text-content-muted">
                That inspection wasn't found on this project.
                <a class="text-accent hover:underline" href="/projects/@ProjectId/building-control">Back to Building Control</a>
            </p>
        }
        else
        {
            var inspection = Inspection;

            <div class="mb-4">
                <a class="text-xs text-content-subtle hover:text-content" href="/projects/@ProjectId/building-control">← Building Control</a>
                <div class="flex flex-wrap items-center gap-3 mt-1">
                    <h2 class="text-lg font-semibold text-content">@inspection.StageName</h2>
                    <span class="font-mono text-xs text-content-muted">@inspection.Reference</span>
                    <select class="field py-1" value="@((int)inspection.Status)" disabled="@busy"
                            @onchange="e => SetStatusAsync(inspection, e)">
                        @foreach (var status in Enum.GetValues<BuildingControlInspectionStatus>())
                        {
                            <option value="@((int)status)">@status.DisplayName()</option>
                        }
                    </select>
                </div>
            </div>

            @if (actionError is { } error)
            {
                <Notice Tone="Tone.Negative" Class="mb-4">@error</Notice>
            }

            @* ---- Details: the official dates lead; Created is a secondary fact. ---- *@
            <section class="panel p-5 mb-5">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-3">
                    <div>
                        <FormField Label="Booked for">
                        <input type="date" class="field" value="@editBookedFor" disabled="@busy"
                               @onchange="e => editBookedFor = e.Value?.ToString() ?? string.Empty" />
                        </FormField>
                    </div>
                    <div>
                        <FormField Label="Inspected">
                        <input type="date" class="field" value="@editInspectedAt" disabled="@busy"
                               @onchange="e => editInspectedAt = e.Value?.ToString() ?? string.Empty" />
                        </FormField>
                    </div>
                    <div class="sm:col-span-2">
                        <FormField Label="Inspector">
                        <input type="text" class="field" maxlength="256" placeholder="Who carried out the visit"
                               value="@editInspectorName" @oninput="e => editInspectorName = e.Value?.ToString() ?? string.Empty" />
                        </FormField>
                    </div>
                </div>
                <div class="mb-3">
                    <FormField Label="Outcome / actions required">
                    <textarea class="field" rows="2" maxlength="2048" placeholder="The inspector's outcome — passed subject to…, actions before re-inspection…"
                              value="@editOutcomeNotes" @oninput="e => editOutcomeNotes = e.Value?.ToString() ?? string.Empty"></textarea>
                    </FormField>
                </div>
                <div class="mb-3">
                    <FormField Label="Stage name">
                    <input type="text" class="field" maxlength="256"
                           value="@editStageName" @oninput="e => editStageName = e.Value?.ToString() ?? string.Empty" />
                    </FormField>
                </div>
                <div class="flex items-center justify-between">
                    <button type="button" class="btn-primary"
                            disabled="@(string.IsNullOrWhiteSpace(editStageName) || busy || !HasEdits(inspection))"
                            @onclick="() => SaveAsync(inspection)">
                        Save changes
                    </button>
                    <p class="text-xs text-content-subtle" title="System stamp — the official dates above are what matters">
                        Created @DateText(inspection.RaisedAt)@(string.IsNullOrWhiteSpace(inspection.RaisedByEmail) ? "" : $" by {inspection.RaisedByEmail}")
                    </p>
                </div>
            </section>

            @* ---- Photos. ---- *@
            <section class="panel p-5 mb-5">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="eyebrow">Photos</h3>
                    <label class="text-xs text-accent hover:underline cursor-pointer @(busy ?"opacity-50 pointer-events-none" : "")">
                        + Add photos
                        <InputFile OnChange="e => UploadAsync(inspection, e, BuildingControlAttachmentKind.Photo)" multiple accept="image/*" class="hidden" />
                    </label>
                </div>
                @if (Photos.Count == 0)
                {
                    <EmptyState Message="No photos on this stage yet — on site, this page on the phone uploads straight from the camera." />
                }
                else
                {
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
                        @foreach (var photo in Photos)
                        {
                            <figure @key="photo.BuildingControlAttachmentId" class="group relative">
                                <a href="@Attachments.FileUrl(photo.BuildingControlAttachmentId, isInline: true)" target="_blank" rel="noopener">
                                    <img src="@Attachments.FileUrl(photo.BuildingControlAttachmentId, isInline: true)" alt="@photo.DisplayName"
                                         class="w-full h-28 object-cover rounded border border-line" loading="lazy" />
                                </a>
                                <button type="button" title="Remove photo"
                                        class="absolute top-1 right-1 hidden group-hover:flex items-center justify-center w-6 h-6 rounded-full bg-surface/90 text-content-subtle hover:text-negative text-xs"
                                        disabled="@busy" @onclick="() => RemoveFileAsync(photo.BuildingControlAttachmentId)">✕</button>
                            </figure>
                        }
                    </div>
                }
            </section>

            @* ---- Documents: the inspector's site report and anything else that isn't a photo. ---- *@
            <section class="panel p-5 mb-5">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="eyebrow">Documents</h3>
                    <label class="text-xs text-accent hover:underline cursor-pointer @(busy ?"opacity-50 pointer-events-none" : "")">
                        + Add files
                        <InputFile OnChange="e => UploadAsync(inspection, e, kind: null)" multiple class="hidden" />
                    </label>
                </div>
                @if (Documents.Count == 0)
                {
                    <p class="text-sm text-content-subtle italic">
                        No documents on this stage yet — the inspector's site report usually arrives by email:
                        open it below and copy its attachments onto the stage.
                    </p>
                }
                else
                {
                    <ul class="space-y-2">
                        @foreach (var file in Documents)
                        {
                            <li class="rounded border border-line bg-surface px-4 py-3 flex flex-wrap items-center justify-between gap-2">
                                <div class="min-w-0">
                                    <a class="text-sm font-medium text-content hover:underline"
                                       href="@Attachments.FileUrl(file.BuildingControlAttachmentId)" download>@file.DisplayName</a>
                                    <span class="text-xs text-content-subtle ml-2">@file.Kind.Label() · @FormatSize(file.FileSizeBytes)</span>
                                    <span class="text-xs text-content-subtle ml-2">· @SourceLabel(file.Source) @DateText(file.AddedAt)</span>
                                </div>
                                <button type="button" class="text-xs text-content-muted hover:text-negative" disabled="@busy"
                                        @onclick="() => RemoveFileAsync(file.BuildingControlAttachmentId)">Remove</button>
                            </li>
                        }
                    </ul>
                }
            </section>

            @* ---- Correspondence, read live by the JPMS/BCI-#### tag. ---- *@
            <section class="panel p-5">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="eyebrow">Correspondence</h3>
                    <div class="flex items-center gap-3">
                        @if (emails is not null && Emails.Count > 0)
                        {
                            <Pill Tone="Tone.Info">@Emails.Count</Pill>
                        }
                        <EmailFinder Type="RecordType.BuildingControlInspection" RecordId="@inspection.BuildingControlInspectionId"
                                     RecordReference="@inspection.Reference" ExcludeTag="@OwnTag" OnLinked="ReloadEmailsAsync" />
                    </div>
                </div>
                <LoadGate IsLoading="@(emails is null && !emailsFailed)" Prominent="true" Label="Loading correspondence">
                @if (sentNote is not null)
                {
                    <div class="rounded border border-positive/40 bg-positive/5 px-3 py-2 mb-3 flex items-center justify-between gap-2">
                        <p class="text-sm text-content">@sentNote</p>
                        <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss" @onclick="() => sentNote = null">✕</button>
                    </div>
                }
                @if (replyingTo is { } anchor)
                {
                    <div class="mb-3 space-y-2">
                        <p class="text-sm text-content-muted">
                            @(isForward ? "Forwarding" : "Replying to") <span class="text-content font-medium">@(string.IsNullOrWhiteSpace(anchor.FromName) ? anchor.FromEmail : anchor.FromName)</span> —
                            <span class="italic">@anchor.Subject</span>
                        </p>
                        <MailReplyComposer @key="@($"{anchor.Id}:{isForward}")" ReplyTo="anchor" Forward="isForward"
                                           Projects="@(ProjectList.Current ?? Array.Empty<Project>())" ProjectId="@ProjectId"
                                           FooterNote="The email sends now from the projects mailbox and files itself back into this list."
                                           OnSent="OnSent" OnCancel="() => replyingTo = null" />
                    </div>
                }
                @if (Emails.Count == 0)
                {
                    @if (emails is not null)
                    {
                        <p class="text-sm text-content-subtle italic">
                            No emails tagged to this inspection. Tag them with @inspection.Reference in the Control Centre and they appear here.
                        </p>
                    }
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var email in Emails)
                        {
                            @if (email.HasAttachments)
                            {
                                <div class="text-right">
                                    <button type="button" class="text-xs text-accent hover:underline" disabled="@busy"
                                            title="Copy this email's attachments onto the stage — the inspector's report and photos"
                                            @onclick="() => CopyEmailFilesAsync(inspection, email)">
                                        Copy attachments from “@email.Subject”
                                    </button>
                                </div>
                            }
                        }
                        <CorrespondenceThreadList Emails="Emails" ExcludeTag="@OwnTag"
                                                  OnReply="email => StartCompose(email, forward: false)"
                                                  OnForward="email => StartCompose(email, forward: true)"
                                                  OnUntagged="_ => ReloadEmailsAsync()" />
                    </div>
                }
                </LoadGate>
            </section>
        }
        </LoadGate>
    </ProjectPageShell>
</Page>

