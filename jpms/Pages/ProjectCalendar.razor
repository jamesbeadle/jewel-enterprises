@page "/projects/{ProjectId}/calendar"
@using Jewel.JPMS.Contracts.Calendar
@using Jewel.JPMS.Features.Calendar
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject CalendarReadModel Calendar
@inject ICommandSender Commands
@inject IQueryClient Queries
@implements IDisposable

<PageTitle>Calendar · JPMS</PageTitle>

@*
    The project's calendar: what is coming up on site — visits, deliveries, meetings,
    subcontractor attendance. An event is raised here directly or from an email in the Control
    Centre (System Actions → Raise calendar event); either way it carries a sequential CAL-####
    reference, which is also its mailbox tag stem — so every email filed to the event reads back
    live under it here, exactly like a to-do or a defect. Events marked "Visible to client" are
    the client-safe subset, ready for the client surface when that access is built.
*@

<Page>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="calendar">
        <SectionHeader Title="Calendar">
            <Actions>
            <button type="button" class="btn-secondary" @onclick="() => MoveMonth(-1)">‹ Prev</button>
            <span class="text-content-subtle w-32 text-center text-sm">@MonthLabel</span>
            <button type="button" class="btn-secondary" @onclick="() => MoveMonth(1)">Next ›</button>
            <button type="button" class="btn-secondary" @onclick="GoToday">Today</button>
            <button type="button" class="btn-primary ml-2"
                    @onclick="OpenAdd">
                Add event
            </button>
            </Actions>
        </SectionHeader>

        @if (actionError is { } error)
        {
            <Notice Tone="Tone.Negative" Class="mb-4">@error</Notice>
        }

        @* The month grid and the Upcoming agenda are two readings of the same events, so they
           share one gate — filling one of them before the other would just look like a fault. *@
        <LoadGate IsLoading="@(!Calendar.LoadedFor(ProjectId) && !dataFailed)" Prominent="true" Label="Loading calendar">
        @if (dataFailed && !Calendar.LoadedFor(ProjectId))
        {
            <p class="text-sm text-content-muted">The calendar couldn't be loaded just now — the error toast has the detail. Reload the page to retry.</p>
        }
        else
        {
            var eventsByDay = EventsByDay;
            var upcoming = Upcoming;
            <div class="panel overflow-hidden mb-6">
                <div class="grid grid-cols-7 border-b border-line">
                    @foreach (var dayName in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                    {
                        <div class="px-2 py-2 eyebrow text-center">@dayName</div>
                    }
                </div>
                @foreach (var week in CalendarMaths.Weeks(year, month))
                {
                    <div class="grid grid-cols-7 border-b border-line last:border-0">
                        @foreach (var day in week)
                        {
                            var inMonth = day.Month == month;
                            var isToday = day == Today;
                            var dayEvents = eventsByDay.TryGetValue(day, out var list) ? list : NoEvents;
                            var showAll = expandedDay == day;
                            var visible = showAll ? dayEvents : dayEvents.Take(3).ToList();
                            <div class="min-h-[6.5rem] border-r border-line last:border-0 px-1.5 py-1.5 @(inMonth ?"" : "bg-surface-raised/40")">
                                <div class="flex justify-end mb-1">
                                    <span class="text-xs w-6 h-6 inline-flex items-center justify-center rounded-full
                                                 @(isToday ?"bg-accent text-accent-ink font-semibold" : inMonth ? "text-content-muted" : "text-content-subtle/60")">
                                        @day.Day
                                    </span>
                                </div>
                                <div class="space-y-1">
                                    @foreach (var item in visible)
                                    {
                                        <button type="button" @key="@($"{day:yyyyMMdd}-{item.CalendarEventId}")"
                                                class="w-full flex items-center gap-1.5 rounded px-1.5 py-0.5 text-left text-xs hover:bg-surface-raised transition"
                                                title="@ChipTitle(item)"
                                                @onclick="() => OpenEdit(item)">
                                            <span class="w-2 h-2 rounded-full shrink-0 @KindDot(item.Kind)"></span>
                                            @if (item.StartTime is { } time)
                                            {
                                                <span class="text-content-subtle shrink-0">@time</span>
                                            }
                                            <span class="text-content truncate">@item.Title</span>
                                            @if (item.ClientVisible)
                                            {
                                                <Pill Tone="Tone.Info" Class="shrink-0">Client</Pill>
                                            }
                                        </button>
                                    }
                                    @if (!showAll && dayEvents.Count > 3)
                                    {
                                        <button type="button" class="w-full text-left text-xs text-content-subtle hover:text-content px-1.5"
                                                @onclick="() => expandedDay = day">
                                            +@(dayEvents.Count - 3) more
                                        </button>
                                    }
                                    else if (showAll && dayEvents.Count > 3)
                                    {
                                        <button type="button" class="w-full text-left text-xs text-content-subtle hover:text-content px-1.5"
                                                @onclick="() => expandedDay = null">
                                            Show fewer
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <section>
                <h3 class="text-sm font-medium text-content-muted mb-3">Upcoming</h3>
                @if (upcoming.Count == 0)
                {
                    <p class="text-sm text-content-subtle italic">Nothing on the calendar from today onwards. Add an event here, or raise one from an email in the Control Centre.</p>
                }
                else
                {
                    <div class="panel overflow-hidden">
                        @foreach (var group in upcoming.GroupBy(e => AgendaDay(e)))
                        {
                            <div class="border-b border-line last:border-0 px-4 py-3">
                                <p class="eyebrow mb-1.5">
                                    @group.Key.ToDateTime(TimeOnly.MinValue).ToString("ddd dd MMM")@(group.Key == Today ? " · Today" : "")
                                </p>
                                <div class="space-y-1">
                                    @foreach (var item in group)
                                    {
                                        <button type="button" class="w-full flex items-center gap-3 rounded px-1.5 py-1 text-left text-sm hover:bg-surface-raised transition"
                                                @onclick="() => OpenEdit(item)">
                                            <span class="w-2 h-2 rounded-full shrink-0 @KindDot(item.Kind)"></span>
                                            <span class="text-content-subtle w-12 shrink-0">@(item.StartTime ?? "—")</span>
                                            <span class="text-content truncate">@item.Title</span>
                                            <span class="text-content-subtle text-xs shrink-0">@CalendarEventKinds.Label(item.Kind)</span>
                                            @if (item.IsMultiDay)
                                            {
                                                <span class="text-content-subtle text-xs shrink-0">
                                                    to @item.LastDate.ToString("d MMM")
                                                </span>
                                            }
                                            @if (item.ClientVisible)
                                            {
                                                <Pill Tone="Tone.Info" Class="shrink-0">Client</Pill>
                                            }
                                            <span class="ml-auto font-mono text-xs text-content-subtle shrink-0">@item.Reference</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }
        </LoadGate>
    </ProjectPageShell>
</Page>

<Modal IsOpen="@editOpen" Title="@(editingId is null ? "Add a calendar event" : $"Calendar event {editingReference}")"
       OnCancel="CloseEdit" DismissOnOverlayClick="false">
    <ChildContent>
        <div class="space-y-3">
            @if (modalError is { } problem)
            {
                <Notice Tone="Tone.Negative">@problem</Notice>
            }
            <FormField Label="Title" Value="@fTitle" OnChange="v => fTitle = v" Required="true" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <FormField Label="Kind">
                    <select class="field" value="@((int)fKind)" @onchange="OnKindChanged">
                        @foreach (var kind in CalendarEventKinds.All)
                        {
                            <option value="@((int)kind)">@CalendarEventKinds.Label(kind)</option>
                        }
                    </select>
                    </FormField>
                </div>
                <FormField Label="Start time" Value="@fStartTime" OnChange="v => fStartTime = v" InputType="time" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <FormField Label="Date" Value="@fDate" OnChange="v => fDate = v" InputType="date" Required="true" />
                <FormField Label="End date (multi-day)" Value="@fEndDate" OnChange="v => fEndDate = v" InputType="date" />
            </div>
            <div>
                <FormField Label="Notes">
                <textarea class="field" rows="3" maxlength="4096" placeholder="Detail and who's attending"
                          value="@fNotes" @oninput="e => fNotes = e.Value?.ToString() ?? string.Empty"></textarea>
                </FormField>
            </div>
            <label class="flex items-center gap-2 text-sm text-content cursor-pointer">
                <input type="checkbox" checked="@fClientVisible" @onchange="e => fClientVisible = e.Value is true" />
                Visible to client
                <span class="text-content-subtle text-xs">— safe to show when the client's view is built</span>
            </label>

            @if (editingId is not null)
            {
                <div class="pt-2 border-t border-line">
                    <p class="eyebrow mb-2">Linked mail</p>
                    @if (linkedEmails is null)
                    {
                        <p class="text-sm text-content-subtle italic">Loading emails…</p>
                    }
                    else if (linkedEmails.Count == 0)
                    {
                        <p class="text-sm text-content-subtle italic">
                            No emails filed to @editingReference yet — file one from the Control Centre (System Tags → @editingReference).
                        </p>
                    }
                    else
                    {
                        <div class="space-y-1.5">
                            @foreach (var email in linkedEmails)
                            {
                                <div class="flex items-baseline gap-3 text-sm">
                                    <span class="text-content-subtle whitespace-nowrap shrink-0">@DateText(email.ReceivedAt)</span>
                                    <span class="text-content truncate" title="@email.BodyPreview">@email.Subject</span>
                                    <span class="text-content-subtle truncate shrink-0">@(string.IsNullOrWhiteSpace(email.FromName) ? email.FromEmail : email.FromName)</span>
                                    @if (email.HasAttachments)
                                    {
                                        <span class="text-content-subtle shrink-0" title="Has attachments">📎</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        @if (editingId is not null)
        {
            <button type="button" class="text-sm font-medium text-negative hover:underline underline-offset-4 mr-auto disabled:opacity-50"
                    disabled="@busy" @onclick="DeleteAsync">
                @(confirmingDelete ? "Really delete?" : "Delete")
            </button>
        }
        <button type="button" class="btn-neutral" disabled="@busy" @onclick="CloseEdit">Cancel</button>
        <button type="button" class="btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(fTitle) || string.IsNullOrWhiteSpace(fDate))"
                @onclick="SaveAsync">
            @(editingId is null ? "Add event" : "Save changes")
        </button>
    </FooterContent>
</Modal>

