@page "/admin/system"
@inject AuthService Auth
@inject SessionService Session
@inject ISystemStore Store
@inject ICompanyTenderTermsStore TenderTerms
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>System · JPMS</PageTitle>

@*
    Admin → System: the announced app version — the version every signed-in tab is being asked to
    run. Publishing bumps the AppVersions row on the API; every open tab then sees a number higher
    than the one it loaded under (response header on its next fetch, /api/version on regaining
    focus) and the UpdateToast offers the refresh. One click, one increment: after a deploy has
    finished, publish here so nobody keeps working on the old build.
*@

<Page>
    @if (Session.ActiveRole != Role.Admin)
    {
        <div class="panel p-6">
            <p class="text-sm text-content-muted">
                This area is for administrators. If you hold the Administrator role, switch to it to manage the system.
            </p>
        </div>
    }
    else
    {
        <WorkspaceSectionNav />
        <PageHeader>
            <SubtitleContent>
                The version every signed-in tab is asked to run. Publishing an update raises the
                refresh bar on every open tab — use it once a deploy has finished, so nobody keeps
                working on the old build.
            </SubtitleContent>
        </PageHeader>

        @if (dataFailed && !Store.IsLoaded)
        {
            <div class="panel p-5 max-w-2xl">
                <p class="text-sm text-negative">
                    The announced version couldn't be loaded. The error banner above has the detail — fix or retry, then reload this page.
                </p>
            </div>
        }
        else
        {
            <div class="max-w-2xl">
                @* The announced version and the stored terms document are both fetched by the page
                   opening, so they wait behind one mark instead of pulsing at each other down the
                   column. *@
                <LoadGate IsLoading="@(LoadState.UntilAll(Store.IsLoaded, termsStatus is not null || termsFailed))"
                          Prominent="true" Label="Loading system settings">
                    <Panel Title="Announced version">
                        @if (Store.Current is { } announced)
                        {
                            <div class="flex items-baseline gap-3">
                                <p class="text-3xl font-semibold text-content font-mono leading-none">v@(announced.Version)</p>
                                <p class="text-xs text-content-subtle">what every tab is currently asked to run</p>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(announced.PublishedBy))
                            {
                                <p class="text-xs text-content-subtle mt-2">
                                    Published @DateTimeText(announced.PublishedAt.ToLocalTime()) by @announced.PublishedBy
                                </p>
                            }

                            <div class="border-t border-line mt-5 pt-5">
                                @if (publishedMessage is not null)
                                {
                                    <p class="text-sm text-content mb-4">@publishedMessage</p>
                                }

                                @if (!confirming)
                                {
                                    <button type="button" class="btn-primary" @onclick="() => { confirming = true; publishedMessage = null; }">
                                        Publish update
                                    </button>
                                    <p class="text-xs text-content-subtle mt-2">
                                        Announces v@(announced.Version + 1) and asks every open tab to refresh.
                                    </p>
                                }
                                else
                                {
                                    <p class="text-sm text-content mb-3">
                                        Publish <span class="font-mono font-semibold">v@(announced.Version + 1)</span>?
                                        Everyone signed in — on every open tab — will see the refresh bar until they switch over.
                                    </p>
                                    <div class="flex items-center gap-2">
                                        <button type="button" class="btn-primary" disabled="@publishing" @onclick="PublishAsync">
                                            @(publishing ? "Publishing…" : "Publish now")
                                        </button>
                                        <button type="button" class="btn-neutral" disabled="@publishing" @onclick="() => confirming = false">
                                            Cancel
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </Panel>

                    @* ---- The company's standard tender Terms & Conditions: ONE PDF, attached
                         automatically to every tender-invite email on every project. ---- *@
                    <div class="mt-6">
                        <Panel Title="Tender terms &amp; conditions">
                            @if (termsFailed)
                            {
                                <p class="text-sm text-negative">The stored document couldn't be checked — the error banner above has the detail.</p>
                            }
                            else if (termsStatus is { } terms)
                            {
                                @if (terms.Exists)
                                {
                                    <p class="text-sm text-content">
                                        <a class="text-accent hover:underline font-medium" href="@TenderTerms.FileUrl" download>@terms.FileName</a>
                                        <span class="text-content-subtle"> · @FormatTermsSize(terms.FileSizeBytes)@(terms.UploadedAt is { } at ? $" · uploaded {at.LocalDateTime:d MMM yyyy, HH:mm}" : "")</span>
                                    </p>
                                    <p class="text-xs text-content-subtle mt-1">
                                        Attached automatically to every tender-invite email, on every project, alongside the pricing schedule.
                                        Uploading a replacement changes what every invite sends from that moment on.
                                    </p>
                                }
                                else if (!terms.Configured)
                                {
                                    <p class="text-sm text-content-muted">
                                        No file storage is configured on the API, so a terms document can't be kept.
                                        Set <span class="font-mono text-xs">CompanyDocumentsStorage:ConnectionString</span> (or rely on the drawings storage account) and reload.
                                    </p>
                                }
                                else
                                {
                                    <p class="text-sm text-content-muted">
                                        Nothing uploaded yet — tender invites currently go out without a terms document.
                                    </p>
                                }

                                @if (terms.Configured)
                                {
                                    <div class="border-t border-line mt-4 pt-4">
                                        @if (termsNote is not null)
                                        {
                                            <p class="text-sm text-content mb-3">@termsNote</p>
                                        }
                                        <label class="btn-secondary inline-flex items-center gap-2 cursor-pointer @(termsUploading ?"opacity-60 pointer-events-none" : "")">
                                            @(termsUploading ? "Uploading…" : terms.Exists ? "Replace the document" : "Upload the document")
                                            <InputFile OnChange="OnTermsFileSelected" accept=".pdf,application/pdf" class="hidden" disabled="@termsUploading" />
                                        </label>
                                        <p class="text-xs text-content-subtle mt-2">PDF only, up to 10&nbsp;MB. Directors and administrators can replace it.</p>
                                    </div>
                                }
                            }
                        </Panel>
                    </div>
                </LoadGate>
            </div>
        }
    }
</Page>

@code {
    private bool dataFailed;
    private bool fetchStarted;
    private bool confirming;
    private bool publishing;
    private string? publishedMessage;

    // ---- Tender terms & conditions ----
    private CompanyTenderTermsStatus? termsStatus;
    private bool termsFailed;
    private bool termsUploading;
    private string? termsNote;

    private static string FormatTermsSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024d * 1024d):0.#} MB",
        >= 1024 => $"{bytes / 1024d:0.#} KB",
        _ => $"{bytes} B"
    };

    private async Task LoadTermsAsync()
    {
        try { termsStatus = await TenderTerms.GetStatusAsync(CancellationToken.None); }
        catch { termsFailed = true; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnTermsFileSelected(InputFileChangeEventArgs e)
    {
        if (termsUploading || e.File is null) return;
        termsNote = null;
        try
        {
            termsUploading = true;
            termsStatus = await TenderTerms.UploadAsync(e.File, CancellationToken.None);
            termsNote = $"{termsStatus.FileName} uploaded — every tender invite drafted from now on attaches it.";
        }
        catch (Exception ex)
        {
            termsNote = $"The upload didn't land: {ex.Message}";
        }
        finally
        {
            termsUploading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        Session.OnChange += OnSessionChanged;
        Store.OnChange += StateHasChanged;

        if (Session.ActiveRole == Role.Admin)
        {
            _ = LoadTermsAsync();
            // Stale-while-revalidate: an already-loaded version paints immediately and refreshes
            // behind itself; a cold one is awaited so the panel's gate opens onto real data.
            if (!Store.IsLoaded)
            {
                fetchStarted = true;
                try { await Store.RefreshAsync(CancellationToken.None); }
                catch { dataFailed = true; }
            }
            else
            {
                _ = RevalidateAsync();
            }
        }
    }

    private void OnSessionChanged()
    {
        // Switching to the Administrator role happens in place (no navigation), so the fetch the
        // admin branch gates on may never have started — start it now or the gate pulses forever.
        if (Session.ActiveRole == Role.Admin && !Store.IsLoaded && !fetchStarted)
        {
            fetchStarted = true;
            _ = FetchAfterRoleSwitchAsync();
        }
        if (Session.ActiveRole == Role.Admin && termsStatus is null && !termsFailed)
        {
            _ = LoadTermsAsync();
        }
        StateHasChanged();
    }

    private async Task FetchAfterRoleSwitchAsync()
    {
        try { await Store.RefreshAsync(CancellationToken.None); }
        catch { dataFailed = true; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task RevalidateAsync()
    {
        try { await Store.RefreshAsync(CancellationToken.None); }
        catch { /* background revalidation — the toast already reported it and the stale figure stands */ }
    }

    private async Task PublishAsync()
    {
        publishing = true;
        try
        {
            await Store.PublishAsync(CancellationToken.None);
            confirming = false;
            publishedMessage = $"v{Store.Current!.Version} published — every open tab is now being offered the refresh. " +
                               "The bar will appear at the top of this tab too: that's it working.";
        }
        catch
        {
            // The error toast already carries the reference and the detail; the button simply
            // re-enables so the publish can be retried.
        }
        finally
        {
            publishing = false;
        }
    }

    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged;
        Store.OnChange -= StateHasChanged;
    }
}
