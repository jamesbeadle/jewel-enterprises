@page "/projects/{ProjectId}/defects"
@using Jewel.JPMS.Contracts.Closeout
@using Jewel.JPMS.Features.Closeout
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject DefectsReadModel Defects
@inject ISubcontractorStore Directory
@inject ICommandSender Commands
@implements IDisposable

<PageTitle>Defects · JPMS</PageTitle>

@*
    The project's defect register. A defect is raised here directly or from a subcontractor email
    in the Control Centre (System Tags → Subcontractor → Create new → Defect); either way it
    carries a sequential DEF-#### reference, which is also its mailbox tag stem. It is raised WITH
    a supplier — a directory record, the way a work order names its supplier — and each row opens
    the defect's own page (2026-09-07), where it is sent to that supplier, its correspondence is
    read and answered, and the to-dos about it live. Status walks Open → In progress → Resolved →
    Verified (UpdateDefect stamps ResolvedAt; sending to the supplier moves Open → In progress).
*@

<Page>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="defects">
        <SectionHeader Title="Defects">
            <Actions>
            <button type="button" class="btn-primary"
                    @onclick="() => raiseOpen = !raiseOpen">
                @(raiseOpen ? "Close" : "Raise defect")
            </button>
            </Actions>
        </SectionHeader>

        @if (actionError is { } error)
        {
            <Notice Tone="Tone.Negative" Class="mb-4">@error</Notice>
        }

        @if (raiseOpen)
        {
            <section class="panel p-5 mb-5">
                <h3 class="text-sm font-medium text-content-muted mb-3">Raise a defect</h3>
                <div class="space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <FormField Label="Location">
                            <input type="text" class="field" maxlength="256" placeholder="Room, area or feature"
                                   value="@newLocation" @oninput="e => newLocation = e.Value?.ToString() ?? string.Empty" />
                            </FormField>
                        </div>
                        <div>
                            <FormField Label="Supplier" Hint="The company the defect is raised with, from the directory — its contact email is where the defect is sent from the defect's page.">
                            <SearchSelect Options="@SupplierOptions" Value="@newSubcontractorId"
                                          ValueChanged="v => newSubcontractorId = v"
                                          Placeholder="@(Directory.IsLoaded ? "Pick a supplier…" : "Loading the directory…")"
                                          Disabled="@(!Directory.IsLoaded)"
                                          WidthClass="w-full" InputClass="field" />
                            </FormField>
                        </div>
                    </div>
                    @if (string.IsNullOrWhiteSpace(newSubcontractorId))
                    {
                        <div>
                            <FormField Label="Contact email (if not in the directory)" Hint="A stop-gap for a supplier not yet on the directory — add them there to pick them properly.">
                            <input type="email" class="field" maxlength="256" placeholder="someone@supplier.co.uk"
                                   value="@newAssignedTo" @oninput="e => newAssignedTo = e.Value?.ToString() ?? string.Empty" />
                            </FormField>
                        </div>
                    }
                    <div>
                        <FormField Label="Description" Required>
                        <textarea class="field" rows="3" maxlength="1024" placeholder="What's wrong and what putting it right needs"
                                  value="@newDescription" @oninput="e => newDescription = e.Value?.ToString() ?? string.Empty"></textarea>
                        </FormField>
                    </div>
                    <div class="flex items-center gap-3">
                        <button type="button" class="btn-primary"
                                disabled="@(string.IsNullOrWhiteSpace(newDescription) || busy)"
                                @onclick="RaiseAsync">
                            Raise defect
                        </button>
                        <p class="text-xs text-content-subtle">Raising doesn't email anyone — send it to the supplier from the defect's page, which opens next.</p>
                    </div>
                </div>
            </section>
        }

        @if (!Defects.LoadedFor(ProjectId) && !dataFailed)
        {
            <LoadGate IsLoading="true" Prominent="true" Label="Loading defects" />
        }
        else if (dataFailed && !Defects.LoadedFor(ProjectId))
        {
            <p class="text-sm text-content-muted">The defects couldn't be loaded just now — the error toast has the detail. Reload the page to retry.</p>
        }
        else if (Rows.Count == 0)
        {
            <EmptyState Message="No defects on this project. Raise one here, or file a subcontractor email to a new defect from the Control Centre." />
        }
        else
        {
            <RecordsTable Dense="true" MaxHeight="">
                <thead>
                    <tr>
                        <th>Ref</th>
                        <th>Location</th>
                        <th>Description</th>
                        <th>Supplier</th>
                        <th>Sent</th>
                        <th>Raised</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var defect in Rows)
                    {
                        var href = $"/projects/{ProjectId}/defects/{defect.DefectId}";
                        <tr @key="defect.DefectId" class="border-b border-line last:border-0 align-top">
                            <td class="font-mono text-xs whitespace-nowrap">
                                <a href="@href" class="text-accent hover:underline underline-offset-2" title="Open the defect's page">@defect.Reference</a>
                            </td>
                            <td class="text-content">@defect.Location</td>
                            <td class="max-w-md">
                                <a href="@href" class="hover:underline underline-offset-2" title="@defect.Description">@defect.Description</a>
                            </td>
                            <td class="max-w-xs">
                                @if (string.IsNullOrWhiteSpace(defect.SupplierLabel))
                                {
                                    <span class="text-content-subtle italic">Not assigned</span>
                                }
                                else
                                {
                                    <span title="@defect.SupplierEmail">@defect.SupplierLabel</span>
                                }
                            </td>
                            <td class="whitespace-nowrap">
                                @if (defect.SentToSupplierAt is { } sentAt)
                                {
                                    <span title="@SentTitle(defect)">@DateText(sentAt)</span>
                                }
                                else
                                {
                                    <span class="text-content-subtle italic">Not sent</span>
                                }
                            </td>
                            <td class="whitespace-nowrap" title="@DateTimeText(defect.RaisedAt.ToLocalTime())">
                                @DateText(defect.RaisedAt)
                            </td>
                            <td class="whitespace-nowrap">
                                <select class="field py-1" value="@((int)defect.Status)" disabled="@busy"
                                        @onchange="e => SetStatusAsync(defect, e)">
                                    @foreach (var status in Enum.GetValues<DefectStatus>())
                                    {
                                        <option value="@((int)status)">@status.DisplayName()</option>
                                    }
                                </select>
                            </td>
                            <td class="whitespace-nowrap text-right">
                                <a href="@href" class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </RecordsTable>
        }
    </ProjectPageShell>
</Page>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    private bool sessionReady;
    private bool dataFailed;
    private bool busy;
    private string? actionError;

    private bool raiseOpen;
    private string newLocation = "";
    private string newDescription = "";
    private string newAssignedTo = "";
    private string newSubcontractorId = "";

    private IReadOnlyList<Defect> Rows =>
        Defects.Current(ProjectId).OrderByDescending(d => d.Reference, StringComparer.Ordinal).ToList();

    // The directory pool, read lazily by the store (All() kicks the fetch; OnChange re-renders).
    private IReadOnlyList<SearchSelect.Option> SupplierOptions => DefectSuppliers.Options(Directory.All());

    private static string SentTitle(Defect defect) =>
        $"Sent {DateTimeText(defect.SentToSupplierAt!.Value.ToLocalTime())}"
        + (string.IsNullOrWhiteSpace(defect.SentToSupplierByEmail) ? "" : $" by {defect.SentToSupplierByEmail}");

    protected override async Task OnInitializedAsync()
    {
        Defects.OnChanged += StateHasChanged;
        Directory.OnChange += StateHasChanged;
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        sessionReady = true;
        await LoadAsync();
    }

    private string loadedForProjectId = "";

    protected override async Task OnParametersSetAsync()
    {
        // Project switch via the shell's arrows: same page, new key — load the new register
        // (and give a previously failed project a fresh chance).
        if (!sessionReady || loadedForProjectId == ProjectId) return;
        dataFailed = false;
        raiseOpen = false;
        actionError = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loadedForProjectId = ProjectId;
        try { await Defects.RefreshAsync(ProjectId, CancellationToken.None); }
        catch { dataFailed = true; } // the query client has already toasted the detail
    }

    private async Task RaiseAsync()
    {
        if (string.IsNullOrWhiteSpace(newDescription)) return;
        busy = true;
        actionError = null;
        try
        {
            var raised = await Commands.SendAsync(new RaiseDefect(
                ProjectId, newDescription.Trim(), newLocation.Trim(), newAssignedTo.Trim(),
                SubcontractorId: string.IsNullOrWhiteSpace(newSubcontractorId) ? null : newSubcontractorId), CancellationToken.None);
            newLocation = ""; newDescription = ""; newAssignedTo = ""; newSubcontractorId = "";
            raiseOpen = false;
            await RefreshAfterWriteAsync();
            // The new defect's page is where the next step (sending it to the supplier) lives.
            Nav.NavigateTo($"/projects/{ProjectId}/defects/{raised.DefectId}");
        }
        catch (CommandFailedException ex) { actionError = ex.Message; }
        finally { busy = false; }
    }

    private async Task SetStatusAsync(Defect defect, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var statusValue)) return;
        var status = (DefectStatus)statusValue;
        if (status == defect.Status) return;
        busy = true;
        actionError = null;
        try
        {
            await Commands.SendAsync(new UpdateDefect(
                defect.DefectId, defect.Description, defect.Location, defect.AssignedToEmail, status,
                SubcontractorId: defect.SubcontractorId), CancellationToken.None);
            await RefreshAfterWriteAsync();
        }
        catch (CommandFailedException ex) { actionError = ex.Message; }
        finally { busy = false; }
    }

    // Post-write reload: swallow query failures (the toast already reported them) so a 502 on the
    // refetch can't take the page down after a successful write — see post-write-reload rule.
    private async Task RefreshAfterWriteAsync()
    {
        try { await Defects.RefreshAsync(ProjectId, CancellationToken.None); }
        catch (OperationCanceledException) { throw; }
        catch { }
    }

    public void Dispose()
    {
        Defects.OnChanged -= StateHasChanged;
        Directory.OnChange -= StateHasChanged;
    }
}
