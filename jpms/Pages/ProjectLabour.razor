@page "/projects/{ProjectId}/labour"
@using Jewel.JPMS.Features.CostCenters
@using Jewel.JPMS.Features.Labour
@inject AuthService Auth
@inject SessionService Session
@inject ILabourStore Labour
@inject CostCentersReadModel CostCenters
@inject NavigationManager Nav
@inject IQueryClient Queries
@inject IJSRuntime JS
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel Projects
@implements IDisposable

<PageTitle>Labour · JPMS</PageTitle>

@*
    The Labour tab (docs/Labour-Time-Tracking-Scope.md, redesigned per
    docs/Labour-Overview-Forecast-and-Xero-Mapping-Scope.md §4a): weekly timesheet approval grid,
    the daily site register, worker assignment and the subcontractor settlement view — every block
    a Panel, statuses as pills, manual entry as the Add a day dialog (which is also the chat's
    manual_timesheet proposal card). Only approved time becomes cost — the grid is where submitted
    hours get adjusted, re-coded, approved (budget hard-block enforced server-side) or rejected
    back to the worker.
*@

<Page>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="labour">

        @if (actionError is not null)
        {
            <Notice Tone="Tone.Negative" Class="mb-3">@actionError</Notice>
        }
        @if (approvalFailures.Count > 0)
        {
            <ApprovalFailuresBanner Failures="approvalFailures" CanOverrideBudget="CanOverrideBudget"
                                    OnApproveOverBudget="OpenOverBudget" />
        }

        <SectionHeader Title="Labour">
            <Actions>
            <div class="flex items-center gap-2 text-sm">
                <button type="button" class="btn-secondary" @onclick="() => MoveWeek(-7)">‹ Prev</button>
                <span class="text-content-subtle">w/c @DateText(weekStart)</span>
                <button type="button" class="btn-secondary" @onclick="() => MoveWeek(7)">Next ›</button>
            </div>
            <Toolbar>
                <ExportToExcelButton FileName="Labour"
                                     ShowIncludeAllRows="true"
                                     Disabled="@(!HasExportableLabourData())"
                                     BuildWorkbook="BuildExportWorkbook" />
            </Toolbar>
            <button type="button" class="btn-primary" @onclick="OpenAddDay">Add a day</button>
            </Actions>
        </SectionHeader>

        @* All four panels below fill from the one Task.WhenAll the page runs on entry — the
           week's timesheets, the assignments, the site register and the settlement figures land
           together — so they are one wait, not four jewels down the same screen. Each keeps its
           own IsLoading for the refreshes it can do on its own once the tab is up. *@
        <LoadGate IsLoading="@(LoadState.UntilAll(TimesheetsReady, AssignmentsReady, RegisterReady, SettlementReady) && !dataFailed)"
                  Prominent="true" Label="Loading labour">

        @* ---- The week's timesheets: one panel, statuses as pills, approval at its foot. ---- *@
        <Panel Title="Timesheets" Class="mb-6" BodyClass="p-0"
               IsLoading="@(!TimesheetsReady && !dataFailed)" LoadingLabel="Loading timesheets">
            @{ var weekAll = WeekTimesheets(); var week = FilteredWeek(weekAll); }
            @if (dataFailed)
            {
                <p class="p-5 text-sm text-negative">Couldn't load the timesheets. The details are in the red bar at the top — reload to try again.</p>
            }
            else if (weekAll.Count == 0)
            {
                <p class="p-5 text-sm text-content-subtle italic">No timesheets this week. Workers log time from their My day page; their submitted hours appear here for approval.</p>
            }
            else
            {
                @* Person-by-person approval: filter to one worker, select all, code, approve. *@
                <div class="flex flex-wrap items-center gap-2 px-5 py-3 border-b border-line/60">
                    <FormField Label="Worker" Id="labour-worker-filter">
                    <select id="labour-worker-filter" class="field" value="@workerFilter" @onchange="@(args => SetWorkerFilter((string?)args.Value))">
                        <option value="">All workers</option>
                        @foreach (var name in WeekWorkerNames(weekAll))
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                    </FormField>
                    @if (workerFilter != "")
                    {
                        <span class="text-xs text-content-subtle">Showing only @(workerFilter)'s days — select-all selects just these.</span>
                    }
                </div>
                @if (week.Count == 0)
                {
                    <p class="p-5 text-sm text-content-subtle italic">No timesheets for @workerFilter this week.</p>
                }
                else
                {
                <div class="overflow-x-auto">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th><input type="checkbox" checked="@AllSubmittedSelected(week)" @onchange="@(args => ToggleAll(week, (bool)args.Value!))" /></th>
                                <th>Worker</th>
                                <th>Day</th>
                                <th>Cost code</th>
                                <th class="text-right">Hours</th>
                                <th class="text-right">£</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var timesheet in week)
                            {
                                <TimesheetRow Timesheet="timesheet"
                                              Selected="@selectedIds.Contains(timesheet.TimesheetId)"
                                              OnSelectedChanged="selected => ToggleSelected(timesheet.TimesheetId, selected)"
                                              IsEditing="@(editingId == timesheet.TimesheetId)"
                                              CostCodeOptions="@CostCodeOptions"
                                              @bind-EditCostCode="editCostCode" @bind-EditHours="editHours"
                                              OnSave="SaveEditAsync" OnCancelEdit="() => editingId = null"
                                              OnAdjust="() => StartEdit(timesheet)" OnReject="() => StartReject(timesheet)"
                                              CanCorrect="CanCorrect"
                                              OnUnapprove="() => StartUnapprove(timesheet)" OnMove="() => StartMove(timesheet)" />
                            }
                        </tbody>
                    </table>
                </div>
                <TimesheetApprovalFooter SelectedCount="selectedIds.Count" CostCodeOptions="@CostCodeOptions"
                                         @bind-BulkCostCode="bulkCostCode" IsCoding="isBulkCoding" IsApproving="isApproving"
                                         OnCode="CodeSelectedAsync" OnApprove="ApproveSelectedAsync" />
                }
            }
        </Panel>

        <div class="grid lg:grid-cols-2 gap-6 mb-6">
            @* ---- Workers on this project: assignment + how they log time, one panel. ---- *@
            <Panel Title="Workers on this project" BodyClass="p-5"
                   IsLoading="@(!AssignmentsReady && !dataFailed)" LoadingLabel="Loading workers">
                @if (dataFailed)
                {
                    <p class="text-sm text-negative">Couldn't load the worker registry — reload to try again.</p>
                }
                else
                {
                    <div class="flex flex-wrap items-end gap-2">
                        <select class="field" @bind="assignWorkerId">
                            <option value="">Add worker to project…</option>
                            @foreach (var worker in UnassignedWorkers())
                            {
                                <option value="@worker.WorkerId">@worker.Name</option>
                            }
                        </select>
                        <button type="button" class="btn-secondary" @onclick="AssignWorkerAsync">Assign</button>
                    </div>
                    @if (Labour.AssignmentsFor(ProjectId).Any(assignment => assignment.IsActive))
                    {
                        <ul class="mt-3 space-y-1 text-sm">
                            @foreach (var assignment in Labour.AssignmentsFor(ProjectId).Where(assignment => assignment.IsActive))
                            {
                                <li class="flex items-center justify-between max-w-xs">
                                    <span class="text-content">@assignment.WorkerName</span>
                                    <button type="button" class="btn-ghost text-negative" @onclick="() => UnassignAsync(assignment.WorkerId)">Remove</button>
                                </li>
                            }
                        </ul>
                    }
                    <p class="text-xs text-content-subtle mt-4 pt-3 border-t border-line/60">
                        Workers sign in to the portal like any other user and log time on their
                        <span class="text-content">My day</span> page. To set one up: invite them as a
                        user with the <span class="text-content">Site Operative</span> role, add a worker
                        record with the same email on the
                        <a class="underline underline-offset-2" href="/labour/workers">Workers page</a>,
                        then assign them here. Missed a sign-out? Use <span class="text-content">Add a day</span> above.
                    </p>
                }
            </Panel>

            <SiteRegisterPanel Rows="@Labour.AttendanceFor(ProjectId).Take(60).ToList()"
                               Loading="@(!RegisterReady && !dataFailed)" LoadFailed="dataFailed" />
        </div>

        @* ---- Subcontractor settlement ---- *@
        <Panel Title="Subcontractor settlement" Class="mb-8" BodyClass="p-5"
               IsLoading="@(!SettlementReady && !dataFailed)" LoadingLabel="Loading settlement">
            <p class="text-xs text-content-subtle mb-3">
                Approved timesheets are the actual cost; the subbie's invoice settles them — mark
                the invoice lines as covered below. A non-zero unresolved variance stays open until
                timesheets are corrected, the invoice is amended or split, or the difference is
                posted as a settlement variance.
            </p>
            @{ var settlement = Labour.SettlementFor(ProjectId); }
            @if (dataFailed)
            {
                <p class="text-sm text-negative">Couldn't load the settlement figures — reload to try again.</p>
            }
            else if (settlement.Count == 0)
            {
                <p class="text-sm text-content-subtle italic">Nothing to reconcile yet.</p>
            }
            else
            {
                <SettlementSummaryTable Rows="settlement" />
            }

            <div class="mt-4">
                @if (!showCoverPanel)
                {
                    <button type="button" class="btn-secondary" @onclick="LoadLedgerAsync">Mark invoice lines as covered…</button>
                }
                else
                {
                    <h4 class="text-sm font-semibold text-content mb-2">Invoice lines on this project</h4>
                    <p class="text-xs text-content-subtle mb-2">Pick the subcontractor whose timesheets each line settles, then mark it covered — the line leaves cost of sales and joins the reconciliation above.</p>
                    @if (ledgerLines is null)
                    {
                        <LoadGate IsLoading="true" Label="Loading the ledger" />
                    }
                    else if (ProjectLedgerLines().Count == 0)
                    {
                        <EmptyState Message="No allocated invoice lines on this project yet." />
                    }
                    else
                    {
                        <CoverInvoiceLinesTable Lines="ProjectLedgerLines()" Subcontractors="WorkerSubcontractors()"
                                                OnSettlesPicked="pick => coverSubcontractorByLine[pick.LineId] = pick.SubcontractorId"
                                                OnMarkCovered="MarkCoveredAsync" />
                    }
                }
            </div>
        </Panel>
        </LoadGate>
    </ProjectPageShell>

    @* ---- Add a day: manual entry / missed sign-outs. Also the chat's manual_timesheet
           proposal card — the assistant fills it, the user reads and presses Add day. ---- *@
    <Modal IsOpen="@addDayOpen" Title="Add a day"
           ConfirmLabel="@(isAddingManual ? "Adding…" : "Add day")" ConfirmDisabled="@isAddingManual"
           OnCancel="CloseAddDay" OnConfirm="AddManualAsync"
           DismissOnOverlayClick="false">
        <p class="text-xs text-content-subtle mb-3">For workers who forgot to sign out (or verbal reports), enter their day here — it joins the approval queue as normal.</p>
        <div class="space-y-3">
            <FormField Label="Worker">
                <select class="field" @bind="manualWorkerId">
                    <option value="">Worker…</option>
                    @foreach (var assignment in Labour.AssignmentsFor(ProjectId).Where(assignment => assignment.IsActive))
                    {
                        <option value="@assignment.WorkerId">@assignment.WorkerName</option>
                    }
                </select>
            </FormField>
            <FormField Label="Date">
                <input class="field" type="date" @bind="manualDate" />
            </FormField>
            <FormField Label="Cost code">
                <SearchSelect Options="@CostCodeOptions" WidthClass="w-full mt-1" Placeholder="Cost code…"
                              @bind-Value="manualCostCode" />
            </FormField>
            <FormField Label="Hours">
                <input class="field mt-1 w-24" type="number" step="0.5" min="0.5" @bind="manualHours" />
            </FormField>
            @if (manualError is not null)
            {
                <Notice Tone="Tone.Negative">@manualError</Notice>
            }
            <p class="text-xs text-content-subtle">Hours in half-hour steps — 0.5, 1, 1.5 and so on. A whole day is 8.</p>
        </div>
    </Modal>

    @* ---- Rejection: reason first, the worker reads it. ---- *@
    <Modal IsOpen="@(rejectingId is not null)" Title="Reject timesheet"
           ConfirmLabel="Reject timesheet" OnCancel="() => rejectingId = null" OnConfirm="ConfirmRejectAsync">
        <p class="text-sm text-content mb-2">Reason for rejection (the worker sees this):</p>
        <input class="field w-full mb-2" @bind="rejectReason" placeholder="e.g. Hours look double-entered — please re-check Tuesday" />
        @if (rejectError is not null)
        {
            <Notice Tone="Tone.Negative">@rejectError</Notice>
        }
    </Modal>

    @* ---- Unapprove: the MD/FD's reversal of a posted approval (2026-09-07). Reason first —
           it is the audit record; the day goes back to Submitted and its cost is withdrawn. ---- *@
    <Modal IsOpen="@(unapproving is not null)" Title="Reverse approval"
           ConfirmLabel="@(isCorrecting ? "Reversing…" : "Reverse approval")"
           ConfirmDisabled="@(isCorrecting || string.IsNullOrWhiteSpace(correctionReason))"
           OnCancel="CloseCorrection" OnConfirm="ConfirmUnapproveAsync"
           DismissOnOverlayClick="false">
        @if (unapproving is not null)
        {
            <p class="text-sm text-content mb-2">
                <span class="font-medium">@unapproving.WorkerName</span> · @unapproving.WorkedOn.ToString("ddd dd MMM yyyy") ·
                @unapproving.Hours h on @unapproving.CostCode · £@unapproving.CostAmount.ToString("N2") approved
            </p>
            <p class="text-xs text-content-subtle mb-3">
                The day goes back to Submitted and its £@unapproving.CostAmount.ToString("N2") leaves Financials, the
                settlement view and the site P&amp;L now. What it loses — rate, cost, who approved it and when — is
                kept on the audit trail with your name and the reason below. You can then adjust, re-code and
                approve it again, or reject it back to the worker.
            </p>
        }
        <label class="block text-sm text-content-muted mb-2">Reason (required — this is what the audit trail records)
            <input class="field mt-1 w-full" @bind="correctionReason" @bind:event="oninput"
                   placeholder="e.g. Approved with the wrong hours — his timesheet message says 4h, not 8h" />
        </label>
        @if (correctionError is not null)
        {
            <Notice Tone="Tone.Negative">@correctionError</Notice>
        }
    </Modal>

    @* ---- Move: re-home a day on the right project as it stands (2026-09-07). An approved day
           meets the destination's budget hard-block; the tick is the MD/FD's override. ---- *@
    <Modal IsOpen="@(moving is not null)" Title="Move to another project"
           ConfirmLabel="@(isCorrecting ? "Moving…" : moveOverBudget ? "Move over budget" : "Move day")"
           ConfirmDisabled="@(isCorrecting || string.IsNullOrWhiteSpace(correctionReason) || moveToProjectId == "")"
           OnCancel="CloseCorrection" OnConfirm="ConfirmMoveAsync"
           DismissOnOverlayClick="false">
        @if (moving is not null)
        {
            <p class="text-sm text-content mb-2">
                <span class="font-medium">@moving.WorkerName</span> · @moving.WorkedOn.ToString("ddd dd MMM yyyy") ·
                @moving.Hours h on @(moving.CostCode == "" ? "no cost code" : moving.CostCode) · @moving.Status
                @if (moving.Status == TimesheetStatus.Approved) { <text> · £@moving.CostAmount.ToString("N2")</text> }
            </p>
            <p class="text-xs text-content-subtle mb-3">
                The day moves as it stands — date, hours, cost code, status@(moving.Status == TimesheetStatus.Approved ? " and its approval" : "") —
                and appears on the other project's Labour tab for this week. Both projects' audit history record the move.
            </p>
        }
        <div class="space-y-3">
            <FormField Label="Move to">
                <SearchSelect Options="@MoveProjectOptions" WidthClass="w-full mt-1" Placeholder="Project…"
                              @bind-Value="moveToProjectId" />
            </FormField>
            <label class="block text-sm text-content-muted">Reason (required — this is what the audit trail records)
                <input class="field mt-1 w-full" @bind="correctionReason" @bind:event="oninput"
                       placeholder="e.g. Worked Ravenswood on the Monday per his timesheet message, entered on Woodhouse" />
            </label>
            @if (moveBudgetBlock is not null)
            {
                <Notice Tone="Tone.Negative">
                    <p class="mb-2">@moveBudgetBlock</p>
                    <Checkbox @bind-Value="moveOverBudget" Label="Move anyway — over budget, with the reason above on the audit trail" />
                </Notice>
            }
            @if (correctionError is not null)
            {
                <Notice Tone="Tone.Negative">@correctionError</Notice>
            }
        </div>
    </Modal>

    @* ---- Over-budget approval: the MD/FD's deliberate, audited exception to the hard-block. ---- *@
    <Modal IsOpen="@overBudgetOpen" Title="Approve over budget"
           ConfirmLabel="Approve over budget"
           ConfirmDisabled="@(isOverriding || string.IsNullOrWhiteSpace(overBudgetReason))"
           OnCancel="CloseOverBudget" OnConfirm="ConfirmOverBudgetAsync"
           DismissOnOverlayClick="false">
        <p class="text-sm text-content mb-2">
            These timesheets exceed their cost code's remaining budget. Approving them posts the cost
            anyway — the overspend stays red on the project's Financials, and each row is written to
            the audit trail with your name and the reason below.
        </p>
        <Notice Tone="Tone.Negative" Class="mb-3">
            @foreach (var failure in overBudgetFailures)
            {
                <p>· @failure.Reason</p>
            }
        </Notice>
        <label class="block text-sm text-content-muted mb-2">Reason (required — this is what the audit trail records)
            <input class="field mt-1 w-full" @bind="overBudgetReason" @bind:event="oninput"
                   placeholder="e.g. Agreed with Nigel — VO covering these hours is being raised" />
        </label>
        @if (overBudgetError is not null)
        {
            <Notice Tone="Tone.Negative">@overBudgetError</Notice>
        }
    </Modal>
</Page>

