@page "/client/variations/{VariationOrderId}"
@using Jewel.JPMS.Contracts.ClientPortal
@using Jewel.JPMS.Features.ClientPortal
@inject AuthService Auth
@inject SessionService Session
@inject IClientPortalStore ClientPortal
@inject NavigationManager Nav

<PageTitle>@(record?.VariationRef ?? record?.Reference ?? "Variation") · JPMS</PageTitle>

<Page CanAccess="CanAccess" AccessDeniedMessage="This page is for client accounts.">
    <LoadGate IsLoading="@(!loaded)" Prominent="true" Label="Loading variation order">
        @if (record is null)
        {
            <PageHeader Title="Variation order not found" />
            <p class="text-content-muted">This variation order isn't on one of your projects, or it no longer exists.</p>
        }
        else
        {
            <a href="/client" class="text-sm text-accent hover:underline">&larr; Your projects</a>
            <PageHeader>
                <TitleContent>
                    @record.Title
                </TitleContent>
                <EyebrowContent>
                    @(record.VariationRef ?? record.Reference) · Variation order · @record.ProjectName
                </EyebrowContent>
                <SubtitleContent>
                    @record.Status.DisplayName()@(ClientPortalDisplay.ValueLabel(record) is { } value ? $" · {value}" : "")@(record.ApprovedAt is { } approved ? $" · approved {approved.LocalDateTime:d MMM yyyy}" : "")
                </SubtitleContent>
            </PageHeader>

            @if (!string.IsNullOrWhiteSpace(record.Description))
            {
                <Panel Title="Detail" BodyClass="p-5">
                    <p class="text-sm text-content-muted whitespace-pre-wrap leading-relaxed">@record.Description</p>
                </Panel>
            }

            <ClientConversationPanel Load="LoadMessagesAsync" Post="PostMessageAsync" />
        }
    </LoadGate>
</Page>

@code {
    [Parameter] public string VariationOrderId { get; set; } = "";

    private bool loaded;
    private ClientPortalVariationOrder? record;

    private bool CanAccess => Session.AvailableRoles.Contains(Role.Client) && !string.IsNullOrEmpty(Auth.CurrentClientId);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        if (!Session.IsApproved || !CanAccess) return;
        StateHasChanged();
        // A failed fetch opens the gate too — null renders the not-found explanation.
        try { record = await ClientPortal.GetVariationOrderAsync(VariationOrderId); }
        catch { record = null; }
        loaded = true;
    }

    private async Task<IReadOnlyList<ConversationEntry>> LoadMessagesAsync() =>
        (await ClientPortal.ListVariationOrderMessagesAsync(VariationOrderId))
            .Select(message => new ConversationEntry(
                message.MessageId, message.ParentMessageId, message.AuthorEmail, message.AuthorName,
                message.Body, IsInternal: false, message.PostedAt))
            .ToList();
    private async Task<bool> PostMessageAsync(string body, string? parentMessageId)
    {
        try { await ClientPortal.PostVariationOrderMessageAsync(VariationOrderId, body, parentMessageId); return true; }
        catch { return false; }
    }
}
