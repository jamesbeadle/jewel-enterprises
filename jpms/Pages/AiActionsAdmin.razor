@page "/admin/ai-actions"
@inject AuthService Auth
@inject SessionService Session
@inject IQueryClient Queries
@inject ICommandSender Commands

<PageTitle>AI actions · JPMS</PageTitle>

@*
    Skills wired to connector actions (2026-08-31). The actions themselves are code — the
    registry the MCP connector's list_actions/describe_action/perform_action run on — and a
    developer changes them. WHICH doctrine applies to which action is data, curated here: attach a
    skill to one action, or to a whole area, and describe_action inlines its body next to the
    argument schema from the very next call. The model cannot reach perform_action for an
    unfamiliar action without describe_action, so attached doctrine rides in on the road it must
    travel — whatever AI tool is connecting.
*@

<Page CanAccess="CanSee" AccessDeniedMessage="You do not have access to the assistant's actions.">
        <PageHeader>
            <SubtitleContent>
                Every action a connected AI tool can perform, and the
                <a class="underline" href="/admin/skills">skills</a> attached to each. An attached
                skill's doctrine is served with the action's contract, so the model reads it in the
                same breath as the schema — before it performs anything. Attach to a whole
                <span class="text-content">area</span> for discipline-wide doctrine, or to a single
                action for the exceptions. Changes are in force immediately.
            </SubtitleContent>
        </PageHeader>

        <LoadGate IsLoading="@((catalogue is null || skills is null) && !dataFailed)" Prominent="true" Label="Loading actions">
            @if (dataFailed)
            {
                <div class="panel p-5">
                    <p class="text-sm text-content-muted">
                        The action catalogue could not be loaded. The error toast carries the reference.
                    </p>
                </div>
            }
            else
            {
                <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                    <span class="text-xs text-content-subtle">
                        @(catalogue!.Actions.Count) actions · @attachments.Count attachments
                    </span>
                    <input class="field w-72" placeholder="Search actions…"
                           value="@search" @oninput="OnSearchInput" />
                </div>

                @if (OrphanedAttachments.Count > 0)
                {
                    <div class="rounded border border-negative/40 bg-negative/5 px-4 py-3 mb-4">
                        <p class="text-xs font-medium text-content mb-1">
                            Attachments pointing at nothing — the action or area was renamed or removed
                            in code. Detach them, or re-attach the skill under the current name.
                        </p>
                        @foreach (var orphan in OrphanedAttachments)
                        {
                            <div class="flex items-center gap-2 py-0.5">
                                <span class="text-xs text-content-muted">
                                    @orphan.SkillKey → @orphan.TargetKind "@orphan.TargetKey"
                                </span>
                                <button type="button" class="text-xs underline text-content-muted"
                                        @onclick="() => DetachOrphanAsync(orphan)" disabled="@saving">
                                    Detach
                                </button>
                            </div>
                        }
                        @if (editingKind is null)
                        {
                            @foreach (var saveError in saveErrors)
                            {
                                <p class="text-xs leading-snug text-content-muted">@saveError</p>
                            }
                        }
                    </div>
                }

                @foreach (var areaGroup in FilteredAreas)
                {
                    var area = areaGroup.Key;
                    <div class="panel overflow-hidden mb-3">
                        <div class="flex flex-wrap items-center gap-3 px-4 py-3 bg-surface-raised border-b border-line">
                            <button type="button" class="flex items-center gap-2 text-left"
                                    @onclick="() => ToggleArea(area)">
                                <span class="text-content-subtle text-xs w-3">@(IsExpanded(area) ? "▾" : "▸")</span>
                                <span class="text-sm font-semibold text-content">@area</span>
                                <span class="text-xs text-content-subtle">@areaGroup.Count() actions</span>
                            </button>
                            <div class="flex flex-wrap items-center gap-1.5 ml-auto">
                                @foreach (var skillKey in AttachedTo(AiActionSkillTargets.Area, area))
                                {
                                    @SkillChip(skillKey, false)
                                }
                                <button type="button" class="btn-neutral text-xs px-2 py-1"
                                        @onclick="() => StartEditing(AiActionSkillTargets.Area, area)">
                                    Area skills
                                </button>
                            </div>
                        </div>

                        @if (IsEditing(AiActionSkillTargets.Area, area))
                        {
                            @SkillPicker($"every action in {area}")
                        }

                        @if (IsExpanded(area))
                        {
                            <div class="divide-y divide-line">
                                @foreach (var action in areaGroup)
                                {
                                    <div class="px-4 py-2.5">
                                        <div class="flex flex-wrap items-start gap-3">
                                            <div class="min-w-0 flex-1">
                                                <span class="block font-mono text-xs text-content">
                                                    @action.Name
                                                    @if (action.RequiresConfirmation)
                                                    {
                                                        <span class="text-content-subtle" title="Confirm-first: the first call is refused until the user says yes.">· confirm-first</span>
                                                    }
                                                </span>
                                                <span class="block text-xs text-content-subtle max-w-3xl">@action.Summary</span>
                                            </div>
                                            <div class="flex flex-wrap items-center gap-1.5">
                                                @foreach (var skillKey in AttachedTo(AiActionSkillTargets.Action, action.Name))
                                                {
                                                    @SkillChip(skillKey, false)
                                                }
                                                @foreach (var skillKey in AttachedTo(AiActionSkillTargets.Area, action.Area))
                                                {
                                                    @SkillChip(skillKey, true)
                                                }
                                                <button type="button" class="text-xs underline text-content-muted"
                                                        @onclick="() => StartEditing(AiActionSkillTargets.Action, action.Name)">
                                                    Skills
                                                </button>
                                            </div>
                                        </div>
                                        @if (IsEditing(AiActionSkillTargets.Action, action.Name))
                                        {
                                            @SkillPicker(action.Name)
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </LoadGate>
</Page>

@code {
    private RenderFragment SkillChip(string skillKey, bool viaArea) => __builder =>
    {
        var skill = SkillFor(skillKey);
        var label = skill?.DisplayName ?? skillKey;
        var isOff = skill is { IsActive: false };
        <span class="inline-flex items-center gap-1 rounded-full border border-line bg-surface-raised px-2 py-0.5 text-xs @(viaArea || isOff ?"text-content-subtle" : "text-content")"
              title="@(viaArea ? "Attached to the whole area — edit with the Area skills button." : skill?.Description ?? skillKey)">
            @label
            @if (viaArea)
            {
                <span class="italic">via area</span>
            }
            @if (isOff)
            {
                <span title="This skill is switched off — it is not served until it is active again.">(off)</span>
            }
        </span>
    };
    private RenderFragment SkillPicker(string targetLabel) => __builder =>
    {
        <div class="border-t border-line bg-surface px-4 py-3">
            <p class="text-xs font-medium text-content mb-2">
                Skills for <span class="font-mono">@targetLabel</span> — served with the action's
                contract on every call.
            </p>
            @if (saveErrors.Count > 0)
            {
                <div class="rounded border border-negative/40 bg-negative/5 px-3 py-2 mb-2">
                    @foreach (var saveError in saveErrors)
                    {
                        <p class="text-xs leading-snug text-content-muted">@saveError</p>
                    }
                </div>
            }
            <div class="grid gap-1 md:grid-cols-2 mb-3">
                @foreach (var skill in skills!.OrderBy(candidate => candidate.DisplayName))
                {
                    <label class="inline-flex items-start gap-2 text-sm text-content">
                        <input type="checkbox" class="mt-0.5"
                               checked="@working.Contains(skill.SkillKey)"
                               @onchange="() => ToggleSkill(skill.SkillKey)" />
                        <span>
                            @skill.DisplayName
                            <span class="text-xs text-content-subtle">
                                — @skill.SkillKey@(skill.IsActive ? "" : " (off)")
                            </span>
                        </span>
                    </label>
                }
            </div>
            <div class="flex items-center gap-2">
                <button type="button" class="btn-primary" @onclick="SaveEditingAsync" disabled="@saving">
                    @(saving ? "Saving…" : "Save")
                </button>
                <button type="button" class="btn-neutral" @onclick="CancelEditing" disabled="@saving">
                    Cancel
                </button>
            </div>
        </div>
    };
}
