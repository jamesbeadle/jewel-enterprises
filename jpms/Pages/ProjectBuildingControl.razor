@page "/projects/{ProjectId}/building-control"
@using Jewel.JPMS.Contracts.BuildingControl
@using Jewel.JPMS.Features.BuildingControl
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject BuildingControlReadModel BuildingControl
@inject IBuildingControlAttachmentClient Attachments
@inject ICommandSender Commands
@implements IDisposable

<PageTitle>Building Control · JPMS</PageTitle>

@*
    The project's building control — the statutory sign-off trail. The case panel says who signs
    the work off (the body, their reference, the contact) and where the case as a whole has got
    to; the register below is the inspection stages: Planned → Booked → Inspected → Passed /
    Actions required → Closed, each with a BCI-#### reference that is also its mailbox tag stem,
    so the inspector's emails read back live on the stage's own page. The inspector's booking
    email is filed to a stage — or a new stage raised from it — in the Control Centre.
*@

<Page>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="building-control">
        <h2 class="text-lg font-semibold text-content mb-4">Building Control</h2>

        @if (actionError is { } error)
        {
            <Notice Tone="Tone.Negative" Class="mb-4">@error</Notice>
        }

        @* The case panel, its documents and the inspection register are all the same load, so
           the tab gates once around the lot rather than once per section. *@
        <LoadGate IsLoading="@(!BuildingControl.LoadedFor(ProjectId) && !dataFailed)" Prominent="true" Label="Loading building control">
        @if (dataFailed && !BuildingControl.LoadedFor(ProjectId))
        {
            <p class="text-sm text-content-muted">Building control couldn't be loaded just now — the error toast has the detail. Reload the page to retry.</p>
        }
        else
        {
            @* ---- Case panel: who signs the work off, and where the case stands. ---- *@
            @if (ActiveCase is null)
            {
                <section class="panel p-5 mb-5">
                    <h3 class="text-sm font-medium text-content-muted mb-1">No building control case yet</h3>
                    <p class="text-sm text-content-subtle mb-4">
                        Set up the case — the body signing this project off, their reference and the notice dates —
                        and the inspection checklist starts from a standard set of stages you can edit freely.
                    </p>
                    @if (!caseFormOpen)
                    {
                        <button type="button" class="btn-primary"
                                @onclick="OpenCreateCase">
                            Set up building control
                        </button>
                    }
                </section>
            }
            else
            {
                <section class="panel p-5 mb-5">
                    <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <h3 class="text-base font-semibold text-content truncate">@ActiveCase.BodyName</h3>
                                <Pill Tone="Tone.Info">@ActiveCase.Status.DisplayName()</Pill>
                            </div>
                            <p class="text-xs text-content-subtle mt-0.5">
                                @ActiveCase.Regime.Label()
                                @if (!string.IsNullOrWhiteSpace(ActiveCase.BodyReference))
                                {
                                    <span> · Ref <span class="font-mono">@ActiveCase.BodyReference</span></span>
                                }
                                <span> · @ActiveCase.Reference</span>
                            </p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <select class="field py-1" value="@((int)ActiveCase.Status)" disabled="@busy"
                                    @onchange="e => SetCaseStatusAsync(ActiveCase, e)">
                                @foreach (var status in Enum.GetValues<BuildingControlCaseStatus>())
                                {
                                    <option value="@((int)status)">@status.DisplayName()</option>
                                }
                            </select>
                            <button type="button" class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4"
                                    @onclick="() => OpenEditCase(ActiveCase)">Edit</button>
                        </div>
                    </div>
                    <dl class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-2 text-sm mb-4">
                        <div>
                            <dt class="eyebrow">Contact</dt>
                            <dd class="text-content">@(string.IsNullOrWhiteSpace(ActiveCase.ContactName) ? "—" : ActiveCase.ContactName)</dd>
                            @if (!string.IsNullOrWhiteSpace(ActiveCase.ContactEmail))
                            {
                                <dd class="text-content-muted text-xs truncate">@ActiveCase.ContactEmail</dd>
                            }
                        </div>
                        <div>
                            <dt class="eyebrow">Notice submitted</dt>
                            <dd class="text-content">@DateText(ActiveCase.NoticeSubmittedOn)</dd>
                        </div>
                        <div>
                            <dt class="eyebrow">Accepted</dt>
                            <dd class="text-content">@DateText(ActiveCase.AcceptedOn)</dd>
                        </div>
                        <div>
                            <dt class="eyebrow">Completion certified</dt>
                            <dd class="text-content">@DateText(ActiveCase.CompletionCertifiedOn)</dd>
                        </div>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(ActiveCase.Notes))
                    {
                        <p class="text-sm text-content-muted mb-4">@ActiveCase.Notes</p>
                    }

                    @* Case documents: the notice, acknowledgement, decision, completion certificate. *@
                    <div class="border-t border-line pt-3">
                        <div class="flex items-center justify-between mb-2">
                            <h4 class="eyebrow">Case documents</h4>
                            <label class="text-xs text-accent hover:underline cursor-pointer @(busy ?"opacity-50 pointer-events-none" : "")">
                                + Add files
                                <InputFile OnChange="e => UploadToCaseAsync(ActiveCase, e)" multiple class="hidden" />
                            </label>
                        </div>
                        <div class="flex items-center gap-2 mb-2">
                            <label class="text-xs text-content-subtle">Uploading as</label>
                            <select class="field py-1 max-w-56" value="@((int)caseUploadKind)"
                                    @onchange="e => caseUploadKind = ParseKind(e) ?? caseUploadKind">
                                @foreach (var kind in CaseDocumentKinds)
                                {
                                    <option value="@((int)kind)">@kind.Label()</option>
                                }
                            </select>
                        </div>
                        @if (CaseFiles(ActiveCase).Count == 0)
                        {
                            <EmptyState Message="No documents on the case yet — the notice, the acknowledgement and the decision notice belong here." />
                        }
                        else
                        {
                            <ul class="space-y-1.5">
                                @foreach (var file in CaseFiles(ActiveCase))
                                {
                                    <li class="flex flex-wrap items-center justify-between gap-2 text-sm">
                                        <div class="min-w-0">
                                            <a class="font-medium text-content hover:underline" href="@Attachments.FileUrl(file.BuildingControlAttachmentId)" download>@file.DisplayName</a>
                                            <span class="text-xs text-content-subtle ml-2">@file.Kind.Label() · @FormatSize(file.FileSizeBytes)</span>
                                        </div>
                                        <button type="button" class="text-xs text-content-muted hover:text-negative" disabled="@busy"
                                                @onclick="() => RemoveFileAsync(file.BuildingControlAttachmentId)">Remove</button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </section>
            }

            @* ---- Case set-up / edit form. ---- *@
            @if (caseFormOpen)
            {
                <section class="panel p-5 mb-5">
                    <h3 class="text-sm font-medium text-content-muted mb-3">@(editingCase is null ? "Set up building control" : "Edit case details")</h3>
                    <div class="space-y-3">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <FormField Label="Regime">
                                <select class="field" value="@((int)formRegime)" @onchange="e => formRegime = ParseRegime(e)">
                                    @foreach (var regime in BuildingControlRegimes.All)
                                    {
                                        <option value="@((int)regime)">@regime.Label()</option>
                                    }
                                </select>
                                </FormField>
                            </div>
                            <div>
                                <FormField Label="Body" Required>
                                <input type="text" class="field" maxlength="256" placeholder="Who signs the work off — the council or the approver"
                                       value="@formBodyName" @oninput="e => formBodyName = e.Value?.ToString() ?? string.Empty" />
                                </FormField>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <div>
                                <FormField Label="Their reference">
                                <input type="text" class="field" maxlength="128" placeholder="e.g. BC2415406DOMFPB"
                                       value="@formBodyReference" @oninput="e => formBodyReference = e.Value?.ToString() ?? string.Empty" />
                                </FormField>
                            </div>
                            <div>
                                <FormField Label="Notice submitted">
                                <input type="date" class="field" value="@formNoticeSubmittedOn"
                                       @onchange="e => formNoticeSubmittedOn = e.Value?.ToString() ?? string.Empty" />
                                </FormField>
                            </div>
                            <div>
                                <FormField Label="Accepted / in force">
                                <input type="date" class="field" value="@formAcceptedOn"
                                       @onchange="e => formAcceptedOn = e.Value?.ToString() ?? string.Empty" />
                                </FormField>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <div>
                                <FormField Label="Contact name">
                                <input type="text" class="field" maxlength="256"
                                       value="@formContactName" @oninput="e => formContactName = e.Value?.ToString() ?? string.Empty" />
                                </FormField>
                            </div>
                            <div>
                                <FormField Label="Contact email">
                                <input type="text" class="field" maxlength="256"
                                       value="@formContactEmail" @oninput="e => formContactEmail = e.Value?.ToString() ?? string.Empty" />
                                </FormField>
                            </div>
                            <div>
                                <FormField Label="Contact phone">
                                <input type="text" class="field" maxlength="64"
                                       value="@formContactPhone" @oninput="e => formContactPhone = e.Value?.ToString() ?? string.Empty" />
                                </FormField>
                            </div>
                        </div>
                        <div>
                            <FormField Label="Notes">
                            <textarea class="field" rows="2" maxlength="4096"
                                      value="@formNotes" @oninput="e => formNotes = e.Value?.ToString() ?? string.Empty"></textarea>
                            </FormField>
                        </div>
                        @if (editingCase is null)
                        {
                            <label class="flex items-center gap-2 text-sm text-content cursor-pointer">
                                <input type="checkbox" checked="@formSeedStages" @onchange="e => formSeedStages = e.Value is true" />
                                Start the checklist from the standard stages
                                <span class="text-content-subtle text-xs">— @string.Join(" → ", BuildingControlStages.DefaultChecklist); rename, reorder or delete freely</span>
                            </label>
                        }
                        <div class="flex items-center gap-3">
                            <button type="button" class="btn-primary"
                                    disabled="@(string.IsNullOrWhiteSpace(formBodyName) || busy)"
                                    @onclick="SaveCaseAsync">
                                @(editingCase is null ? "Set up case" : "Save changes")
                            </button>
                            <button type="button" class="text-xs text-content-subtle hover:text-content underline underline-offset-4"
                                    @onclick="() => caseFormOpen = false">Cancel</button>
                        </div>
                    </div>
                </section>
            }

            @* ---- Inspection register. ---- *@
            @if (ActiveCase is not null)
            {
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-base font-semibold text-content">Inspections</h3>
                    <button type="button" class="btn-primary"
                            @onclick="() => addStageOpen = !addStageOpen">
                        @(addStageOpen ? "Close" : "Add inspection")
                    </button>
                </div>

                @if (addStageOpen)
                {
                    <section class="panel p-5 mb-4">
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-3">
                            <div class="sm:col-span-2">
                                <FormField Label="Stage" Required>
                                <input type="text" class="field" maxlength="256" placeholder="What's being inspected — Foundations, Drainage, Steel frame…"
                                       value="@newStageName" @oninput="e => newStageName = e.Value?.ToString() ?? string.Empty" />
                                </FormField>
                            </div>
                            <div>
                                <FormField Label="Booked for">
                                <input type="date" class="field" value="@newStageBookedFor"
                                       @onchange="e => newStageBookedFor = e.Value?.ToString() ?? string.Empty" />
                                </FormField>
                            </div>
                        </div>
                        <button type="button" class="btn-primary"
                                disabled="@(string.IsNullOrWhiteSpace(newStageName) || busy)"
                                @onclick="AddStageAsync">
                            Add inspection
                        </button>
                    </section>
                }

                @if (Inspections.Count == 0)
                {
                    <EmptyState Message="No inspection stages yet — add the stages this build will be signed off in." />
                }
                else
                {
                    <RecordsTable Dense="true" MaxHeight="">
                        <thead>
                            <tr>
                                <th>Ref</th>
                                <th>Stage</th>
                                <th>Status</th>
                                <th>Booked for</th>
                                <th>Inspected</th>
                                <th>Files</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inspection in Inspections)
                            {
                                <tr @key="inspection.BuildingControlInspectionId" class="border-b border-line last:border-0 hover:bg-surface-raised/50 cursor-pointer"
                                    @onclick="() => OpenInspection(inspection)">
                                    <td class="font-mono text-xs whitespace-nowrap">@inspection.Reference</td>
                                    <td class="text-content font-medium">@inspection.StageName</td>
                                    <td class="whitespace-nowrap">
                                        <Pill Tone="@inspection.Status.ToTone()">@inspection.Status.DisplayName()</Pill>
                                    </td>
                                    <td class="whitespace-nowrap">@DateText(inspection.BookedFor)</td>
                                    <td class="whitespace-nowrap">@DateText(inspection.InspectedAt)</td>
                                    <td class="whitespace-nowrap">@FileCountText(inspection)</td>
                                    <td class="whitespace-nowrap text-right" @onclick:stopPropagation>
                                        @if (inspection.Status == BuildingControlInspectionStatus.Planned && FilesFor(inspection).Count == 0)
                                        {
                                            <button type="button" class="text-xs text-content-subtle hover:text-negative underline underline-offset-4" disabled="@busy"
                                                    @onclick="() => DeleteStageAsync(inspection)">Remove</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </RecordsTable>
                }
            }
        }
        </LoadGate>
    </ProjectPageShell>
</Page>

