@page "/admin/agents"
@inject AuthService Auth
@inject SessionService Session
@inject IQueryClient Queries
@inject NavigationManager Nav

<PageTitle>AI agents · JPMS</PageTitle>

@*
    The agent architecture, live (docs/ai/05-agents-and-skills.md). This page renders the REAL
    registry the turn loop runs on — AgentCatalogue in contracts — merged with each agent's skills
    from the store. Nothing here is a mock-up: what this page shows is exactly what the assistant
    resolves on every hop.

    The ownership split, visible: an agent's configuration (tools, routes, working instructions,
    who may engage it) is code — a developer changes it, so every conversation runs on the same
    rails. An agent's KNOWLEDGE is its skills — edited on the AI Skills page by the discipline
    owner, live on the assistant's next message.
*@

<Page CanAccess="CanSee" AccessDeniedMessage="You do not have access to the agent architecture.">
        <PageHeader>
            <SubtitleContent>
        <p class="mb-2 max-w-3xl">
            The architecture the assistant runs on, live — not a diagram. One conversation, one
            turn loop; an agent is the configuration in force: its tools, its working instructions,
            and its skills. The <span class="text-content">orchestrator</span> fronts every
            conversation and hands over before any content is drafted.
        </p>
        <p class="text-xs text-content-subtle max-w-3xl">
            Configuration (grey) is code — changed by a developer, so every conversation runs on the
            same rails. Knowledge (the skills on each card) is yours — edited on
            <a class="underline underline-offset-2 hover:text-content" href="/admin/skills">AI Skills</a>,
            in force on the assistant's next message.
        </p>
            </SubtitleContent>
        </PageHeader>

        <div class="space-y-4">
            @foreach (var agent in AgentCatalogue.All)
            {
                var isOrchestrator = agent.Key == AgentCatalogue.Orchestrator.Key;
                var agentSkills = SkillsFor(agent.Key);

                <div class="panel p-5 @(isOrchestrator ?"border-accent/40" : "")">
                    <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2.5">
                                <h2 class="text-base font-semibold text-content">@agent.DisplayName</h2>
                                <span class="rounded border border-line bg-surface-raised px-1.5 py-0.5 text-xs font-mono text-content-subtle">@agent.Key</span>
                                @if (isOrchestrator)
                                {
                                    <span class="rounded bg-accent/10 px-2 py-0.5 text-xs font-semibold text-accent">FRONT OF HOUSE</span>
                                }
                            </div>
                            <p class="mt-1.5 text-sm leading-relaxed text-content-muted max-w-3xl">@agent.Description</p>
                        </div>
                        <div class="shrink-0 text-right text-xs text-content-subtle">
                            <span class="block">Available to</span>
                            <span class="block text-content-muted">@RoleList(agent)</span>
                        </div>
                    </div>

                    <div class="grid gap-x-8 gap-y-2 md:grid-cols-2 mb-3">
                        @if (agent.Triggers.Count > 0)
                        {
                            <div>
                                <span class="block text-xs font-medium text-content-subtle mb-1">Engages on</span>
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var trigger in agent.Triggers)
                                    {
                                        <span class="rounded border border-line bg-surface-raised px-1.5 py-0.5 text-xs text-content-muted">@trigger</span>
                                    }
                                </div>
                            </div>
                        }
                        @if (agent.RoutePrefixes.Count > 0)
                        {
                            <div>
                                <span class="block text-xs font-medium text-content-subtle mb-1">Starts automatically on</span>
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var prefix in agent.RoutePrefixes)
                                    {
                                        <span class="rounded border border-line bg-surface-raised px-1.5 py-0.5 text-xs font-mono text-content-muted">…@prefix/*</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <details class="mb-3">
                        <summary class="cursor-pointer text-xs text-content-subtle hover:text-content">
                            Working instructions & what “done” means <span class="text-content-faint">(configuration — code-owned)</span>
                        </summary>
                        <div class="mt-2 rounded border border-line bg-surface-raised px-3 py-2.5">
                            <p class="text-xs leading-relaxed text-content-muted whitespace-pre-line">@agent.PromptFragment</p>
                            <p class="mt-2 text-xs leading-relaxed text-content-subtle">
                                <span class="text-content-muted font-medium">Done means:</span> @agent.DoneMeans
                            </p>
                        </div>
                    </details>

                    <div class="border-t border-line pt-3">
                        <div class="flex items-center justify-between gap-3 mb-1.5">
                            <span class="text-xs font-medium text-content-subtle">
                                Skills — the knowledge this agent works from
                            </span>
                            <a class="text-xs text-content-subtle underline underline-offset-2 hover:text-content"
                               href="/admin/skills?agent=@agent.Key&new=1">Add a skill</a>
                        </div>

                        @if (skills is null)
                        {
                            <p class="text-xs text-content-faint">Loading…</p>
                        }
                        else if (agentSkills.Count == 0)
                        {
                            <p class="text-xs text-content-subtle">
                                None yet — this agent runs on its configuration and the shared skills alone.
                            </p>
                        }
                        else
                        {
                            @* Each row is an explicit full-width flex row, not .btn-secondary: .btn is
                               inline-flex + h-8 + justify-center, so a row sized itself to its longest
                               line and ran off the right of the card — `truncate` never had an edge to
                               clip at. Same border/hover look, but w-full + min-w-0 + overflow-hidden
                               give the description a real width to truncate against. *@
                            <div class="space-y-1 min-w-0">
                                @foreach (var skill in agentSkills)
                                {
                                    <a href="/admin/skills?skill=@Uri.EscapeDataString(skill.SkillKey)"
                                       class="flex w-full min-w-0 items-center justify-between gap-3 overflow-hidden rounded border border-line bg-transparent px-3 py-1.5 text-left text-content transition hover:border-line-strong hover:bg-surface-raised">
                                        <span class="min-w-0 flex-1 overflow-hidden">
                                            <span class="block truncate text-xs text-content" title="@skill.DisplayName">@skill.DisplayName
                                                @if (skill.AgentKey == "shared")
                                                {
                                                    <span class="text-content-faint"> · shared</span>
                                                }
                                            </span>
                                            <span class="block truncate text-xs text-content-subtle" title="@skill.Description">@skill.Description</span>
                                        </span>
                                        <span class="shrink-0 text-xs text-content-subtle whitespace-nowrap">
                                            @(skill.Pinned ? "Pinned" : "On demand") · v@(skill.Version)
                                            @if (!skill.IsActive)
                                            {
                                                <span class="text-negative"> · off</span>
                                            }
                                        </span>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @* The autonomous side — declared so the roster reads complete, greyed because it is
               not built yet. The chaser and triage are worker runs, not conversational agents. *@
            <div class="panel p-5 opacity-70">
                <div class="flex items-center gap-2.5 mb-1.5">
                    <h2 class="text-base font-semibold text-content">Chaser & Mailbox Triage</h2>
                    <span class="rounded border border-line bg-surface-raised px-1.5 py-0.5 text-xs text-content-subtle">autonomous · not built yet</span>
                </div>
                <p class="text-sm leading-relaxed text-content-muted max-w-3xl">
                    The scheduled agents: mailbox triage every five minutes and the 09:00 request
                    sweep. Same loop, run by the worker with no user present — so everything they
                    produce is an Outlook draft or a proposal for a person to confirm. They appear
                    here when the worker runtime lands (docs/ai/05 §4, task 7.8).
                </p>
            </div>
        </div>

        <p class="mt-6 text-xs text-content-subtle max-w-3xl">
            Every hop the assistant takes is recorded against the agent in force —
            <a class="underline underline-offset-2 hover:text-content" href="/agents/activity">Agent Activity</a>
            is the run log of everything on this page.
        </p>
</Page>

@code {

    // Null means no fetch has landed (CLAUDE.md loading states). The agent cards render without
    // it — the catalogue is code — and each card's skill list waits on its own line.
    private IReadOnlyList<SkillSummary>? skills;

    // Mirrors the API's SkillRoles.ManageSkills, same as the AI Skills page.
    private bool CanSee =>
        Session.ActiveRole is Role.Admin or Role.ManagingDirector or Role.FinanceDirector;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!CanSee) return;

        try
        {
            skills = await Queries.AskAsync(new ListAiSkills(), CancellationToken.None);
        }
        catch
        {
            // The error toast carries the reference; the cards still render, each saying "none yet".
            skills = Array.Empty<SkillSummary>();
        }
    }

    /// <summary>The agent's own skills first, then the shared set every agent pins.</summary>
    private IReadOnlyList<SkillSummary> SkillsFor(string agentKey) =>
        skills is null
            ? Array.Empty<SkillSummary>()
            : skills
                .Where(skill => string.Equals(skill.AgentKey, agentKey, StringComparison.OrdinalIgnoreCase)
                                || skill.AgentKey == "shared")
                .OrderBy(skill => skill.AgentKey == "shared" ? 1 : 0)
                .ThenByDescending(skill => skill.Pinned)
                .ThenBy(skill => skill.DisplayName)
                .ToList();

    private static string RoleList(AgentDefinition agent) =>
        string.Join(", ", agent.AvailableTo
            .Where(role => role != Role.Admin)
            .Select(Label)) + " + administrators";

    private static string Label(Role role) => role switch
    {
        Role.ManagingDirector => "MD",
        Role.FinanceDirector => "FD",
        Role.ProjectManager => "PM",
        Role.QuantitySurveyor => "QS",
        _ => role.ToString()
    };
}
