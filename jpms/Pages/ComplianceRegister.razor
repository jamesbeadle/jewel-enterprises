@page "/directory/compliance"
@using Jewel.JPMS.Features.Directory
@using Jewel.JPMS.Features.Subcontractors
@inject AuthService Auth
@inject SessionService Session
@inject ISubcontractorStore SubcontractorStore
@inject ComplianceOverviewReadModel Compliance
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Compliance register · JPMS</PageTitle>

@*
    The compliance register (2026-09-09, the accountant's ask): every directory company's current
    compliance documents in ONE list, so lapsing insurance is seen across the whole supply chain
    rather than one record at a time. It reads expired, then expiring, then current, then (2026-09-10,
    her second ask) the companies with nothing on file — a Missing company is a row too, Missing
    being a standing rather than an absence, but there are hundreds of them and they sit below the
    documents that exist. Rows open the company's record, where the renewal is filed. Same gate as
    the Directory; same whole-company read as its Compliance column. The PL cover column (the
    third ask, that evening) is the public liability limit the document records — Jewel's insurer
    requires £5m of every subcontractor on a big job, so a smaller figure reads in warning and the
    "Below £5m PL" chip lists those companies; a blank is "not recorded", never nil cover, and is
    filled from the record page's Edit details without a re-upload.
*@

<Page>
    @if (!CanAccess)
    {
        <PageHeader Title="Not available" />
        <p class="text-content-muted">The directory is restricted to administrators, directors and project managers.</p>
    }
    else
    {
        <PageHeader>
            <SubtitleContent>
                @if (IsLoaded)
                {
                    @Summary
                }
            </SubtitleContent>
            <Actions>
                <Toolbar>
                    <ExportToExcelButton FileName="Compliance register"
                                         Disabled="@(FilteredRows.Count == 0)"
                                         ShowIncludeAllRows="@FiltersActive"
                                         IncludeAllLabel="Ignore search & filter"
                                         BuildWorkbook="BuildExportWorkbook" />
                </Toolbar>
            </Actions>
        </PageHeader>

        <TabRow Items="DirectoryViewTabs.Items" ActiveKey="@DirectoryViewTabs.ComplianceRegister" AriaLabel="Directory views" />

        <div class="flex flex-wrap items-center gap-3 mb-5">
            <SearchInput Value="@search" ValueChanged="value => search = value" Placeholder="Company, trade, document…" />
            <FilterChips Items="StatusChips" Selected="@statusFilter" OnSelect="key => statusFilter = key"
                         Disabled="@(!IsLoaded)" AriaLabel="Compliance" />
        </div>

        @if (dataFailed)
        {
            <Notice Tone="Tone.Negative">Couldn't load the compliance documents — refresh to try again.</Notice>
        }
        else
        {
            <RecordsTable IsLoading="@(!IsLoaded)" LoadingLabel="Loading the register" Dense="true"
                          IsEmpty="@(FilteredRows.Count == 0)" EmptyMessage="No documents match.">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th class="hidden md:table-cell">Trade</th>
                        <th>Document</th>
                        <th class="text-right">Expires</th>
                        <th class="text-right" title="Public liability cover recorded on the document — £5m required on big jobs">PL cover</th>
                        <th>Compliance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in FilteredRows)
                    {
                        <tr class="is-clickable" @onclick="() => Open(row.Company.SubcontractorId)">
                            <td class="text-content font-medium">@row.Company.CompanyName</td>
                            <td class="hidden md:table-cell">@row.Company.TradesLabel</td>
                            <td>@row.DocumentLabel</td>
                            <td class="text-right whitespace-nowrap">@DateText(row.ExpiresAt)</td>
                            <td class="text-right whitespace-nowrap @(row.IsBelowPublicLiabilityRequirement ? "text-warning font-medium" : "")"
                                title="@(row.IsBelowPublicLiabilityRequirement ? DirectoryComplianceFilter.BelowPublicLiabilityRequirementTitle : null)">@row.PublicLiabilityCoverText</td>
                            <td><ComplianceStatusPill Status="@row.Status" /></td>
                        </tr>
                    }
                </tbody>
            </RecordsTable>
        }
    }
</Page>
