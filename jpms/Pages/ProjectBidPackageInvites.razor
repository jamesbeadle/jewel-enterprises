@page "/projects/{ProjectId}/bid-package-invites"
@inject AuthService Auth
@inject SessionService Session
@inject IProcurementStore ProcurementStore
@inject ISubcontractorStore SubcontractorStore
@inject ICommandSender Commands
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Bid Package Invites · JPMS</PageTitle>

<Page>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="bid-package-invites">
        <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
            <div>
                <h2 class="text-lg font-semibold text-content">Bid package invites</h2>
                <p class="text-sm text-content-muted">
                    Bid packages issued to subcontractors to tender. @Packages.Count package@(Packages.Count == 1 ? "" : "s") on this project.
                </p>
            </div>
            <div class="flex items-center gap-3">
                <ExportToExcelButton FileName="Bid package invites"
                                     Disabled="@(Packages.Count == 0)"
                                     BuildWorkbook="BuildExportWorkbook" />
                @if (CanManage)
                {
                    <button type="button" class="btn-secondary" @onclick="OpenSuggestModal">Suggest bid packages</button>
                    <button type="button" class="btn-primary" @onclick="OpenCreateModal">New bid package</button>
                }
            </div>
        </div>

        @if (error is not null)
        {
            <Notice Tone="Tone.Negative" Class="mb-4">@error</Notice>
        }

        @if (Packages.Count == 0)
        {
            <p class="text-sm text-content-subtle italic">
                No bid package invites yet.
                @(CanManage
                    ? "Start one with “New bid package”, or create one from a tagged email in Triage."
                    : "They'll appear here once a bid package is created for this project.")
            </p>
        }
        else
        {
            <RecordsTable>
                <thead>
                    <tr>
                        <th>Package</th>
                        <th class="hidden sm:table-cell">Trade</th>
                        <th>Status</th>
                        <th class="hidden lg:table-cell">Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var package in Packages)
                    {
                        <tr class="hover:bg-surface-raised @(package.Status == BidPackageStatus.Closed ?"opacity-60" : "")">
                            <td>
                                <a class="text-content font-medium hover:underline underline-offset-4"
                                   href="@($"/projects/{ProjectId}/bid-package-invites/{package.BidPackageId}")">@package.Title</a>
                            </td>
                            <td class="hidden sm:table-cell">@package.Trade</td>
                            <td>
                                <Pill Tone="Tone.Muted">@package.Status</Pill>
                            </td>
                            <td class="text-content-subtle hidden lg:table-cell">@DateText(package.CreatedAt)</td>
                        </tr>
                    }
                </tbody>
            </RecordsTable>
        }
    </ProjectPageShell>

    @* ---- New bid package: title + trade now, everything else on the detail page ---- *@
    <Modal IsOpen="showCreateModal" Title="New bid package" ShowFooter="true"
           ConfirmLabel="@(busy ? "Creating…" : "Create package")"
           ConfirmDisabled="@(busy || string.IsNullOrWhiteSpace(createTitle) || string.IsNullOrWhiteSpace(createTrade))" CancelLabel="Cancel"
           OnCancel="CloseCreateModal" OnConfirm="ConfirmCreate" Class="max-w-lg w-full">
        <FormField Label="Title">
        <input class="field mb-3" placeholder="e.g. Ground-floor electrical works" @bind="createTitle" @bind:event="oninput" />
        </FormField>

        <FormField Label="Trade">
        @* The curated trade list (Admin → Trades), not free text — packages carry the same trade
           names the directory filters on. Loading convention: a control is never gated — it
           renders disabled with a "Loading…" placeholder until the list has landed. *@
        <select class="field mb-3" @bind="createTrade" disabled="@(!SubcontractorStore.TradesLoaded)">
            @if (!SubcontractorStore.TradesLoaded)
            {
                <option value="">Loading trades…</option>
            }
            else
            {
                <option value="">Select a trade…</option>
                @foreach (var trade in SubcontractorStore.Trades())
                {
                    <option value="@trade.Name">@trade.Name</option>
                }
            }
        </select>
        </FormField>
        @if (SubcontractorStore.TradesLoaded && SubcontractorStore.Trades().Count == 0)
        {
            <p class="text-xs text-content-subtle -mt-2 mb-3">No trades yet — an administrator can add them under Admin → Trades.</p>
        }

        <label class="flex items-center gap-2 text-sm text-content-muted cursor-pointer mb-1"
               title="When ticked, the tender-invite email asks each subcontractor to state whether they will supply their own materials or price labour-only.">
            <input type="checkbox" @bind="createMaterials" />
            Materials apply — ask tenderers whether they supply their own
        </label>

        <p class="text-xs text-content-subtle mt-3">
            The package starts as a Draft. You'll add line items, link drawings and invite
            subcontractors on the package's page — nothing is emailed until you draft the invite there.
        </p>
    </Modal>

    @* ---- Suggest bid packages: Claude reads the valuation report and proposes what to tender.
         Nothing is created until the user picks suggestions — each pick becomes an ordinary
         Draft package via CreateBidPackage. Overlay-dismiss is off once results exist: a stray
         click must not throw away an answer that cost a model call. ---- *@
    <Modal IsOpen="showSuggestModal" Title="Suggest bid packages"
           DismissOnOverlayClick="@(suggestions is null)"
           OnCancel="CloseSuggestModal" Class="max-w-2xl w-full">
        <FooterContent>
            <button type="button" class="btn-neutral" @onclick="CloseSuggestModal">@(suggestions is null ? "Cancel" : "Close")</button>
            @if (suggestions is null)
            {
                <button type="button" class="btn-primary" disabled="@suggestBusy" @onclick="RunSuggestion">
                    @(suggestBusy ? "Analysing…" : "Suggest packages")
                </button>
            }
            else
            {
                <button type="button" class="btn-secondary" disabled="@(suggestBusy || createBusy)" @onclick="RunSuggestion">Re-run</button>
                @if (suggestions.Count > 0)
                {
                    <button type="button" class="btn-primary" disabled="@(createBusy || SelectedCount == 0)" @onclick="CreateSelectedSuggestions">
                        @(createBusy ? "Creating…" : SelectedCount == 1 ? "Create 1 package" : $"Create {SelectedCount} packages")
                    </button>
                }
            }
        </FooterContent>
        <ChildContent>
            <p class="text-sm text-content-muted mb-3">
                Claude reads this project's live valuation report — what's complete, what's left — and
                proposes trade packages for the remaining works, grouped so each can be tendered and
                delivered as its own phase. Only suggestions you tick are created, as Drafts.
            </p>

            @if (suggestError is not null)
            {
                <Notice Tone="Tone.Negative" Class="mb-3">@suggestError</Notice>
            }

            @* Slow tiers answer in several continuation chunks — the part counter says the
               long wait is progress, not a hang. *@
            <LoadGate IsLoading="@suggestBusy"
                      Label="@(suggestHops <= 1 ? "Analysing the valuation report" : $"Analysing the valuation report — part {suggestHops}")">
            @if (suggestions is null)
            {
                <FormField Label="Model">
                @* Same cost lever as the chat panel: only a tier KEY leaves the browser — the
                   server maps it to a model id, and unknown keys degrade to cheap. *@
                <select class="field mb-1" @bind="suggestModelKey" aria-label="Model">
                    @foreach (var choice in AiModelCatalogue.All)
                    {
                        <option value="@choice.Key">@choice.DisplayName</option>
                    }
                </select>
                </FormField>
                <p class="text-xs text-content-subtle">@SuggestModelHint</p>
            }
            else
            {
                <p class="text-xs text-content-subtle mb-3">
                    Suggested by @suggestModelUsed.
                    @if (suggestNote is not null)
                    {
                        <span> @suggestNote</span>
                    }
                </p>

                @if (suggestions.Count == 0)
                {
                    <p class="text-sm text-content-subtle italic">
                        Nothing worth tendering was found — the remaining works are already covered by
                        existing packages or are too far complete.
                    </p>
                }
                else
                {
                    <div class="space-y-3">
                        @for (var i = 0; i < suggestions.Count; i++)
                        {
                            var index = i;
                            var suggestion = suggestions[index];
                            <label class="flex items-start gap-3 panel-raised px-4 py-3 cursor-pointer @(selectedSuggestions.Contains(index) ?"border-accent/40" : "")">
                                <input type="checkbox" class="mt-1"
                                       checked="@selectedSuggestions.Contains(index)"
                                       @onchange="e => ToggleSuggestion(index, e.Value is true)" />
                                <span class="min-w-0">
                                    <span class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                                        <span class="text-sm font-semibold text-content">@suggestion.Title</span>
                                        <Pill Tone="Tone.Muted">@suggestion.Trade</Pill>
                                        @if (suggestion.ApproxValue > 0)
                                        {
                                            <span class="text-xs text-content-subtle">~£@suggestion.ApproxValue.ToString("N0") remaining</span>
                                        }
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(suggestion.Scope))
                                    {
                                        <span class="block text-sm text-content-muted whitespace-pre-wrap mt-1">@suggestion.Scope</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(suggestion.Rationale))
                                    {
                                        <span class="block text-xs text-content-subtle italic mt-1">@suggestion.Rationale</span>
                                    }
                                    @if (suggestion.SourceLines.Count > 0)
                                    {
                                        <span class="block text-xs text-content-faint mt-1"
                                              title="@string.Join("\n", suggestion.SourceLines)">
                                            Based on @suggestion.SourceLines.Count report line@(suggestion.SourceLines.Count == 1 ? "" : "s")
                                        </span>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                }
            }
            </LoadGate>
        </ChildContent>
    </Modal>
</Page>

