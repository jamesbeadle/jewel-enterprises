@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="min-h-dvh bg-canvas text-content antialiased">
    @* Sign-in, set-password and forgot-password get the same error surface as the rest of the app:
       a failure here is exactly the kind a user needs to be able to forward. *@
    <ErrorToast />
    @* Sign-in gets the update prompt too: a stale cached bundle on the landing page is exactly
       what makes "sign-in is broken" reports out of a deploy that changed the auth flow. *@
    <UpdateToast />
    @Body
</div>

@code {
    // Sign-in is a real screen, so the boot overlay's work is done the moment it draws. Every
    // route that is not behind ApprovedSessionGate takes the boot screen down here.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await BootScreen.DismissAsync(JS);
    }
}
