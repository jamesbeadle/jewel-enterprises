@inject AuthService Auth
@inject IRequestRegister RequestRegister

@*
    The request's conversation: internal notes, shared notes and the live email legs, newest first.

    Every message is a bordered card rather than a row hanging off a thin left rule. With only a
    2px rule between them, consecutive messages ran into each other — a long note and the reply
    under it read as one block of text. The card pattern is the one ProjectCommunications already
    uses for tagged email; this brings the request page onto it. Internal notes keep a warm tint and
    a marked edge so "don't send this to the client" is legible at a glance, not just a small badge.
*@

<Panel Title="Conversation" BodyClass="p-5">
    <HeaderActions>
        <div class="flex items-center gap-3">
            @if (loaded && allMessages.Count > 0)
            {
                <span class="text-xs text-content-subtle">
                    @allMessages.Count message@(allMessages.Count == 1 ? "" : "s")@(InternalCount > 0 ? $" · {InternalCount} internal" : "")
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(RequestReference))
            {
                @* Search the whole mailbox and tag what belongs to this request — the conversation
                   AND the assistant's context both get richer with each tag. *@
                <Jewel.JPMS.Features.Triage.Panels.EmailFinder Type="RecordType.Request" RecordId="@RequestId"
                             RecordReference="@RequestReference" ExcludeTag="@($"JPMS/{RequestReference}")"
                             OnLinked="LoadAsync" />
            }
        </div>
    </HeaderActions>
    <ChildContent>
    <LoadGate IsLoading="@(!loaded)" Prominent="true" Label="Loading conversation">
        @if (messages.Count == 0)
        {
            <p class="rounded border border-dashed border-line px-4 py-6 text-center text-sm text-content-subtle italic mb-5">
                No messages yet. Start the discussion below.
            </p>
        }
        else
        {
            <ol class="space-y-3 mb-5">
                @foreach (var message in messages)
                {
                    var isInternal = message.Visibility == MessageVisibility.Internal;
                    <li class="rounded border px-4 py-3 @(isInternal ?"border-warning/40 bg-warning/5" : "border-line bg-surface-raised")">
                        <div class="flex items-start justify-between gap-3 mb-2">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-xs font-semibold @(isInternal ?"bg-warning/15 text-warning" : "bg-surface text-content-muted border border-line")"
                                      aria-hidden="true">@Initials(message)</span>
                                <span class="text-sm font-semibold text-content truncate">@AuthorLabel(message)</span>
                                @if (!string.IsNullOrEmpty(message.MailboxId))
                                {
                                    <Pill Tone="Tone.Muted" Class="shrink-0">Email</Pill>
                                }
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                @if (isInternal)
                                {
                                    <Pill Tone="Tone.Warning">Internal</Pill>
                                }
                                else
                                {
                                    <Pill Tone="Tone.Muted">Shared</Pill>
                                }
                                <time class="text-xs text-content-subtle whitespace-nowrap" datetime="@message.PostedAt.ToString("o")">
                                    @DateTimeText(message.PostedAt)
                                </time>
                            </div>
                        </div>
                        @* A MailboxId marks a LIVE email leg (inbound, or the mailbox's own sent
                           reply read from Sent Items) — both expand to their full body on demand. *@
                        @if (!string.IsNullOrEmpty(message.MailboxId)
                             && expanded.Contains(message.MessageId))
                        {
                            @* Expanded email: the full body (incl. the quoted thread), fetched live on demand,
                               rendered in the shared correspondence card's shape — To/Cc envelope lines above
                               the body, the attachments as their own bounded block below. The listed Body is
                               only Graph's short preview snippet, so long emails and their history only appear
                               here. HTML is sanitised server-side before it reaches us. *@
                            <div class="rounded bg-surface border border-line p-3 max-h-[28rem] overflow-y-auto">
                                @if (!details.TryGetValue(message.MessageId, out var detail) || detail is null)
                                {
                                    <p class="text-sm text-content-subtle italic">Loading full email…</p>
                                }
                                else
                                {
                                    @if (detail.To is { Count: > 0 } to)
                                    {
                                        <p class="text-xs text-content-subtle truncate">To: @string.Join("; ", to)</p>
                                    }
                                    @if (detail.Cc is { Count: > 0 } cc)
                                    {
                                        <p class="text-xs text-content-subtle truncate">Cc: @string.Join("; ", cc)</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(detail.BodyHtml) && detail.BodyIsHtml)
                                    {
                                        <div class="rounded bg-white text-gray-900 p-3 text-sm overflow-x-auto mt-1">@((MarkupString)detail.BodyHtml)</div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(detail.BodyHtml))
                                    {
                                        <p class="text-sm text-content whitespace-pre-wrap mt-1">@detail.BodyHtml</p>
                                    }
                                    else
                                    {
                                        <p class="text-sm text-content whitespace-pre-wrap mt-1">@message.Body</p>
                                    }
                                }
                            </div>
                            @if (details.TryGetValue(message.MessageId, out var loadedDetail)
                                 && loadedDetail is { Attachments.Count: > 0 })
                            {
                                @* View opens the file in a new tab (types a browser renders); Download always
                                   saves. Both stream through the request-scoped attachment endpoint, which
                                   checks the email carries this request's tag — same gate as the body above. *@
                                <div class="mt-2 rounded bg-surface border border-line p-3">
                                    <p class="eyebrow mb-2">
                                        @loadedDetail.Attachments.Count attachment@(loadedDetail.Attachments.Count == 1 ? "" : "s")
                                    </p>
                                    <ul class="space-y-1">
                                        @foreach (var attachment in loadedDetail.Attachments)
                                        {
                                            <li class="flex items-center justify-between gap-3 text-sm text-content">
                                                <span class="truncate">@attachment.Name</span>
                                                <span class="flex items-center gap-3 whitespace-nowrap">
                                                    @if (attachment.Size > 0)
                                                    {
                                                        <span class="text-xs text-content-subtle">@FormatSize(attachment.Size)</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(attachment.Id))
                                                    {
                                                        @if (RendersInBrowser(attachment))
                                                        {
                                                            <a href="@AttachmentUrl(message, attachment, viewInline: true)" target="_blank" rel="noopener"
                                                               class="text-xs text-accent hover:underline">View</a>
                                                        }
                                                        <a href="@AttachmentUrl(message, attachment, viewInline: false)"
                                                           class="text-xs text-accent hover:underline">Download</a>
                                                    }
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-sm text-content-muted whitespace-pre-wrap leading-relaxed">@message.Body</p>
                        }
                        @* Typed messages thread: Reply answers this message, and the replies nest
                           beneath it. Email legs keep their own reply flow (the official-PDF
                           Outlook draft below) — the two are different acts on purpose. *@
                        @if (string.IsNullOrEmpty(message.MailboxId))
                        {
                            <div class="mt-2">
                                <button type="button" class="text-xs font-medium text-accent hover:underline"
                                        @onclick="() => StartReply(message)">Reply</button>
                            </div>
                        }
                        @{ var replies = RepliesFor(message.MessageId); }
                        @if (replies.Count > 0)
                        {
                            <div class="mt-3 space-y-3 border-l-2 border-line pl-3">
                                @foreach (var reply in replies)
                                {
                                    <ConversationMessageCard Entry="reply" ShowVisibility="true"
                                                             CanReply="true" OnReply="StartReplyEntry" />
                                }
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(message.MailboxId))
                        {
                            <div class="mt-3 pt-2 border-t border-line/70 flex flex-wrap items-center gap-4">
                                <button type="button"
                                        class="text-xs font-medium text-accent hover:underline"
                                        @onclick="() => ToggleExpandAsync(message)">
                                    @(expanded.Contains(message.MessageId) ? "Show summary" : "Show full email")
                                </button>
                                @if (CanDraftReply)
                                {
                                    <button type="button"
                                            class="text-xs font-medium text-accent hover:underline"
                                            disabled="@(replyingId is not null)"
                                            @onclick="() => DraftReplyAsync(message)">
                                        @(replyingId == message.MessageId ? "Drafting reply…" : "Reply with official PDF")
                                    </button>
                                }
                            </div>
                            @if (replyForMessageId == message.MessageId && replyError is not null)
                            {
                                <Notice Tone="Tone.Negative" Class="mt-2">@replyError</Notice>
                            }
                            @if (replyForMessageId == message.MessageId && replyDraft is not null)
                            {
                                <Notice Tone="Tone.Positive" Class="mt-2">
                                    <p class="text-sm font-medium text-positive">
                                        Reply draft created in the projects mailbox — official PDF attached, in this email's thread.
                                    </p>
                                    <p class="text-xs text-content-subtle mt-1">To: @string.Join(", ", replyDraft.Recipients)</p>
                                    @if (replyDraft.Cc is { Count: > 0 } replyCc)
                                    {
                                        <p class="text-xs text-content-subtle">CC: @string.Join(", ", replyCc)</p>
                                    }
                                    <p class="text-xs text-content-subtle">Review the recipients and send it from Outlook — nothing has been sent.</p>
                                    @if (!string.IsNullOrWhiteSpace(replyDraft.WebLink))
                                    {
                                        <a href="@replyDraft.WebLink" target="_blank" rel="noopener"
                                           class="text-xs text-accent hover:underline underline-offset-2">Open the draft in Outlook</a>
                                    }
                                </Notice>
                            }
                        }
                    </li>
                }
            </ol>
        }

        @* The composer is its own bounded area, and it takes the warm internal tint the moment
           "Internal only" is ticked — so what you are about to write is visibly the same kind of
           thing as the internal cards above it, before you write it. *@
        <div class="rounded border px-4 py-3 transition-colors @(internalOnly ?"border-warning/40 bg-warning/5" : "border-line bg-surface-raised")">
            @if (error is not null)
            {
                <Notice Tone="Tone.Negative" Class="mb-3">@error</Notice>
            }
            @if (replyToId is not null)
            {
                <p class="mb-2 text-xs text-content-muted">
                    Replying to <span class="font-medium text-content">@replyToAuthor</span> ·
                    <button type="button" class="text-accent hover:underline" @onclick="CancelReply">cancel</button>
                </p>
            }
            <textarea class="field mb-3" rows="3" value="@draft" @oninput="OnDraftInput"
                      placeholder="@(internalOnly ? "Add an internal note — the client and external parties never see this…" : "Add to the conversation…")"></textarea>
            <div class="flex flex-wrap items-center justify-between gap-3">
                <label class="inline-flex items-center gap-2 text-sm text-content-muted cursor-pointer">
                    <input type="checkbox" checked="@internalOnly" @onchange="OnVisibilityChanged" class="rounded border-line-strong" />
                    Internal only (hide from client &amp; external parties)
                </label>
                <button type="button" class="btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(draft))" @onclick="Post">
                    @(busy ? "Posting…" : replyToId is not null ? "Post reply" : internalOnly ? "Post internal note" : "Post message")
                </button>
            </div>
        </div>
    </LoadGate>
    </ChildContent>
</Panel>

