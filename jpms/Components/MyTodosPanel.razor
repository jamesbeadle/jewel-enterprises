@using Jewel.JPMS.Contracts.Todos
@using Jewel.JPMS.Features.Todos
@inject ITodoStore Todos
@inject SessionService Session
@inject AuthService Auth
@inject TodoViewStorage ViewStorage
@inject NavigationManager Nav
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel Projects

@*
    "My to-dos" — the dashboard home panel. Board view (the default) lays the reader's items out
    as Open / Done status columns — drag a card across to tick it off or reopen it (Done capped to
    the most recent few; the full pile is on the /todos page). List view shows the OPEN items only,
    as before. Shows the items assigned to any ROLE the
    signed-in user holds — minus any pinned to a different named person, plus the ones pinned to
    them — general (company-wide) and project items alike, read through ListMyTodoItems (the
    server stamps the roles and email from the session). Rows show only the title;
    clicking one opens the item's own page (/todos/{id}) with the full detail, the linked to-dos
    and communications, and the Mark done action — the API allows a role-holder to update their
    role's items even outside the manage-todos gate. The board's drag is this panel's own tick-off.
    The full list, with filters and done items, lives on the /todos page.
*@

<div class="panel p-5">
    <div class="flex items-center justify-between gap-2 mb-1">
        <div class="flex items-center gap-3">
            <h2 class="text-sm font-semibold text-content">My to-dos</h2>
            @if (!loading && openItems.Count > 0)
            {
                <span class="text-xs text-content-subtle">@openItems.Count open</span>
            }
        </div>
        <div class="flex items-center gap-2">
            @* Board or list — the same per-user preference every to-do surface reads
               (TodoViewStorage), so the idiom follows the reader between screens. *@
            @if (!loading)
            {
                <div class="flex items-center gap-1">
                    <button type="button" class="@ViewTabClass(true)" title="Status board — drag a card between columns to change its status" @onclick="() => SetView(true)">Board</button>
                    <button type="button" class="@ViewTabClass(false)" title="Flat list of open items" @onclick="() => SetView(false)">List</button>
                </div>
                @* Oldest/newest raised first for the open items — the same shared preference as
                   the board/list choice (TodoViewStorage), one rule for the order (TodoSortOrder). *@
                <button type="button" class="chip" title="@TodoSortOrder.Title(newestFirst)" @onclick="ToggleSort">⇅ @TodoSortOrder.Label(newestFirst)</button>
            }
            <a href="/todos" class="text-xs font-medium text-accent hover:underline">View all</a>
        </div>
    </div>
    <p class="text-xs text-content-subtle mb-4">
        Items assigned to your roles or to you by name — general and project to-dos alike. Click
        one for its detail, linked to-dos and communications, and to mark it done.
    </p>

    @if (error is not null)
    {
        <Notice Tone="Tone.Negative" Class="mb-3">@error</Notice>
    }

    @if (!loading && items.Count > 0 && RolesOnPanel.Count > 1)
    {
        @* Only when the reader's items span several roles — one role has nothing to filter. *@
        <div class="mb-3 flex justify-end">
            <select class="field !w-auto text-xs" title="Filter by assigned role"
                    value="@roleFilter" @onchange="e => roleFilter = e.Value?.ToString() ?? string.Empty">
                <option value="">All my roles</option>
                @foreach (var role in RolesOnPanel)
                {
                    <option value="@((int)role)">@role.DisplayName()</option>
                }
            </select>
        </div>
    }

    <LoadGate IsLoading="loading" Prominent="true" Label="Loading your to-dos">
    @if (boardView && items.Count > 0)
    {
        @* Everything on this panel is the reader's own (ListMyTodoItems), and the API lets a
           role-holder tick their role's items off even outside the manage gate — so every card
           drags. The Done column is capped HARD (no Load more): this is a dashboard glance, the
           full pile lives on the To-dos page behind View all. *@
        <TodoBoard Items="@BoardItems" Busy="@busy" Compact="true" DoneCap="6" DoneCapFixed="true"
                   OnOpen="OpenItem"
                   OnSetComplete="args => SetComplete(args.Item, args.IsComplete)"
                   CanDrag="_ => true"
                   Scope="ScopeChipFor" />
    }
    else if (openItems.Count == 0 && (!boardView || items.Count == 0))
    {
        <p class="text-sm text-content-subtle italic">Nothing is assigned to your role right now.</p>
    }
    else if (VisibleOpenItems.Count == 0)
    {
        <p class="text-sm text-content-subtle italic">Nothing open for this role.</p>
    }
    else
    {
        <div class="space-y-2">
            @foreach (var item in VisibleOpenItems)
            {
                <button type="button" @key="item.TodoItemId" title="Open this item"
                        class="w-full rounded border border-line px-3 py-2 text-left hover:border-line-strong hover:bg-surface-raised"
                        @onclick="() => OpenItem(item)">
                    <p class="truncate text-sm text-content">
                        <span class="font-mono text-xs text-content-muted mr-2">@item.Reference</span>@item.Title
                    </p>
                    <div class="mt-1 flex items-center gap-x-3 overflow-hidden text-xs text-content-subtle">
                        <span class="whitespace-nowrap @(IsGeneral(item) ?"text-accent font-medium" : "")">@ScopeLabel(item)</span>
                        @if (item.DueAt is not null)
                        {
                            <span class="whitespace-nowrap @(IsOverdue(item) ?"text-negative font-medium" : "")">Due @DateText(item.DueAt.Value)</span>
                        }
                        <TodoAssigneeBadge Item="item" />
                    </div>
                </button>
            }
        </div>
    }
    </LoadGate>
</div>

@code {
    /// <summary>
    /// Fires with the current OPEN items whenever they change — on the initial load and after a
    /// complete or reassign takes one out of (or back into) the list. RoleHome feeds its
    /// open/overdue to-do count tiles from this, so the strip and the panel are always the same
    /// fetch telling the same story — the tiles never show a figure the rows below contradict.
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyList<TodoItem>> OnOpenItemsChanged { get; set; }

    // Everything assigned to this reader — open and done alike. The board shows both as columns
    // (done capped); the list view and the OnOpenItemsChanged tiles read the open subset below.
    private IReadOnlyList<TodoItem> items = Array.Empty<TodoItem>();
    private IReadOnlyList<TodoItem> openItems = Array.Empty<TodoItem>();
    // Board (the default) or flat open-only list — the shared per-user preference (TodoViewStorage).
    private bool boardView = true;
    // Open items newest raised first (true) or oldest first (false, the default — the server's
    // number order) — the other shared per-user preference. Applied through TodoSortOrder.
    private bool newestFirst;
    // The assigned-role filter ("" = all my roles) — the panel's items are all the reader's own,
    // so unlike the bigger lists there is no Unassigned answer to offer.
    private string roleFilter = "";
    private bool loading = true;
    private bool busy;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var email = Auth.CurrentUser?.Email ?? "";
        boardView = await ViewStorage.ReadBoardAsync(email);
        newestFirst = await ViewStorage.ReadNewestFirstAsync(email);

        // Two independent reads — the list is the panel, the labels dress the rows' scope lines.
        // Neither needs the other, so they run together instead of one waiting behind the last.
        await Task.WhenAll(LoadAsync(), LoadProjectLabelsAsync());
    }

    // Project labels for the rows' scope lines — a failed load degrades the label, never the list.
    private async Task LoadProjectLabelsAsync()
    {
        try { if (Projects.Current is null) await Projects.RefreshAsync(CancellationToken.None); } catch { }
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            items = await Todos.ListMineAsync();
            openItems = items.Where(item => !item.IsComplete).ToList();
            await OnOpenItemsChanged.InvokeAsync(openItems);
        }
        catch { error = "Couldn't load your to-dos right now."; }
        finally { loading = false; }
    }

    // Opening an item is a navigation: everything beyond the row — full detail, linked to-dos,
    // communications, the manage actions — lives on the item's own page.
    private void OpenItem(TodoItem item) => Nav.NavigateTo($"/todos/{item.TodoItemId}");

    // The board's drag onto the other column — this panel's own tick-off (and reopen: done cards
    // are reachable on the board). The list is refetched so the item re-files under its new column
    // with the server's ordering, and the open-items event keeps the dashboard tiles telling the
    // same story.
    private async Task SetComplete(TodoItem item, bool complete)
    {
        if (busy || item.IsComplete == complete) return;
        error = null;
        try
        {
            busy = true;
            await Todos.UpdateAsync(new UpdateTodoItem(
                item.TodoItemId,
                item.Title,
                NullIfBlank(item.Notes),
                item.AssigneeRole,
                item.AssigneePersonEmail,
                item.DueAt,
                complete));
            items = await Todos.ListMineAsync();
            openItems = items.Where(open => !open.IsComplete).ToList();
            await OnOpenItemsChanged.InvokeAsync(openItems);
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        catch { error = "That action didn't complete. Please try again."; }
        finally { busy = false; }
    }

    private static bool IsGeneral(TodoItem item) => string.IsNullOrWhiteSpace(item.ProjectId);

    private string ScopeLabel(TodoItem item)
    {
        if (IsGeneral(item)) return "General";
        var project = (Projects.Current ?? (IReadOnlyList<Project>)Array.Empty<Project>())
            .FirstOrDefault(p => p.ProjectId == item.ProjectId);
        return project is null ? "Project" : $"{project.Reference} — {project.Name}";
    }

    // The role filter's option pool: the roles the reader's items actually span.
    private IReadOnlyList<Role> RolesOnPanel =>
        items.Where(item => item.AssigneeRole is not null)
            .Select(item => item.AssigneeRole!.Value)
            .Distinct()
            .OrderBy(role => role.DisplayName(), StringComparer.OrdinalIgnoreCase)
            .ToList();

    private bool MatchesRoleFilter(TodoItem item) =>
        roleFilter == "" || (int.TryParse(roleFilter, out var value) && item.AssigneeRole == (Role)value);

    // Both views sorted through the one rule: the board's Open column keeps the host's order,
    // so the direction is applied before the items are handed over.
    private IReadOnlyList<TodoItem> BoardItems =>
        TodoSortOrder.Apply(roleFilter == "" ? items : items.Where(MatchesRoleFilter), newestFirst);

    private IReadOnlyList<TodoItem> VisibleOpenItems =>
        TodoSortOrder.Apply(roleFilter == "" ? openItems : openItems.Where(MatchesRoleFilter), newestFirst);

    // The board card's project badge: reference AND name (the ref alone said nothing to anyone
    // not living in the numbering; the board truncates long names, hover for the full label), or
    // the accent "Company" chip for a no-project item.
    private TodoBoard.ScopeChip ScopeChipFor(TodoItem item)
    {
        if (IsGeneral(item)) return new TodoBoard.ScopeChip("Company", "Company-wide — no project", true);
        var project = (Projects.Current ?? (IReadOnlyList<Project>)Array.Empty<Project>())
            .FirstOrDefault(p => p.ProjectId == item.ProjectId);
        return project is null
            ? new TodoBoard.ScopeChip("Project", "Project", false)
            : new TodoBoard.ScopeChip($"{project.Reference} — {project.Name}", $"{project.Reference} — {project.Name}", false);
    }

    private string ViewTabClass(bool board) =>
        boardView == board
            ? "chip chip-active"
            : "chip";

    private async Task SetView(bool board)
    {
        if (boardView == board) return;
        boardView = board;
        await ViewStorage.WriteAsync(Auth.CurrentUser?.Email ?? "", board);
    }

    private async Task ToggleSort()
    {
        newestFirst = !newestFirst;
        await ViewStorage.WriteNewestFirstAsync(Auth.CurrentUser?.Email ?? "", newestFirst);
    }

    private static bool IsOverdue(TodoItem item) =>
        !item.IsComplete && item.DueAt is not null && item.DueAt.Value < DateTimeOffset.Now.Date;

    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
