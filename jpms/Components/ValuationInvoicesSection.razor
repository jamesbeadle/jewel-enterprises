@using static Jewel.JPMS.Features.Commercial.ValuationInvoiceDisplay
@inject IValuationInvoiceStore Invoices
@inject SessionService Session

@* Valuation invoices (formerly Cash Calls) live inside the Valuation Report as one more
   accordion. Issued invoices drive "Certified to date" — and so the payment due — in the
   report summary; the total is reported up via OnInvoicedToDateChanged.

   Lifecycle: Raised (accounts raise it from the claim card once the project team has locked
   the claim — a draft; the raise froze the report snapshot) → Submitted (the claim recorded
   as sent to the architect/client — the portal emails nothing) → Approved → Issued → Paid,
   with Rejected returning an invoice for amendment or cancellation, and a Submitted/Raised →
   Issued skip path for projects without a formal approval loop. An invoice added below also
   starts Raised. Manual entries are backdated historic invoices recorded directly as
   Issued/Paid. The claim card on the valuation page drives the happy path; this section's
   row menu covers the same moves plus the edge cases. *@
<div class="panel overflow-hidden">
    <div class="w-full flex items-center gap-3 px-4 py-3 hover:bg-surface-raised/60 transition">
        <button type="button" @onclick="Toggle" aria-expanded="@isOpen"
                class="flex items-center gap-3 text-left grow min-w-0">
            <svg class="@(isOpen ?"w-4 h-4 shrink-0 text-content-subtle rotate-90 transition-transform" : "w-4 h-4 shrink-0 text-content-subtle transition-transform")"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 6l6 6-6 6" />
            </svg>
            <span class="font-semibold text-content whitespace-nowrap">Valuation Invoices</span>
            <span class="text-xs text-content-subtle whitespace-nowrap">
                @LiveInvoices.Count @(LiveInvoices.Count == 1 ? "invoice" : "invoices")
            </span>
        </button>
        <span class="flex items-baseline gap-6 whitespace-nowrap">
            @if (AwaitingApproval > 0)
            {
                <span class="text-sm">
                    <span class="eyebrow mr-1.5">Awaiting approval</span>
                    <span class="text-content-muted">@Money(AwaitingApproval)</span>
                </span>
            }
            <span class="text-sm">
                <span class="eyebrow mr-1.5">Paid</span>
                <span class="text-content-muted">@Money(TotalPaid)</span>
            </span>
            <span class="text-sm">
                <span class="eyebrow mr-1.5">Invoiced</span>
                <span class="text-content font-medium">@Money(InvoicedToDate)</span>
            </span>
        </span>
        <ExportToExcelButton FileName="Valuation invoices" Disabled="@(invoices.Count == 0)" BuildWorkbook="BuildExportWorkbook" />
    </div>

    @if (isOpen)
    {
        @if (error is not null)
        {
            <p class="border-t border-line bg-negative/10 px-4 py-2 text-sm text-negative">@error</p>
        }

        @if (invoices.Count == 0)
        {
            <div class="border-t border-line px-4 py-5 text-center text-content-subtle italic text-sm">
                No valuation invoices yet. Add one below — once issued it counts toward certified to date.
            </div>
        }
        else
        {
            @* The scroll cap is lifted while a row's Actions menu is open: the menu positions
               absolutely inside this container, so with the overflow active its bottom entries
               (History, Delete…) are clipped at the table's edge — on a short table that hid
               Delete entirely. Short lists render identically either way; a long list grows to
               full height for the moment the menu is showing and gets its cap back on close. *@
            <div class="border-t border-line @(openMenuId is null ?"overflow-x-auto overflow-y-auto max-h-[85vh]" : "")">
                <table class="data-table data-table-dense">
                    <thead>
                        <tr>
                            <th class="w-[100px]">Ref</th>
                            <th class="whitespace-nowrap">Period</th>
                            <th class="text-right whitespace-nowrap">Amount £</th>
                            <th class="whitespace-nowrap">Status</th>
                            <th class="text-right whitespace-nowrap">Paid £</th>
                            <th class="whitespace-nowrap">Report</th>
                            @if (CanManage)
                            {
                                <th class="text-right w-[110px]"></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in invoices)
                        {
                            <tr class="@(invoice.Status == ValuationInvoiceStatus.Cancelled ?"opacity-50" : "")">
                                <td class="font-mono text-xs text-content-subtle whitespace-nowrap">
                                    @invoice.DisplayNumber
                                    @if (invoice.IsManual)
                                    {
                                        <Pill Tone="Tone.Muted" Class="ml-1" Title="Historic entry keyed in manually — counts toward certified to date and total paid">Manual</Pill>
                                    }
                                </td>
                                <td class="whitespace-nowrap">@invoice.PeriodMonth.ToString("MMM yyyy")</td>
                                <td class="text-right text-content whitespace-nowrap">@Money(invoice.Amount)</td>
                                <td class="whitespace-nowrap">
                                    <Pill Tone="@invoice.Status.ToTone()" Title="@StatusTitle(invoice)">@StatusLabel(invoice.Status)</Pill>
                                </td>
                                <td class="text-right whitespace-nowrap">@(invoice.AmountPaid > 0 ? Money(invoice.AmountPaid) : "—")</td>
                                <td class="whitespace-nowrap">
                                    @if (invoice.ValuationReportSnapshotId is not null)
                                    {
                                        <button type="button" @onclick="() => OnViewSnapshot.InvokeAsync(invoice.ValuationReportSnapshotId)"
                                                title="The valuation report frozen when this invoice was submitted/issued"
                                                class="text-content-subtle hover:text-content underline underline-offset-2 text-xs">View report</button>
                                    }
                                    else
                                    {
                                        <span class="text-content-subtle text-xs">—</span>
                                    }
                                </td>
                                @if (CanManage)
                                {
                                    <td class="text-right whitespace-nowrap">
                                        @* One menu per row instead of a run of text links — the
                                           stage decides which moves it offers. Delete keeps its
                                           two-step confirm: choosing it swaps the menu for an
                                           inline Confirm delete / Keep pair. *@
                                        @if (pendingDeleteId == invoice.ValuationInvoiceId)
                                        {
                                            <button type="button" disabled="@busy" @onclick="() => DeleteAsync(invoice)"
                                                    class="text-negative underline underline-offset-2 text-xs font-medium">Confirm delete</button>
                                            <button type="button" disabled="@busy" @onclick="() => pendingDeleteId = null"
                                                    class="ml-1.5 text-content-subtle hover:text-content underline underline-offset-2 text-xs">Keep</button>
                                        }
                                        else
                                        {
                                            <DropdownMenu Label="Actions" WidthClass="w-64" Disabled="@busy"
                                                          ToggleClass="inline-flex items-center gap-1 rounded border border-line bg-surface px-2.5 py-1 text-xs text-content-muted hover:border-line-strong transition"
                                                          Class="inline-block text-left"
                                                          OnOpenChanged="open => openMenuId = open ? invoice.ValuationInvoiceId : (openMenuId == invoice.ValuationInvoiceId ? null : openMenuId)"
                                                          Items="InvoiceMenuItems(invoice)" />
                                        }
                                    </td>
                                }
                            </tr>
                            @if (invoice.Status == ValuationInvoiceStatus.Rejected && !string.IsNullOrWhiteSpace(invoice.RejectionReason))
                            {
                                <tr>
                                    <td colspan="@ColumnCount" class="bg-negative/5 text-xs text-negative">
                                        Rejected@(invoice.RejectedAt is { } r ? $" {r:dd MMM yyyy}" : ""): @invoice.RejectionReason
                                    </td>
                                </tr>
                            }
                            @if (historyOpenId == invoice.ValuationInvoiceId)
                            {
                                <tr>
                                    <td colspan="@ColumnCount" class="bg-surface-raised/60">
                                        @if (historyEvents is null)
                                        {
                                            <span class="text-xs text-content-subtle italic">Loading history…</span>
                                        }
                                        else if (historyEvents.Count == 0)
                                        {
                                            <span class="text-xs text-content-subtle italic">No history recorded for this invoice.</span>
                                        }
                                        else
                                        {
                                            <ul class="space-y-1">
                                                @foreach (var entry in historyEvents)
                                                {
                                                    <li class="text-xs text-content-muted">
                                                        <span class="font-mono text-content-subtle">@DateTimeText(entry.OccurredAt)</span>
                                                        <span class="ml-2 font-medium text-content">@EventLabel(entry.EventType)</span>
                                                        @if (entry.AmountBefore is not null && entry.AmountAfter is not null && entry.AmountBefore != entry.AmountAfter)
                                                        {
                                                            <span class="ml-2">@Money(entry.AmountBefore.Value) → @Money(entry.AmountAfter.Value)</span>
                                                        }
                                                        else if (entry.AmountAfter is not null)
                                                        {
                                                            <span class="ml-2">@Money(entry.AmountAfter.Value)</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(entry.Note))
                                                        {
                                                            <span class="ml-2 text-content-subtle">— @entry.Note</span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (CanManage)
        {
            <div class="border-t border-line px-4 py-3 flex flex-wrap items-end gap-3">
                <div>
                    <FormField Label="Period month">
                    @* Explicit value/@onchange rather than @bind: Razor special-cases @bind on
                       type="month" to expect a DateTime, but the month travels as a "yyyy-MM"
                       string (see ParseMonth). *@
                    <input type="month" value="@newMonth" @onchange="e => newMonth = e.Value?.ToString() ?? newMonth"
                           class="field" />
                    </FormField>
                </div>
                <div>
                    <FormField Label="Amount £">
                    <input type="number" step="any" min="0" @bind="newAmount"
                           class="field w-40" />
                    </FormField>
                </div>
                <label class="flex items-center gap-2 text-sm text-content-subtle cursor-pointer select-none pb-2.5"
                       title="Backdated historic entry: recorded directly as issued (and paid, if a paid amount is given) so it counts toward certified to date immediately">
                    <input type="checkbox" class="cursor-pointer align-middle" @bind="newIsHistoric" />
                    Historic entry
                </label>
                @if (newIsHistoric)
                {
                    <div>
                        <FormField Label="Paid £ (blank = full, 0 = unpaid)">
                        <input type="number" step="any" min="0" @bind="newPaidAmount" placeholder="Full amount"
                               class="field w-36" />
                        </FormField>
                    </div>
                    <div>
                        <FormField Label="Note (optional)">
                        <input type="text" @bind="newNote" placeholder="e.g. old system ref"
                               class="field w-48" />
                        </FormField>
                    </div>
                }
                <button type="button" disabled="@busy" @onclick="AddAsync"
                        class="btn-primary">
                    @(newIsHistoric ? "Add historic invoice" : "Add invoice")
                </button>
            </div>
        }
    }
</div>

<Modal IsOpen="paymentInvoice is not null"
       Title="Record client payment"
       ConfirmLabel="@(busy ? "Saving…" : "Record payment")"
       OnCancel="() => paymentInvoice = null"
       OnConfirm="RecordPaymentAsync"
       Class="max-w-md">
    <div class="space-y-3">
        @if (paymentInvoice is not null)
        {
            <p class="text-sm text-content">
                Payment received against <span class="font-mono">@paymentInvoice.DisplayNumber</span>
                (invoiced @Money(paymentInvoice.Amount)).
            </p>
        }
        <FormField Label="Amount received (£)" Value="@paymentAmount" OnChange="v => paymentAmount = v" InputType="number" />
    </div>
</Modal>

<Modal IsOpen="rejectInvoice is not null"
       Title="Reject valuation invoice"
       ConfirmLabel="@(busy ? "Saving…" : "Reject")"
       OnCancel="() => rejectInvoice = null"
       OnConfirm="RejectAsync"
       Class="max-w-md">
    <div class="space-y-3">
        @if (rejectInvoice is not null)
        {
            <p class="text-sm text-content">
                Record the client's rejection of <span class="font-mono">@rejectInvoice.DisplayNumber</span>.
                The invoice unlocks for amendment or cancellation.
            </p>
        }
        <FormField Label="Reason (required)" Value="@rejectReason" OnChange="v => rejectReason = v" />
    </div>
</Modal>

<Modal IsOpen="editInvoice is not null"
       Title="@(editInvoice?.Status == ValuationInvoiceStatus.Rejected ? "Amend valuation invoice" : "Edit valuation invoice")"
       ConfirmLabel="@(busy ? "Saving…" : "Save")"
       OnCancel="() => editInvoice = null"
       OnConfirm="SaveEditAsync"
       Class="max-w-md">
    <div class="space-y-3">
        @if (editInvoice is not null)
        {
            @if (editInvoice.Status == ValuationInvoiceStatus.Rejected)
            {
                <p class="text-sm text-content">
                    Amending <span class="font-mono">@editInvoice.DisplayNumber</span> returns it to
                    draft — record the claim as sent again and a fresh report snapshot freezes for the client.
                </p>
            }
            <div>
                <FormField Label="Period month">
                <input type="month" value="@editMonth" @onchange="e => editMonth = e.Value?.ToString() ?? editMonth"
                       class="field" />
                </FormField>
            </div>
            <FormField Label="Amount (£)" Value="@editAmount" OnChange="v => editAmount = v" InputType="number" />
            @if (editInvoice.IsManual)
            {
                <FormField Label="Paid amount (£) — blank or 0 = not paid" Value="@editPaidAmount" OnChange="v => editPaidAmount = v" InputType="number" />
            }
            <FormField Label="Note (optional)" Value="@editNote" OnChange="v => editNote = v" />
        }
    </div>
</Modal>

