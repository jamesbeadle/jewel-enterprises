@inject IDrawingStore DrawingStore

@*
    The data view for one drawing revision: the portal's own read of the PDF — title block,
    the scale the sheet proved, every figured dimension with its drawn line, the notes and
    callouts with their positions, the closed shapes with their real sizes — then the Bluebeam
    markups if that connection read any, and the raw text layer last. Status is re-read by hand —
    the Refresh button, not a polling loop (the codebase has none, deliberately); a queued run
    typically lands within a minute. The fetch is uncached because this panel IS the status check.
*@

@if (RevisionId is not null)
{
    <Panel Title="Extracted data" Class="mt-6" IsLoading="@(isLoading && view is null && !loadFailed)" LoadingLabel="Checking extraction">
        <HeaderActions>
            @if (view is not null)
            {
                <button type="button" class="btn-secondary" disabled="@isLoading" @onclick="RefreshAsync">
                    @(isLoading ? "Refreshing…" : "Refresh")
                </button>
            }
        </HeaderActions>
        <ChildContent>
        @if (loadFailed)
        {
            <Notice Tone="Tone.Negative">The extraction status couldn't be loaded — try Refresh.</Notice>
        }
        else if (view is null)
        {
            <EmptyState Message="@(CanManage
                ? "No data has been extracted from this revision yet. Use “Extract data” above to read the sheet — its title block, scale, dimensions, notes and shapes — into the portal."
                : "No data has been extracted from this revision yet.")" />
        }
        else
        {
            var extraction = view.Extraction;
            @if (extraction.Status is DrawingExtractionStatus.Queued or DrawingExtractionStatus.Running)
            {
                <p class="text-sm text-content">
                    @(extraction.Status == DrawingExtractionStatus.Queued ? "Queued for extraction" : "Extracting now")
                    — queued by @extraction.QueuedBy, @extraction.QueuedAt.ToLocalTime().ToString("HH:mm").
                    Refresh to see where it's up to.
                </p>
            }
            else if (extraction.Status == DrawingExtractionStatus.Failed)
            {
                <Notice Tone="Tone.Negative">
                    The extraction failed@(extraction.ErrorMessage is { Length: > 0 } error ? $": {error}" : ".")
                </Notice>
                @if (CanManage)
                {
                    <div class="mt-3">
                        <button type="button" class="btn-secondary" disabled="@requeueBusy" @onclick="TryAgainAsync">
                            @(requeueBusy ? "Queueing…" : "Try again")
                        </button>
                    </div>
                }
                @if (requeueError is not null)
                {
                    <p class="mt-2 text-sm text-negative">@requeueError</p>
                }
            }
            else
            {
                var structure = view.Structure;
                var scale = structure?.Scales.FirstOrDefault(row => row.MmPerPoint is not null);
                <p class="text-xs text-content-subtle mb-4">
                    Extracted @DateTimeText(extraction.CompletedAt)
                    · @(extraction.PageCount ?? 0) page(s)
                    · @(extraction.DimensionCount ?? 0) dimension(s)
                    · @(extraction.CalloutCount ?? 0) note(s)
                    · @(extraction.ShapeCount ?? 0) shape(s)
                    · @(extraction.MarkupCount is { } markupCount ? $"{markupCount} Revu markup(s)" : "no Revu markups")
                </p>

                @if (structure is not null)
                {
                    @foreach (var warning in structure.Warnings)
                    {
                        <Notice Tone="Tone.Warning" Class="mb-3">@warning</Notice>
                    }

                    <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-4">
                        <StatTile Label="Drawing no." Value="@(structure.TitleBlock.DrawingNumber ?? "—")" />
                        <StatTile Label="Revision" Value="@(extraction.RevisionLabel ?? "—")" />
                        <StatTile Label="Scale">
                            <p class="text-xl font-medium text-content">@(extraction.Scale ?? "—")</p>
                            @if (scale is not null)
                            {
                                <p class="text-xs font-medium mt-1 @(scale.Verified ? "text-positive" : "text-warning")">
                                    @(scale.Verified
                                        ? $"{(scale.Inferred ? "Inferred" : "Proven")} by {scale.LabelsMatched} of {scale.LabelsChecked} figured dimensions"
                                        : $"Unverified — {scale.LabelsMatched} of {scale.LabelsChecked} figures matched")
                                </p>
                            }
                        </StatTile>
                        <StatTile Label="Date" Value="@(structure.TitleBlock.Date ?? "—")" />
                        <StatTile Label="Drawn by" Value="@(structure.TitleBlock.DrawnBy ?? "—")" />
                    </div>

                    <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm mb-4">
                        @if (structure.TitleBlock.Title is { Length: > 0 } title)
                        {
                            <dt class="eyebrow">Title</dt><dd class="text-content">@title</dd>
                        }
                        @if (structure.TitleBlock.Job is { Length: > 0 } job)
                        {
                            <dt class="eyebrow">Job</dt><dd class="text-content">@job</dd>
                        }
                        @if (structure.TitleBlock.Client is { Length: > 0 } client)
                        {
                            <dt class="eyebrow">Client</dt><dd class="text-content">@client</dd>
                        }
                    </dl>

                    @if (structure.Revisions.Count > 0)
                    {
                        <SectionHeader Title="@($"Revisions ({structure.Revisions.Count})")" />
                        <div class="overflow-x-auto mt-2 mb-2">
                            <table class="data-table data-table-dense">
                                <thead>
                                    <tr><th class="w-12">Rev</th><th class="w-28">Date</th><th class="w-16">By</th><th>Comment</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in RevisionRows(structure))
                                    {
                                        <tr>
                                            <td class="text-content">@row.Id</td>
                                            <td>@row.Date</td>
                                            <td>@row.By</td>
                                            <td class="text-content whitespace-pre-wrap">@row.Comment</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (structure.Revisions.Count > RevisionPreview)
                        {
                            <button type="button" class="btn-ghost mb-4" @onclick="() => allRevisions = !allRevisions">
                                @(allRevisions ? "Show latest only" : $"Show all {structure.Revisions.Count} revisions")
                            </button>
                        }
                    }

                    <div class="flex flex-wrap gap-2 border-t border-line pt-3">
                        <button type="button" class="btn-ghost" @onclick="() => dimensionsOpen = !dimensionsOpen">
                            @(dimensionsOpen ? "Hide dimensions" : $"Dimensions ({structure.Dimensions.Count})")
                        </button>
                        <button type="button" class="btn-ghost" @onclick="() => calloutsOpen = !calloutsOpen">
                            @(calloutsOpen ? "Hide notes" : $"Notes & callouts ({structure.Callouts.Count})")
                        </button>
                        <button type="button" class="btn-ghost" @onclick="() => shapesOpen = !shapesOpen">
                            @(shapesOpen ? "Hide shapes" : $"Shapes ({structure.Shapes.Count})")
                        </button>
                        <button type="button" class="btn-ghost" @onclick="() => markupsOpen = !markupsOpen">
                            @(markupsOpen ? "Hide Revu markups" : $"Revu markups ({view.Markups.Count})")
                        </button>
                        <button type="button" class="btn-ghost" @onclick="() => textOpen = !textOpen">
                            @(textOpen ? "Hide text layer" : $"Text layer ({view.TextPages.Count} page(s))")
                        </button>
                    </div>

                    @if (dimensionsOpen)
                    {
                        <p class="text-xs text-content-subtle mt-3 mb-2">
                            Each figure paired with the drawn line it measures. Positions are real-world millimetres from the sheet's bottom-left corner; the figure, not the drawn length, is the dimension to use.
                        </p>
                        <div class="overflow-x-auto max-h-96 overflow-y-auto">
                            <table class="data-table data-table-dense">
                                <thead>
                                    <tr><th class="text-right">Figure (mm)</th><th>Axis</th><th>From (x, y)</th><th>To (x, y)</th><th>Page</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var dimension in structure.Dimensions.OrderByDescending(row => row.ValueMm))
                                    {
                                        <tr>
                                            <td class="text-right text-content">@dimension.ValueMm.ToString("N0")</td>
                                            <td>@dimension.Axis</td>
                                            <td>@Point(dimension.From)</td>
                                            <td>@Point(dimension.To)</td>
                                            <td>@dimension.Page</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (calloutsOpen)
                    {
                        <div class="mt-3 max-h-96 overflow-y-auto">
                            @if (structure.Callouts.Count == 0)
                            {
                                <EmptyState Message="No notes or callouts were read from this sheet." />
                            }
                            @foreach (var callout in structure.Callouts)
                            {
                                <div class="py-2 border-t border-line text-sm">
                                    <span class="text-xs text-content-subtle mr-2">@Point(callout.At)</span>
                                    <span class="text-content">@callout.Text</span>
                                </div>
                            }
                        </div>
                    }

                    @if (shapesOpen)
                    {
                        <p class="text-xs text-content-subtle mt-3 mb-2">
                            Closed outlines on the sheet, largest first — a pad, a slab, a chamber. Curved outlines are read as straight chords, so their area is approximate.
                        </p>
                        <div class="overflow-x-auto max-h-96 overflow-y-auto">
                            <table class="data-table data-table-dense">
                                <thead>
                                    <tr><th class="text-right">Width (mm)</th><th class="text-right">Height (mm)</th><th class="text-right">Perimeter (m)</th><th class="text-right">Area (m²)</th><th>Kind</th><th>Centre (x, y)</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var shape in structure.Shapes)
                                    {
                                        <tr>
                                            <td class="text-right text-content">@shape.WidthMm.ToString("N0")</td>
                                            <td class="text-right text-content">@shape.HeightMm.ToString("N0")</td>
                                            <td class="text-right">@((shape.PerimeterMm / 1000).ToString("N2"))</td>
                                            <td class="text-right">@shape.AreaSqM.ToString("N2")</td>
                                            <td>@(shape.IsRectangle ? "Rectangle" : shape.HasCurves ? $"{shape.PointCount}-point, curved" : $"{shape.PointCount}-point")</td>
                                            <td>@Point(shape.Centre)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else
                {
                    <Notice Tone="Tone.Warning" Class="mb-3">
                        This revision was extracted before the portal read drawings itself — only the text layer@(view.Markups.Count > 0 ? " and Revu markups" : "") are held. Extract again to read its title block, scale, dimensions, notes and shapes.
                    </Notice>
                    <div class="flex flex-wrap gap-2 border-t border-line pt-3">
                        <button type="button" class="btn-ghost" @onclick="() => markupsOpen = !markupsOpen">
                            @(markupsOpen ? "Hide Revu markups" : $"Revu markups ({view.Markups.Count})")
                        </button>
                        <button type="button" class="btn-ghost" @onclick="() => textOpen = !textOpen">
                            @(textOpen ? "Hide text layer" : $"Text layer ({view.TextPages.Count} page(s))")
                        </button>
                    </div>
                }

                @if (markupsOpen)
                {
                    @if (view.Markups.Count == 0)
                    {
                        <p class="text-sm text-content-muted mt-3">
                            @(extraction.MarkupsNote ?? "No markups on this revision — nobody has measured or annotated it in Revu.")
                        </p>
                    }
                    else
                    {
                        <div class="overflow-x-auto mt-3">
                            <table class="data-table data-table-dense">
                                <thead>
                                    <tr><th>Page</th><th>Type</th><th>Subject</th><th>Author</th><th>Comment</th><th>Measurement</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var markup in view.Markups)
                                    {
                                        <tr class="align-top">
                                            <td>@markup.PageNumber</td>
                                            <td class="text-content">@markup.MarkupType</td>
                                            <td class="text-content">@markup.Subject</td>
                                            <td>@markup.Author</td>
                                            <td class="text-content whitespace-pre-wrap max-w-md">@markup.Comment</td>
                                            <td>@(markup.MeasurementValue is { } value ? $"{value:0.####} {markup.MeasurementUnit}" : "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }

                @if (textOpen)
                {
                    @* Loop variable deliberately NOT named "page" — bare @page in markup
                       parses as the page directive (the same family as the @code trap). *@
                    @foreach (var textPage in view.TextPages)
                    {
                        <div class="mt-3">
                            <p class="eyebrow mb-1">Page @textPage.Page</p>
                            @if (string.IsNullOrWhiteSpace(textPage.Text))
                            {
                                <p class="text-xs text-content-subtle italic">
                                    No embedded text on this page — likely a scanned or purely graphical sheet.
                                </p>
                            }
                            else
                            {
                                <pre class="text-xs text-content whitespace-pre-wrap bg-surface-raised rounded border border-line p-3 max-h-72 overflow-y-auto">@textPage.Text</pre>
                            }
                        </div>
                    }
                }
            }
        }
        </ChildContent>
    </Panel>
}

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public string DrawingId { get; set; } = "";
    [Parameter] public string? RevisionId { get; set; }
    [Parameter] public bool CanManage { get; set; }

    private const int RevisionPreview = 5;

    private DrawingExtractionView? view;
    private bool isLoading;
    private bool loadFailed;
    private bool requeueBusy;
    private string? requeueError;
    private bool allRevisions;
    private bool dimensionsOpen;
    private bool calloutsOpen;
    private bool shapesOpen;
    private bool markupsOpen;
    private bool textOpen;
    private string? loadedRevisionId;

    protected override async Task OnParametersSetAsync()
    {
        if (RevisionId is null || RevisionId == loadedRevisionId) return;
        loadedRevisionId = RevisionId;
        view = null;
        allRevisions = dimensionsOpen = calloutsOpen = shapesOpen = markupsOpen = textOpen = false;
        await RefreshAsync();
    }

    public async Task RefreshAsync()
    {
        if (RevisionId is null) return;
        var requestedRevisionId = RevisionId;
        loadFailed = false;
        isLoading = true;
        try
        {
            var fetched = await DrawingStore.GetExtractionAsync(requestedRevisionId, CancellationToken.None);
            // The previewed revision can change while the fetch is in flight — a stale response
            // must not land under the new revision's heading.
            if (RevisionId != requestedRevisionId) return;
            view = fetched;
        }
        catch
        {
            if (RevisionId == requestedRevisionId) loadFailed = true;
        }
        finally { isLoading = false; }
        StateHasChanged();
    }

    private async Task TryAgainAsync()
    {
        if (RevisionId is null || requeueBusy) return;
        requeueError = null;
        try
        {
            requeueBusy = true;
            await DrawingStore.QueueExtractionAsync(ProjectId, DrawingId, RevisionId, CancellationToken.None);
            await RefreshAsync();
        }
        catch (Jewel.JPMS.Cqrs.CommandFailedException ex) { requeueError = ex.Message; }
        catch { requeueError = "Queueing didn't complete. Please try again."; }
        finally { requeueBusy = false; }
    }

    // Latest revisions first; the sheet lists them oldest-first.
    private IEnumerable<DrawingRevisionNote> RevisionRows(DrawingStructure structure)
    {
        var latestFirst = structure.Revisions.Reverse();
        return allRevisions ? latestFirst : latestFirst.Take(RevisionPreview);
    }

    private static string Point(DrawingPoint point) => $"{point.X:N0}, {point.Y:N0}";
}
