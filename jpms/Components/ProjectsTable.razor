@inject NavigationManager Nav

<div class="panel overflow-hidden">
    <div class="overflow-x-auto overflow-y-auto max-h-[85vh]">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Reference</th>
                    <th>Name</th>
                    <th class="hidden md:table-cell">Client</th>
                    <th class="hidden lg:table-cell">Entity</th>
                    <th>Stage</th>
                    <th class="text-right">Next valuation</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in Projects)
                {
                    <tr class="is-clickable" @onclick="() => OpenProject(project)">
                        <td class="font-mono text-xs">@project.Reference</td>
                        <td class="text-content font-medium">@project.Name</td>
                        <td class="hidden md:table-cell">@project.ClientName</td>
                        <td class="hidden lg:table-cell">@project.Organisation.ShortCode()</td>
                        <td><ProjectStageBadge Stage="project.Stage" /></td>
                        <td class="text-right whitespace-nowrap"><ValuationDueBadge Project="project" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Project> Projects { get; set; } = Array.Empty<Project>();

    // Where a row lands. Unset, the bare project URL — the role's default first tab. A list
    // shown FOR a reason (the overdue-valuations filter) sets this to the page where that work
    // gets done, so the reader arrives on the record they came for rather than the default tab.
    [Parameter] public Func<Project, string>? RowHref { get; set; }

    private void OpenProject(Project project) =>
        Nav.NavigateTo(RowHref?.Invoke(project) ?? $"/projects/{project.ProjectId}");
}
