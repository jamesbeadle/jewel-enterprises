@using Jewel.JPMS.Contracts.Projects
@using Jewel.JPMS.Features.Projects
@inject SessionService Session
@inject ICommandSender Commands
@inject ProjectListReadModel Projects
@inject IClientStore ClientStore
@inject IArchitectStore ArchitectStore
@inject ISubcontractorStore Subcontractors
@inject NavigationManager Nav

@*
    "Edit details" button + modal for a project's core details (reference, name, client, entity,
    stage, project manager). Sends the existing UpdateProjectDetails command and refreshes the
    project list read model, so the page header, stage badge and Overview stats update in place.
    Server-side the command is gated to directors, the finance director and project managers; the
    button mirrors that.

    The danger zone at the very bottom deletes the project outright (directors and the finance
    director only, mirroring DeleteProjectAuthorisation). Arming it reveals a type-the-name confirm:
    the red button stays disabled until the typed text matches the project's SAVED name — the saved
    one, not the editable Name field above, so half-editing the name can't loosen the check. The
    server re-checks the same match before deleting anything.
*@

@if (CanEdit)
{
    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="Open">Edit details</button>

    <Modal IsOpen="@open" Title="Edit project details" ConfirmLabel="@(busy ? "Saving…" : "Save changes")"
           ConfirmDisabled="@deleteBusy" CancelLabel="Cancel" OnConfirm="Save" OnCancel="Close">
        <div class="space-y-3">
            @if (error is not null)
            {
                <Notice Tone="Tone.Negative">@error</Notice>
            }

            <FormField Label="Reference" Value="@reference" OnChange="v => reference = v" Required="true" />
            <FormField Label="Project name" Value="@name" OnChange="v => name = v" Required="true" />
            <FormField Label="Client" Value="@clientName" OnChange="v => clientName = v" Required="true" />

            <div>
                <FormField Label="Corresponds with" Hint="The party project emails are addressed to — a client account directly, or an architect acting on the client's behalf. The free-text client above stays the display name on documents.">
                <select class="field" value="@partySelection" @onchange="OnPartyChanged">
                    <option value="">— Not assigned —</option>
                    @if (clients.Count > 0)
                    {
                        <optgroup label="Clients">
                            @foreach (var client in clients)
                            {
                                <option value="@($"{ClientPrefix}{client.ClientId}")">@client.Name</option>
                            }
                        </optgroup>
                    }
                    @if (architects.Count > 0)
                    {
                        <optgroup label="Architects">
                            @foreach (var architect in architects)
                            {
                                <option value="@($"{ArchitectPrefix}{architect.ArchitectId}")">@architect.Name</option>
                            }
                        </optgroup>
                    }
                </select>
                </FormField>
            </div>

            @if (partySelection.StartsWith(ArchitectPrefix, StringComparison.Ordinal))
            {
                <div>
                    <FormField Label="On behalf of client" Hint="Optional: the client this architect is acting for.">
                    <select class="field" value="@onBehalfOfClientId" @onchange="OnOnBehalfOfClientChanged">
                        <option value="">— Not recorded —</option>
                        @foreach (var client in clients)
                        {
                            <option value="@client.ClientId">@client.Name</option>
                        }
                    </select>
                    </FormField>
                </div>
            }

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <FormField Label="Entity" Required>
                    <select class="field" value="@organisation" @onchange="OnOrganisationChanged">
                        @foreach (var option in AllOrganisations)
                        {
                            <option value="@option">@option.DisplayName()</option>
                        }
                    </select>
                    </FormField>
                </div>
                <div>
                    <FormField Label="Stage" Required>
                    <select class="field" value="@stage" @onchange="OnStageChanged">
                        @foreach (var option in AllStages)
                        {
                            <option value="@option">@option.DisplayName()</option>
                        }
                    </select>
                    </FormField>
                </div>
            </div>

            <FormField Label="Project manager email" Value="@projectManagerEmail" OnChange="v => projectManagerEmail = v" InputType="email" Required="true" />

            <FormField Label="Site address" Value="@addressLine" OnChange="v => addressLine = v" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <FormField Label="Town" Value="@town" OnChange="v => town = v" />
                <FormField Label="Postcode" Value="@postcode" OnChange="v => postcode = v" />
            </div>
            <p class="text-xs text-content-subtle">Town and postcode power "Find subcontractors" on bid packages — local companies are searched near the site.</p>

            <FormField Label="Xero site (tracking option)" Value="@xeroSiteName" OnChange="v => xeroSiteName = v" />
            <p class="text-xs text-content-subtle">
                The project's option in Xero's "Sites" tracking category, exactly as named in Xero
                (e.g. "21 Chetwode Road"). Required before allocated draft invoices can be confirmed
                and approved back into Xero from the cost allocation screen.
            </p>

            @* The Xero customer the project's sales invoices are raised on (2026-09-10): picked from
               Xero's own contacts so the id is always Xero's — never typed, never matched by name.
               Disabled with a "Loading…" option until the list lands (never gate a control); a
               mapped contact missing from the fetched list is still offered so saving cannot lose it. *@
            <FormField Label="Xero contact"
                       Hint="The Xero customer the project's sales invoices are raised on. Raise in Xero is blocked until this is set."
                       Error="@xeroContactsError">
                @if (xeroContacts is null)
                {
                    <select class="field" disabled>
                        <option value="">Loading…</option>
                    </select>
                }
                else
                {
                    <select class="field" value="@xeroContactId" @onchange="OnXeroContactChanged">
                        <option value="">Not mapped</option>
                        @if (xeroContactId.Length > 0 && xeroContacts.All(contact => contact.ContactId != xeroContactId))
                        {
                            <option value="@xeroContactId">@(xeroContactName.Length > 0 ? xeroContactName : xeroContactId) (not in the Xero list)</option>
                        }
                        @foreach (var contact in xeroContacts)
                        {
                            <option value="@contact.ContactId">@contact.Name</option>
                        }
                    </select>
                }
            </FormField>

            @if (CanDelete)
            {
                <div class="mt-4 pt-4 border-t border-line">
                    <p class="text-sm font-medium text-negative mb-1.5">Danger zone</p>
                    @if (!deleteArmed)
                    {
                        <div class="flex items-start justify-between gap-3">
                            <p class="text-xs text-content-subtle">
                                Permanently delete this project and every record filed under it —
                                requests, variations, valuations, programme and financial history.
                                This cannot be undone.
                            </p>
                            <button type="button"
                                    class="btn-neutral text-xs px-2.5 py-1.5 border-negative/40 text-negative hover:border-negative shrink-0"
                                    disabled="@busy" @onclick="ArmDelete">Delete project…</button>
                        </div>
                    }
                    else
                    {
                        <p class="text-xs text-content-subtle mb-2">
                            This permanently deletes
                            <span class="font-semibold text-content">@savedName</span>
                            and every record filed under it. It cannot be undone. Type the project
                            name below to confirm.
                        </p>
                        <FormField Label="Type the project name to confirm"
                                   Value="@deleteConfirmName" OnChange="v => deleteConfirmName = v" />
                        <div class="flex items-center justify-end gap-2 mt-2.5">
                            <button type="button" class="btn-secondary text-xs px-2.5 py-1.5"
                                    disabled="@deleteBusy" @onclick="DisarmDelete">Keep project</button>
                            <button type="button"
                                    class="btn bg-negative-strong text-negative-ink hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed text-xs px-2.5 py-1.5"
                                    disabled="@(!DeleteNameMatches || deleteBusy)" @onclick="DeleteAsync">
                                @(deleteBusy ? "Deleting…" : "Delete this project permanently")
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </Modal>
}

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";

    private static readonly Organisation[] AllOrganisations = Enum.GetValues<Organisation>();
    private static readonly ProjectStage[] AllStages = Enum.GetValues<ProjectStage>();

    private bool open;
    private bool busy;
    private string? error;

    private const string ClientPrefix = "client:";
    private const string ArchitectPrefix = "architect:";

    private string reference = "";
    private string name = "";
    private string clientName = "";
    private Organisation organisation = Organisation.JewelBespokeBuild;
    private ProjectStage stage = ProjectStage.LiveDelivery;
    private string projectManagerEmail = "";
    private string addressLine = "";
    private string town = "";
    private string postcode = "";
    private string xeroSiteName = "";

    // The Xero contact mapping as held: Xero's ContactID + the name as Xero holds it ("" = not
    // mapped). xeroContacts is null until Xero has been read — the select stays disabled until then.
    private string xeroContactId = "";
    private string xeroContactName = "";
    private IReadOnlyList<XeroSupplier>? xeroContacts;
    private string? xeroContactsError;

    // The party this project corresponds with — "client:{id}" / "architect:{id}" / "" — plus the
    // optional client an architect acts for.
    private string partySelection = "";
    private string onBehalfOfClientId = "";
    private IReadOnlyList<Client> clients = Array.Empty<Client>();
    private IReadOnlyList<Architect> architects = Array.Empty<Architect>();

    // The delete confirm compares against the name as SAVED, not the editable field above.
    private string savedName = "";
    private bool deleteArmed;
    private bool deleteBusy;
    private string deleteConfirmName = "";

    // Mirrors UpdateProjectDetailsAuthorisation server-side (directors, the finance director and
    // project managers; administrators carry every role).
    private bool CanEdit =>
        Session.AvailableRoles.Any(role => role is Role.Admin or Role.ManagingDirector or Role.FinanceDirector or Role.ProjectManager);

    // Mirrors DeleteProjectAuthorisation server-side — deliberately narrower than CanEdit:
    // deleting erases the project's records wholesale, so project managers are not on this list.
    private bool CanDelete =>
        Session.AvailableRoles.Any(role => role is Role.Admin or Role.ManagingDirector or Role.FinanceDirector);

    // Same rule the server applies: trimmed, case-insensitive.
    private bool DeleteNameMatches =>
        !string.IsNullOrWhiteSpace(deleteConfirmName) &&
        string.Equals(deleteConfirmName.Trim(), savedName.Trim(), StringComparison.OrdinalIgnoreCase);

    private void Open()
    {
        var project = Projects.Find(ProjectId);
        if (project is null) return;
        reference = project.Reference;
        name = project.Name;
        clientName = project.ClientName;
        organisation = project.Organisation;
        stage = project.Stage;
        projectManagerEmail = project.ProjectManagerEmail;
        addressLine = project.AddressLine;
        town = project.Town;
        postcode = project.Postcode;
        xeroSiteName = project.XeroSiteName ?? "";
        xeroContactId = project.XeroContactId ?? "";
        xeroContactName = project.XeroContactName ?? "";
        xeroContacts = null;
        xeroContactsError = null;
        partySelection = string.IsNullOrEmpty(project.PartyId)
            ? ""
            : (project.PartyKind == PartyKind.Architect ? ArchitectPrefix : ClientPrefix) + project.PartyId;
        onBehalfOfClientId = project.OnBehalfOfClientId ?? "";
        savedName = project.Name;
        deleteArmed = false;
        deleteConfirmName = "";
        error = null;
        open = true;
        _ = LoadPartiesAsync();
        _ = LoadXeroContactsAsync();
    }

    private async Task LoadPartiesAsync()
    {
        try { clients = await ClientStore.ListAsync(); } catch { clients = Array.Empty<Client>(); }
        try { architects = await ArchitectStore.ListAsync(); } catch { architects = Array.Empty<Architect>(); }
        StateHasChanged();
    }

    // Xero's contacts, the same read the directory's import uses. Customers first; a contact Xero
    // has not flagged either way yet (brand new — the flags only turn on with a first invoice or
    // bill) is kept, supplier-only contacts are left out. A failed read leaves the current mapping
    // as the one option, so the value survives a save.
    private async Task LoadXeroContactsAsync()
    {
        try
        {
            var snapshot = await Subcontractors.FetchXeroSuppliersAsync();
            xeroContacts = snapshot.Suppliers
                .Where(contact => contact.IsCustomer || !contact.IsSupplier)
                .OrderByDescending(contact => contact.IsCustomer)
                .ThenBy(contact => contact.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            xeroContactsError = !snapshot.IsConfigured
                ? "Xero isn't connected — the contacts list can't be read."
                : snapshot.Error;
        }
        catch
        {
            xeroContacts = Array.Empty<XeroSupplier>();
            xeroContactsError = "Couldn't read the contacts from Xero. The current mapping is kept.";
        }
        StateHasChanged();
    }

    private void OnXeroContactChanged(ChangeEventArgs e)
    {
        xeroContactId = e.Value?.ToString() ?? "";
        var chosen = xeroContacts?.FirstOrDefault(contact => contact.ContactId == xeroContactId);
        if (chosen is not null) xeroContactName = chosen.Name;
        else if (xeroContactId.Length == 0) xeroContactName = "";
        // else: the mapped contact missing from the list keeps the name it was saved with.
    }

    private void OnPartyChanged(ChangeEventArgs e)
    {
        partySelection = e.Value?.ToString() ?? "";
        if (!partySelection.StartsWith(ArchitectPrefix, StringComparison.Ordinal)) onBehalfOfClientId = "";
    }

    private void OnOnBehalfOfClientChanged(ChangeEventArgs e) =>
        onBehalfOfClientId = e.Value?.ToString() ?? "";

    private void Close()
    {
        open = false;
        error = null;
        deleteArmed = false;
        deleteConfirmName = "";
    }

    private void ArmDelete() => deleteArmed = true;

    private void DisarmDelete()
    {
        deleteArmed = false;
        deleteConfirmName = "";
    }

    private async Task DeleteAsync()
    {
        if (deleteBusy || !DeleteNameMatches) return;

        error = null;
        deleteBusy = true;
        try
        {
            await Commands.SendAsync(new DeleteProject(ProjectId, deleteConfirmName.Trim()), CancellationToken.None);
        }
        catch (CommandFailedException ex) { error = ex.Message; deleteBusy = false; return; }
        catch { error = "Couldn't delete the project. Please try again."; deleteBusy = false; return; }

        // The delete has succeeded — a failed list refresh must not read as a failed delete, and
        // either way this page belongs to a project that no longer exists.
        try { await Projects.RefreshAsync(CancellationToken.None); } catch { /* list revalidates on the next page */ }
        deleteBusy = false;
        Close();
        Nav.NavigateTo("/projects");
    }

    private void OnOrganisationChanged(ChangeEventArgs e) =>
        organisation = Enum.Parse<Organisation>(e.Value?.ToString() ?? nameof(Organisation.JewelBespokeBuild));

    private void OnStageChanged(ChangeEventArgs e) =>
        stage = Enum.Parse<ProjectStage>(e.Value?.ToString() ?? nameof(ProjectStage.LiveDelivery));

    private async Task Save()
    {
        if (busy) return;
        if (string.IsNullOrWhiteSpace(reference) || string.IsNullOrWhiteSpace(name) ||
            string.IsNullOrWhiteSpace(clientName) || string.IsNullOrWhiteSpace(projectManagerEmail))
        {
            error = "Reference, name, client and project manager email are all required.";
            return;
        }

        error = null;
        busy = true;
        try
        {
            var partyKind = partySelection.StartsWith(ArchitectPrefix, StringComparison.Ordinal)
                ? PartyKind.Architect
                : PartyKind.Client;
            var partyId = partySelection.StartsWith(ArchitectPrefix, StringComparison.Ordinal)
                ? partySelection[ArchitectPrefix.Length..]
                : partySelection.StartsWith(ClientPrefix, StringComparison.Ordinal)
                    ? partySelection[ClientPrefix.Length..]
                    : null;

            await Commands.SendAsync(
                new UpdateProjectDetails(
                    ProjectId,
                    reference.Trim(),
                    name.Trim(),
                    clientName.Trim(),
                    organisation,
                    stage,
                    projectManagerEmail.Trim(),
                    partyKind,
                    partyId,
                    partyKind == PartyKind.Architect && !string.IsNullOrWhiteSpace(onBehalfOfClientId)
                        ? onBehalfOfClientId
                        : null,
                    addressLine.Trim(),
                    town.Trim(),
                    postcode.Trim(),
                    string.IsNullOrWhiteSpace(xeroSiteName) ? null : xeroSiteName.Trim(),
                    string.IsNullOrWhiteSpace(xeroContactId) ? null : xeroContactId.Trim(),
                    string.IsNullOrWhiteSpace(xeroContactId) ? null : xeroContactName.Trim()),
                CancellationToken.None);
            await Projects.RefreshAsync(CancellationToken.None);
            Close();
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        catch { error = "Couldn't save the changes. Please try again."; }
        finally { busy = false; }
    }
}
