@using Jewel.JPMS.Contracts.Subcontractors
@inject ISubcontractorStore SubcontractorStore
@implements IDisposable

<section class="panel overflow-hidden">
    <header class="px-5 py-3 border-b border-line bg-surface-raised flex items-center justify-between gap-3">
        <h2 class="text-sm font-medium text-content-muted">Compliance documents</h2>
        <div class="flex items-center gap-3">
            <span class="text-xs text-content-subtle">@CurrentDocuments.Count documents</span>
            <button type="button" class="btn-secondary" @onclick="OpenAdd">Add document…</button>
        </div>
    </header>
    @if (CurrentDocuments.Count == 0)
    {
        <p class="p-5 text-sm text-content-subtle italic">No compliance documents on file.</p>
    }
    else
    {
        <ul class="divide-y divide-line">
            @foreach (var document in CurrentDocuments)
            {
                <li class="p-4 text-sm flex items-start justify-between gap-3">
                    <div>
                        <p class="font-medium text-content">
                            @document.Kind
                            @if (document.Version > 1)
                            {
                                <span class="ml-1.5 text-xs font-normal text-content-subtle">v@(document.Version)</span>
                            }
                        </p>
                        <p class="text-xs text-content-subtle mt-1">
                            @if (document.HasFile)
                            {
                                <a class="underline underline-offset-2 hover:text-content" target="_blank" rel="noopener"
                                   href="/api/subcontractors/@SubcontractorId/compliance/@document.ComplianceDocumentId/content">@document.FileName</a>
                            }
                            else
                            {
                                @document.FileName
                            }
                            <span> · uploaded @DateText(document.UploadedAt)</span>
                        </p>
                        @if (document.ExpiresAt is not null)
                        {
                            <p class="text-xs text-content-subtle">Expires @DateText(document.ExpiresAt.Value)</p>
                        }
                        @if (document.PublicLiabilityCover is not null)
                        {
                            <p class="text-xs @(document.IsBelowPublicLiabilityRequirement ? "text-warning" : "text-content-subtle")"
                               title="@(document.IsBelowPublicLiabilityRequirement ? BelowRequirementTitle : null)">
                                Public liability cover @ComplianceDocumentExtensions.PublicLiabilityCoverText(document.PublicLiabilityCover)@(document.IsBelowPublicLiabilityRequirement ? " · below the £5m required on big jobs" : "")
                            </p>
                        }
                    </div>
                    <div class="flex items-center gap-3 shrink-0">
                        <button type="button" class="btn-secondary" @onclick="() => OpenEdit(document)">Edit details…</button>
                        <ComplianceStatusPill Status="document.Status()" />
                    </div>
                </li>
            }
        </ul>
    }
    @if (SupersededDocuments.Count > 0)
    {
        <details class="border-t border-line px-5 py-3">
            <summary class="text-xs text-content-subtle cursor-pointer">Previous versions (@SupersededDocuments.Count)</summary>
            <ul class="mt-2 space-y-1">
                @foreach (var document in SupersededDocuments)
                {
                    <li class="text-xs text-content-subtle">
                        @document.Kind v@(document.Version) —
                        @if (document.HasFile)
                        {
                            <a class="underline underline-offset-2 hover:text-content" target="_blank" rel="noopener"
                               href="/api/subcontractors/@SubcontractorId/compliance/@document.ComplianceDocumentId/content">@document.FileName</a>
                        }
                        else
                        {
                            @document.FileName
                        }
                        <span> · replaced @(DateText(document.SupersededAt?.LocalDateTime))</span>
                    </li>
                }
            </ul>
        </details>
    }
</section>

@* Add: same shape as the subcontractor's own portal upload — kind + optional expiry + file.
   Re-uploading an existing kind supersedes the old version (kept as history), and the kind
   suggestions reuse the portal upload's spellings so a filing here lands in the SAME version
   history as one the subcontractor uploads themselves. *@
<Modal IsOpen="addOpen" Title="Add compliance document" ShowFooter="true"
       ConfirmLabel="@(addBusy ? "Uploading…" : "Add document")" CancelLabel="Cancel"
       ConfirmDisabled="@(addBusy || addFile is null || string.IsNullOrWhiteSpace(addKind))"
       OnCancel="CloseAdd" OnConfirm="ConfirmAdd" Class="max-w-lg w-full">
    @if (addError is not null)
    {
        <Notice Tone="Tone.Negative" Class="mb-3">@addError</Notice>
    }
    <div class="space-y-3">
        <div class="grid gap-3 sm:grid-cols-2">
            <div>
                <FormField Label="Document type" Required>
                <input class="field w-full" list="compliance-add-kinds" placeholder="e.g. Public liability insurance"
                       @bind="addKind" @bind:event="oninput" />
                </FormField>
                <datalist id="compliance-add-kinds">
                    @foreach (var kind in SuggestedKinds)
                    {
                        <option value="@kind" />
                    }
                </datalist>
            </div>
            <div>
                <FormField Label="Expiry date">
                <input type="date" class="field w-full" @bind="addExpiry" />
                </FormField>
            </div>
        </div>
        <FormField Label="Public liability cover (£)" Hint="For an insurance certificate: the public liability limit of indemnity, e.g. 5000000 for £5m. Jewel's insurer requires £5m on big jobs.">
        <input type="number" min="0" step="1000" class="field w-full" placeholder="e.g. 5000000" @bind="addPublicLiabilityCover" />
        </FormField>
        <div>
            <FormField Label="File" Required>
            <InputFile OnChange="OnAddFileSelected" class="w-full text-sm text-content-muted" />
            </FormField>
            @if (addFile is not null)
            {
                <p class="text-xs text-content-subtle mt-1">@addFile.Name · @FormatSize(addFile.Size)</p>
            }
        </div>
        <p class="text-xs text-content-subtle">
            Adding an existing type again supersedes the current version — the old file stays
            downloadable under Previous versions.
        </p>
    </div>
</Modal>

@* Edit details (2026-09-10, the accountant's ask): the facts recorded against the CURRENT version
   — expiry and the public liability figure — corrected in place. The file, kind and version stay;
   a different certificate is a new version through Add document. This is how the insurance
   documents already on file get their £ figure without being uploaded again. *@
<Modal IsOpen="editOpen" Title="@($"Edit details — {editDocument?.Kind}")" ShowFooter="true"
       ConfirmLabel="@(editBusy ? "Saving…" : "Save details")" CancelLabel="Cancel"
       ConfirmDisabled="@editBusy" OnCancel="CloseEdit" OnConfirm="ConfirmEdit" Class="max-w-lg w-full">
    @if (editError is not null)
    {
        <Notice Tone="Tone.Negative" Class="mb-3">@editError</Notice>
    }
    <div class="space-y-3">
        @if (editDocument is not null)
        {
            <p class="text-xs text-content-subtle">@editDocument.FileName · v@(editDocument.Version) · uploaded @DateText(editDocument.UploadedAt)</p>
        }
        <div class="grid gap-3 sm:grid-cols-2">
            <div>
                <FormField Label="Expiry date" Hint="Blank for a document that does not expire.">
                <input type="date" class="field w-full" @bind="editExpiry" />
                </FormField>
            </div>
            <div>
                <FormField Label="Public liability cover (£)" Hint="The limit of indemnity on the certificate, e.g. 5000000 for £5m.">
                <input type="number" min="0" step="1000" class="field w-full" placeholder="e.g. 5000000" @bind="editPublicLiabilityCover" />
                </FormField>
            </div>
        </div>
    </div>
</Modal>

@code {
    [Parameter, EditorRequired] public string SubcontractorId { get; set; } = "";

    // Subscribe directly: the parent page's re-render on store change can skip this component
    // (its only parameter is an unchanged string), so the background compliance fetch — and an
    // upload's refetch — must trigger a render from inside.
    protected override void OnInitialized() => SubcontractorStore.OnChange += HandleStoreChange;
    private void HandleStoreChange() => InvokeAsync(StateHasChanged);
    public void Dispose() => SubcontractorStore.OnChange -= HandleStoreChange;

    private IReadOnlyList<ComplianceDocument> Documents =>
        SubcontractorStore.ComplianceFor(SubcontractorId);

    private IReadOnlyList<ComplianceDocument> CurrentDocuments =>
        Documents.Where(document => document.IsCurrentVersion)
            .OrderBy(document => document.Kind, StringComparer.OrdinalIgnoreCase).ToList();

    private IReadOnlyList<ComplianceDocument> SupersededDocuments =>
        Documents.Where(document => !document.IsCurrentVersion)
            .OrderBy(document => document.Kind, StringComparer.OrdinalIgnoreCase)
            .ThenByDescending(document => document.Version).ToList();

    // ---- Add document ----

    // The portal self-upload's suggestions, same spellings, so histories merge (kind matching is
    // case-insensitive server-side; a different spelling starts a separate version history).
    private static readonly string[] SuggestedKinds =
    {
        "Public liability insurance", "Employers liability insurance", "CIS certificate",
        "RAMS", "Method statement", "Training certificate", "Waste carrier licence"
    };

    private const string BelowRequirementTitle = "Jewel's insurer requires £5m public liability cover of every subcontractor on a big job";

    private bool addOpen;
    private bool addBusy;
    private string? addError;
    private string addKind = "";
    private DateTime? addExpiry;
    private decimal? addPublicLiabilityCover;
    private IBrowserFile? addFile;

    private void OpenAdd()
    {
        addKind = "";
        addExpiry = null;
        addPublicLiabilityCover = null;
        addFile = null;
        addError = null;
        addOpen = true;
    }

    private void CloseAdd()
    {
        if (addBusy) return;
        addOpen = false;
    }

    private void OnAddFileSelected(InputFileChangeEventArgs e)
    {
        addFile = e.File;
        addError = null;
    }

    private async Task ConfirmAdd()
    {
        if (addBusy || addFile is null || string.IsNullOrWhiteSpace(addKind)) return;
        addError = null;
        try
        {
            addBusy = true;
            DateTimeOffset? expiresAt = addExpiry is null
                ? null
                : new DateTimeOffset(DateTime.SpecifyKind(addExpiry.Value.Date, DateTimeKind.Utc));
            await SubcontractorStore.UploadComplianceFileAsync(
                SubcontractorId, addKind.Trim(), expiresAt, addFile, CancellationToken.None, addPublicLiabilityCover);
            addOpen = false;
        }
        catch (Exception ex)
        {
            addError = $"Upload failed: {ex.Message}";
        }
        finally
        {
            addBusy = false;
        }
    }

    // ---- Edit details ----

    private bool editOpen;
    private bool editBusy;
    private string? editError;
    private ComplianceDocument? editDocument;
    private DateTime? editExpiry;
    private decimal? editPublicLiabilityCover;

    private void OpenEdit(ComplianceDocument document)
    {
        editDocument = document;
        editExpiry = document.ExpiresAt?.UtcDateTime.Date;
        editPublicLiabilityCover = document.PublicLiabilityCover;
        editError = null;
        editOpen = true;
    }

    private void CloseEdit()
    {
        if (editBusy) return;
        editOpen = false;
    }

    private async Task ConfirmEdit()
    {
        if (editBusy || editDocument is null) return;
        editError = null;
        try
        {
            editBusy = true;
            // Date-only, pinned to UTC — the same conversion Add document applies to its expiry.
            DateTimeOffset? expiresAt = editExpiry is null
                ? null
                : new DateTimeOffset(DateTime.SpecifyKind(editExpiry.Value.Date, DateTimeKind.Utc));
            await SubcontractorStore.SetComplianceDocumentDetailsAsync(
                new SetComplianceDocumentDetails(SubcontractorId, editDocument.ComplianceDocumentId, expiresAt, editPublicLiabilityCover),
                CancellationToken.None);
            editOpen = false;
        }
        catch (CommandFailedException ex) { editError = $"Couldn't save: {ex.Message}"; }
        catch { editError = "Couldn't save the details. Please try again."; }
        finally
        {
            editBusy = false;
        }
    }

}
