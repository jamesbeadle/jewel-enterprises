@namespace Jewel.JPMS.Components.Icons

@*
    The action-glyph library for toolbars, tab bars and icon buttons — NavIcon's pattern (one
    component, a name switch, no new file per glyph) applied to in-view actions rather than routes.
    Same outline weight and conventions as NavIcon: 24-box, stroke 1.6, currentColor, aria-hidden —
    the caller supplies the accessible name (title/aria-label) on the control that hosts the icon.
*@

<svg class="@Class" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @((MarkupString)PathFor(Name))
</svg>

@code {
    /// <summary>Which glyph to draw — see PathFor for the set. Unknown names draw a plain circle
    /// rather than nothing, so a typo is visible instead of invisible.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public string Class { get; set; } = "w-4 h-4";

    private static string PathFor(string name) => name switch
    {
        // A spreadsheet: the document outline with a row/column grid — the Excel export mark.
        "excel" => "<path d='M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z'/><path d='M14 3v5h5'/><path d='M8.5 12.5h7M8.5 15.5h7M12 12.5v6M8.5 18.5h7M8.5 12.5v6h7v-6z'/>",

        // A document with the fold — the generic record/container mark.
        "document" => "<path d='M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z'/><path d='M14 3v5h5'/><path d='M8.5 13h7M8.5 16.5h4.5'/>",

        // A document with a question mark — the RFI / official-query mark.
        "document-question" => "<path d='M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z'/><path d='M14 3v5h5'/><path d='M10.4 12.4a1.7 1.7 0 1 1 2.4 1.55c-.55.25-.8.6-.8 1.15'/><path d='M12 17.4h.01'/>",

        // A document with a down arrow — download (the PDF of the official document).
        "download" => "<path d='M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z'/><path d='M14 3v5h5'/><path d='M12 11.5v6M9.5 15l2.5 2.5L14.5 15'/>",

        // An up arrow rising from a tray — upload files INTO something (download's mirror in
        // spirit; drawn as a tray so it still reads at 14px on a folder row).
        "upload" => "<path d='M4.5 15.5v2.5a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-2.5'/><path d='M12 14.5v-10M8 8.5l4-4 4 4'/>",

        // A pound sign in a circle — the variation / priced-change mark.
        "pound" => "<circle cx='12' cy='12' r='8.5'/><path d='M14.6 9.3a2.3 2.3 0 0 0-4 1.55c0 1.05.35 1.6.35 2.65 0 .8-.3 1.6-.75 2.2h4.6'/><path d='M9.3 13.1h3.6'/>",

        // A parcel — the bid package mark.
        "package" => "<path d='M21 8.2 12 3.5 3 8.2v7.6l9 4.7 9-4.7z'/><path d='M3 8.2l9 4.7 9-4.7'/><path d='M12 12.9v7.6'/>",

        // Circular arrow — refresh / re-read from the source system.
        "refresh" => "<path d='M20.5 12a8.5 8.5 0 1 1-2.5-6M20.5 4.5V10h-5.5'/>",

        // Envelope — draft an email.
        "email" => "<rect x='3.5' y='5.5' width='17' height='13' rx='2'/><path d='m4.5 7.5 7.5 5.5 7.5-5.5'/>",

        // Plus — add / create.
        "plus" => "<path d='M12 5v14M5 12h14'/>",

        // Magnifier with a plus / minus — the PDF viewer's zoom pair.
        "zoom-in" => "<circle cx='11' cy='11' r='6.5'/><path d='m20 20-4.4-4.4'/><path d='M11 8.5v5M8.5 11h5'/>",
        "zoom-out" => "<circle cx='11' cy='11' r='6.5'/><path d='m20 20-4.4-4.4'/><path d='M8.5 11h5'/>",

        // A frame with arrows meeting its sides — scale to the width.
        "fit-width" => "<rect x='3.5' y='5.5' width='17' height='13' rx='2'/><path d='M7 12h10'/><path d='M9.5 9.5 7 12l2.5 2.5M14.5 9.5 17 12l-2.5 2.5'/>",

        // Four frame corners — the whole page in view.
        "fit-page" => "<path d='M3.5 9V5.5a2 2 0 0 1 2-2H9'/><path d='M15 3.5h3.5a2 2 0 0 1 2 2V9'/><path d='M20.5 15v3.5a2 2 0 0 1-2 2H15'/><path d='M9 20.5H5.5a2 2 0 0 1-2-2V15'/>",

        // Anticlockwise arc arrow — rotate the view (refresh's mirror, deliberately distinct).
        "rotate" => "<path d='M3.5 12a8.5 8.5 0 1 0 2.5-6'/><path d='M3.5 4.5V10H9'/>",

        // Corner arrows pushing out — fullscreen.
        "fullscreen" => "<path d='M9 3.5H3.5V9M15 3.5h5.5V9M20.5 15v5.5H15M3.5 15v5.5H9'/>",

        // A calendar with today's square marked — "back to now" on a grid paged into the past.
        "calendar-today" => "<rect x='3.5' y='5' width='17' height='15.5' rx='2'/><path d='M3.5 9.5h17M8 3.5v3M16 3.5v3'/><rect x='7' y='12.5' width='3.5' height='3.5' rx='0.6' fill='currentColor' stroke='none'/>",

        // Page-to-page chevrons.
        "chevron-left" => "<path d='m14.5 6-6 6 6 6'/>",
        "chevron-right" => "<path d='m9.5 6 6 6-6 6'/>",

        // A circle with a cross — close the process (a bid package's no-winner ending).
        "close" => "<circle cx='12' cy='12' r='8.5'/><path d='m9.3 9.3 5.4 5.4M14.7 9.3l-5.4 5.4'/>",

        // A waste bin — delete the record for good (close's harder sibling).
        "trash" => "<path d='M4.5 6.5h15'/><path d='M9.5 6.5V5a1.5 1.5 0 0 1 1.5-1.5h2A1.5 1.5 0 0 1 14.5 5v1.5'/><path d='M6.7 6.5l.7 12.4a2 2 0 0 0 2 1.88h5.2a2 2 0 0 0 2-1.88l.7-12.4'/><path d='M10 10.5v6.5M14 10.5v6.5'/>",

        // Section expand/collapse.
        "chevron-down" => "<path d='m6 9.5 6 6 6-6'/>",

        // A pencil — rename / edit in place.
        "pencil" => "<path d='M4 20h4l11-11a2.1 2.1 0 0 0-3-3L5 17z'/><path d='m13.5 7.5 3 3'/>",

        // A folder — the drawing-register group mark.
        "folder" => "<path d='M3.5 7a2 2 0 0 1 2-2h4l2 2.5h7a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z'/>",

        // A luggage tag: a reference label hung on something — the client-references map.
        "tag" => "<path d='M3.5 12.2V5.5a2 2 0 0 1 2-2h6.7a2 2 0 0 1 1.4.6l6.6 6.6a2 2 0 0 1 0 2.8l-6.1 6.1a2 2 0 0 1-2.8 0l-6.6-6.6a2 2 0 0 1-.6-1.4z'/><circle cx='8' cy='8' r='1.3'/>",

        _ => "<circle cx='12' cy='12' r='8'/>"
    };
}
