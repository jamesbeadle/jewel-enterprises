@namespace Jewel.JPMS.Components

@*
    THE loading primitive for a region of a page, and the thing that keeps the screen to one mark.

    Two shapes, from the same question — is there anything on screen yet?

      COVER (the default). Nothing to show: the gate holds the region's space and puts the jewel
      in it. Used for a first load.

      OVERLAY (Overlay="true"). A previous answer is on screen and is being replaced or acted on:
      the gate keeps it in place, veils it and floats the mark over it. Used for a refresh — a
      sort, a pager, a filter, a command in flight.

    RELATIONAL: a gate showing its mark cascades a claimed LoadScope, and every gate INSIDE it
    goes quiet for as long as the claim holds — it still holds its space, it just does not add a
    second jewel to a wait the reader is already watching. So a page cover silences the panels
    beneath it, and a workspace-wide busy overlay silences the list refreshing under it, without
    either of them knowing what is nested inside. When the outer gate lifts, the inner one is free
    to speak for its own refresh again.

    Siblings cannot see each other — nothing cascades sideways — so the one rule left to the call
    site is: a screen with nothing to show gates ONCE, around the region the reader is waiting
    for, not once per panel inside it.

    Never gate a control (render it disabled with a "Loading…" placeholder), a single line of text
    (just do not render it until it is known), or a panel that only exists when it has something
    to show (its absence during the wait is its absence after).
*@

@if (Overlay)
{
    @* One stable wrapper whether loading or not: if the child moved between render-tree branches
       when IsLoading flipped, Blazor would recreate its DOM — and anything JS drew into the old
       elements (the pdf.js canvases in PdfViewer) would be thrown away with them while the JS
       kept rendering into the detached nodes. That is exactly the "preview is just black" defect:
       the viewer reported ready, the toolbar worked, and the surface on screen was a fresh empty
       div. Only the mark may come and go; the wrapped content must never move. *@
    <div class="relative @Class">
        <CascadingValue Value="Scope">
            @ChildContent
        </CascadingValue>
        @if (ShowsMark)
        {
            <JewelSpinner Overlay="true" Size="@SpinnerSize" IconSize="@IconSize" Label="@Label" Class="@OverlayClass" />
        }
    </div>
}
else if (!IsLoading)
{
    <CascadingValue Value="Scope">
        @ChildContent
    </CascadingValue>
}
else if (ShowsMark)
{
    <div class="@MinHeight flex items-center justify-center @Class" role="status" aria-live="polite" aria-busy="true">
        <JewelSpinner Size="@SpinnerSize" IconSize="@IconSize" Label="@Label" Class="py-0" />
    </div>
}
else
{
    @* Loading, but an ancestor already speaks for this wait: hold the space, say nothing. *@
    <div class="@MinHeight @Class" aria-hidden="true"></div>
}

@code {
    /// <summary>True until every store this region reads has produced its first result.</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>A main panel rather than an inline region: bigger jewel, taller reserved space.</summary>
    [Parameter] public bool Prominent { get; set; }

    /// <summary>Veil the content already on screen instead of replacing it — the refresh shape.</summary>
    [Parameter] public bool Overlay { get; set; }

    /// <summary>Caption under the jewel. Keep it specific — "Loading valuations" beats "Loading".</summary>
    [Parameter] public string? Label { get; set; } = "Loading";

    /// <summary>Override the reserved height when the incoming content has a known size.</summary>
    [Parameter] public string? Height { get; set; }

    /// <summary>Extra classes for the gate's own wrapper (layout, not looks).</summary>
    [Parameter] public string Class { get; set; } = "";

    /// <summary>Extra classes for the veil — a stacking context, where the region has one.</summary>
    [Parameter] public string OverlayClass { get; set; } = "";

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private LoadScope? Ancestors { get; set; }

    private bool AncestorSpeaks => Ancestors?.IsClaimed == true;

    private bool ShowsMark => IsLoading && !AncestorSpeaks;

    private LoadScope Scope => LoadScope.For(IsLoading || AncestorSpeaks);

    private string MinHeight => Height ?? (Prominent ? "min-h-[220px]" : "min-h-[96px]");

    private string SpinnerSize => Prominent ? "w-12 h-12" : "w-8 h-8";

    private string IconSize => Prominent ? "w-5 h-5" : "w-3.5 h-3.5";
}
