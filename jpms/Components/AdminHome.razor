@inject IUserDirectory UserDirectory
@inject IAccessRequestStore Requests
@implements IDisposable

<div>

    @* The admin areas, rolled into one Actions menu (James, 2026-09-03) rather than a row of
       links: the rail's Admin folder lists the same destinations, so the homepage offers them
       once, out of the way. Grouped: people · system · the KPI register · the AI shelf. *@
    <PageHeader Eyebrow="Administrator" Subtitle="@($"You are signed in as {CurrentUser.Email}")">
        <Actions>
            <DropdownMenu Label="Actions" Items="@AdminActions" WidthClass="w-64"
                          ToggleTitle="Administration — users, system, integrations, trades, the KPI register and the AI shelf" />
        </Actions>
    </PageHeader>

    <AdminStatsRow />

    @* An admin carries every role server-side, so this page leads with the real project work.
       It used to end on WhatsNextPanel — a hard-coded engineering backlog with no data behind
       it, which is not something anybody administering the system can act on. *@
    <div class="space-y-6 mb-6">
        @* Open to-do items assigned to this administrator — general and project items alike. *@
        <MyTodosPanel />
        @* The KPI register's latest marks — administrators only, like this whole page (2026-09-03). *@
        <AdminKpiPanel />
        <OpenRequestsPanel />
        <NextValuationsPanel />
    </div>

    @* Pending access requests stay on the homepage: they are the one admin duty that is
       time-sensitive enough to belong here. The user list itself (and revoked users) moved to
       Admin → Users (2026-07-30) — administration outgrew a homepage panel. *@
    <PendingRequestsPanel />

</div>

@code {
    [Parameter, EditorRequired] public AuthenticatedUser CurrentUser { get; set; } = default!;

    private static readonly IReadOnlyList<DropdownMenu.Item> AdminActions = new DropdownMenu.Item[]
    {
        new("Users", Href: "/admin/users", Hint: "Everyone who can sign in, invites and roles", Group: 0),
        new("Revoked users", Href: "/admin/users/revoked", Hint: "Restore or permanently delete revoked users", Group: 0),
        new("System", Href: "/admin/system", Hint: "Announce an app version, tender T&Cs", Group: 1),
        new("Integrations", Href: "/admin/integrations", Hint: "The portal's shared external connections", Group: 1),
        new("Trades", Href: "/admin/trades", Hint: "The curated trade list", Group: 1),
        new("KPI emails", Href: "/admin/kpis", Hint: "Emails marked as a KPI against a member of staff — administrators only", Group: 2),
        new("Audit trail", Href: "/audit", Hint: "The system audit register", Group: 2),
        new("AI Skills", Href: "/admin/skills", Hint: "The assistant's versioned skills", Group: 3),
        new("AI Actions", Href: "/admin/ai-actions", Hint: "Skills wired to connector actions", Group: 3),
    };

    protected override void OnInitialized()
    {
        UserDirectory.OnChange += StateHasChanged;
        Requests.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        UserDirectory.OnChange -= StateHasChanged;
        Requests.OnChange -= StateHasChanged;
    }
}
