@inject IUserDirectory UserDirectory
@inject IAccessRequestStore Requests
@implements IDisposable

@*
    The admin home's headline figures. All three are held together until BOTH stores have landed:
    they are read as a set, and showing "12 users / 0 pending" while the requests fetch is still in
    flight states something false with total confidence. One indicator, one reveal — so the gate
    goes round the row rather than into each tile, which would put three jewels in a line pulsing
    at each other over a single fetch.
*@

<LoadGate IsLoading="@IsLoading" Label="Loading the figures" Height="min-h-[104px]" Class="mb-8">
    <div class="grid grid-cols-3 gap-3 md:gap-4">
        <StatTile Label="Approved users"   Value="@ApprovedUserCount" />
        <StatTile Label="Pending requests" Value="@PendingRequestCount" />
        <StatTile Label="Roles in use"     Value="@DistinctRoleCount" />
    </div>
</LoadGate>

@code {
    private bool IsLoading => LoadState.UntilAll(UserDirectory.IsLoaded, Requests.IsLoaded);

    private string ApprovedUserCount => UserDirectory.All().Count.ToString();

    private string PendingRequestCount => Requests.Pending().Count.ToString();

    private string DistinctRoleCount =>
        UserDirectory.All().SelectMany(user => user.Roles).Distinct().Count().ToString();

    protected override void OnInitialized()
    {
        // Reading All()/Pending() is what starts the lazy fetch; subscribing here is what turns the
        // jewel back into a figure when it lands.
        UserDirectory.OnChange += StateHasChanged;
        Requests.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        UserDirectory.OnChange -= StateHasChanged;
        Requests.OnChange -= StateHasChanged;
    }
}
