<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Jewel.JPMS.Worker</RootNamespace>
    <AssemblyName>Jewel.JPMS.Worker</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.12.1" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.19.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="1.22.0" />
    <!-- HTTP trigger for the Bluebeam OAuth callback — it must live on this app because the SWA
         edge intercepts any request carrying a ?code= query parameter (see worker/Bluebeam). -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.2.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="1.17.4" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="1.2.0" />
    <!-- Brings AddApplicationInsightsTelemetryWorkerService, which the isolated-process telemetry
         wiring in Program.cs needs alongside the Functions ApplicationInsights package above. -->
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.22.0" />
    <!-- PDFsharp/MigraDoc (MIT): the worker renders the same branded request document before emailing it. -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.1.1" />
    <!-- PdfPig (Apache-2.0): the drawing-extraction worker reads each revision PDF's text layer —
         same package + version as the api, where the shared extractor source lives. -->
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <!-- Azure.Storage.Blobs: the extraction reads revision PDFs from, and writes payload blobs to,
         the drawings container via the api's own AzureBlobDrawingStore (linked below). -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.22.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <!-- Azure.Communication.Email: the imagine render worker emails the prospect when their
         concepts are ready — same package + version as the api, whose notifier is linked below. -->
    <PackageReference Include="Azure.Communication.Email" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\contracts\Jewel.JPMS.Contracts.csproj" />
  </ItemGroup>

  <!--
    Shared source. The single source of truth for these files lives in the api project; the worker
    compiles its own copy via linked includes so the two Function apps share an identical EF model
    and the same option/queue contract types (no duplicate maintenance, no drift).
  -->
  <ItemGroup>
    <Compile Include="..\api\Data\Entities\**\*.cs" Link="Shared\Data\Entities\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\api\Data\JpmsContext.cs" Link="Shared\Data\JpmsContext.cs" />
    <Compile Include="..\api\Data\JpmsContext.Model.cs" Link="Shared\Data\JpmsContext.Model.cs" />
    <Compile Include="..\api\Features\Requests\RequestsIdentifierFactory.cs" Link="Shared\RequestsIdentifierFactory.cs" />
    <Compile Include="..\api\Features\MailboxIntake\MailboxIntakeOptions.cs" Link="Shared\MailboxIntakeOptions.cs" />
    <Compile Include="..\api\Features\MailboxIntake\Queue\MailboxQueues.cs" Link="Shared\MailboxQueues.cs" />
    <!-- The outbound draft is stamped with the same triage marker/tag stems the API filters on. -->
    <Compile Include="..\api\Features\MailboxIntake\Graph\TriageCategories.cs" Link="Shared\TriageCategories.cs" />
    <Compile Include="..\api\Features\MailboxIntake\Queue\IMailboxQueue.cs" Link="Shared\IMailboxQueue.cs" />
    <Compile Include="..\api\Features\MailboxIntake\Queue\StorageMailboxQueue.cs" Link="Shared\StorageMailboxQueue.cs" />
    <Compile Include="..\api\Features\MailboxIntake\Queue\NullMailboxQueue.cs" Link="Shared\NullMailboxQueue.cs" />
    <Compile Include="..\api\Features\MailboxIntake\Actions\IMailboxActionScheduler.cs" Link="Shared\IMailboxActionScheduler.cs" />
    <!-- Shared request-document renderer: built in the api project, compiled into the worker so the
         emailed PDF is byte-for-byte the same as the one downloaded through the platform. -->
    <Compile Include="..\api\Features\Requests\Documents\RequestDocumentModel.cs" Link="Shared\Documents\RequestDocumentModel.cs" />
    <Compile Include="..\api\Features\Requests\Documents\RequestDocumentBuilder.cs" Link="Shared\Documents\RequestDocumentBuilder.cs" />
    <Compile Include="..\api\Features\Requests\Documents\RequestDocumentRenderer.cs" Link="Shared\Documents\RequestDocumentRenderer.cs" />
    <Compile Include="..\api\Features\Requests\Documents\RequestDocumentRenderer.Sections.cs" Link="Shared\Documents\RequestDocumentRenderer.Sections.cs" />
    <Compile Include="..\api\Features\Requests\Documents\RequestDocumentRenderer.Helpers.cs" Link="Shared\Documents\RequestDocumentRenderer.Helpers.cs" />
    <Compile Include="..\api\Features\Requests\Documents\DocumentFontResolver.cs" Link="Shared\Documents\DocumentFontResolver.cs" />
    <Compile Include="..\api\Features\Requests\Documents\DocumentBranding.cs" Link="Shared\Documents\DocumentBranding.cs" />
    <Compile Include="..\api\Features\Documents\JewelDocumentStyle.cs" Link="Shared\Documents\JewelDocumentStyle.cs" />
    <!-- Shared recipient resolution: the worker send, the Outlook draft, and the recipients
         preview all resolve To/CC/BCC through the same code so the paths can never drift. -->
    <Compile Include="..\api\Features\Requests\Recipients\RequestRecipientResolver.cs" Link="Shared\RequestRecipientResolver.cs" />
    <!-- Project-qualified tag stems (references are only unique per project; tags share one flat
         mailbox category space). MailboxActionWorker resolves the outbound draft's workflow tag
         through this helper. -->
    <Compile Include="..\api\Features\Requests\RequestTags.cs" Link="Shared\RequestTags.cs" />
    <!-- Shared Xero source: the nightly timer (Xero/XeroNightlyWorker.cs) runs the SAME sync and
         auto-allocation handlers the API's HTTP endpoints use, compiled from the identical files so
         the overnight run and the allocation page's buttons can never drift apart. -->
    <Compile Include="..\api\Cqrs\ICommandHandler.cs" Link="Shared\Cqrs\ICommandHandler.cs" />
    <Compile Include="..\api\Features\Xero\IXeroClient.cs" Link="Shared\Xero\IXeroClient.cs" />
    <Compile Include="..\api\Features\Xero\NullXeroClient.cs" Link="Shared\Xero\NullXeroClient.cs" />
    <Compile Include="..\api\Features\Xero\XeroCallFailedException.cs" Link="Shared\Xero\XeroCallFailedException.cs" />
    <!-- Every XeroClient partial, by glob: a new partial (XeroClient.FindBills.cs broke the
         worker build on 2026-09-08 when it was added to the api but not listed here) must never
         leave the worker's copy of the class missing an interface member. -->
    <Compile Include="..\api\Features\Xero\XeroClient*.cs" Link="Shared\Xero\%(Filename)%(Extension)" />
    <Compile Include="..\api\Features\Xero\XeroOptions.cs" Link="Shared\Xero\XeroOptions.cs" />
    <Compile Include="..\api\Features\Xero\XeroApproval.cs" Link="Shared\Xero\XeroApproval.cs" />
    <Compile Include="..\api\Features\Xero\Ledger\SyncXeroLedgerHandler.cs" Link="Shared\Xero\SyncXeroLedgerHandler.cs" />
    <Compile Include="..\api\Features\Xero\Ledger\AllocateSuggestedXeroLinesHandler.cs" Link="Shared\Xero\AllocateSuggestedXeroLinesHandler.cs" />
    <!-- Labour-supplier recognition: the allocate-suggested sweep above skips labour settlement
         lines through it, so the nightly run and the page's button apply the same §6 rule. Since
         2026-08-31 it leans on the shared name-matching rule and the settlement-counterparty rule
         (WorkerDirectoryMatcher.cs), so that file rides along — the worker's recognition and the
         API's can never drift on what counts as a match. -->
    <Compile Include="..\api\Features\Labour\WorkerDirectoryMatcher.cs" Link="Shared\Labour\WorkerDirectoryMatcher.cs" />
    <Compile Include="..\api\Features\Xero\Ledger\LabourSupplierRecognition.cs" Link="Shared\Xero\LabourSupplierRecognition.cs" />
    <Compile Include="..\api\Features\Xero\Ledger\XeroAllocationSuggester.cs" Link="Shared\Xero\XeroAllocationSuggester.cs" />
    <!-- Work Order bill recognition (2026-09-08): the sweep skips bills matched to an open work
         order — they leave the queue through Approve on the Work Order bills tab, linked to the
         order — so the nightly run and the page's button apply the same rule. The recogniser
         reads through XeroLedgerReads and the directory's name rule (DirectoryXeroMatcher). -->
    <Compile Include="..\api\Features\Xero\Ledger\XeroLedgerReads.cs" Link="Shared\Xero\XeroLedgerReads.cs" />
    <Compile Include="..\api\Features\Xero\Ledger\XeroLedgerReads.WorkOrderBills.cs" Link="Shared\Xero\XeroLedgerReads.WorkOrderBills.cs" />
    <Compile Include="..\api\Features\Xero\Ledger\WorkOrderBillRecognition*.cs" Link="Shared\Xero\%(Filename)%(Extension)" />
    <Compile Include="..\api\Features\Xero\Ledger\WorkOrderBillReference.cs" Link="Shared\Xero\WorkOrderBillReference.cs" />
    <Compile Include="..\api\Features\Subcontractors\DirectoryXeroMatcher.cs" Link="Shared\Subcontractors\DirectoryXeroMatcher.cs" />
    <Compile Include="..\api\Features\Xero\Ledger\XeroWriteBackService.cs" Link="Shared\Xero\XeroWriteBackService.cs" />
    <!-- The service is partial since 2026-09-08 (the Work Order bill write and the tracking
         clear live in their own file); both halves must ride together or the worker's copy
         fails to implement the interface. -->
    <Compile Include="..\api\Features\Xero\Ledger\XeroWriteBackService.WorkOrderBills.cs" Link="Shared\Xero\XeroWriteBackService.WorkOrderBills.cs" />
    <Compile Include="..\api\Features\Xero\SitePnl\SyncXeroSitePnlHandler.cs" Link="Shared\Xero\SyncXeroSitePnlHandler.cs" />
    <!-- Shared Bluebeam source: the extraction consumer and the nightly token keep-alive run the
         SAME client, token service and runner the api compiles, so the two apps can never drift on
         paths, token handling, or what a stored extraction looks like. Endpoint classes are
         deliberately NOT linked — linking an [HttpTrigger] class would register it here too. -->
    <Compile Include="..\api\Features\Bluebeam\BluebeamOptions.cs" Link="Shared\Bluebeam\BluebeamOptions.cs" />
    <Compile Include="..\api\Features\Bluebeam\IBluebeamClient.cs" Link="Shared\Bluebeam\IBluebeamClient.cs" />
    <Compile Include="..\api\Features\Bluebeam\BluebeamClient.cs" Link="Shared\Bluebeam\BluebeamClient.cs" />
    <Compile Include="..\api\Features\Bluebeam\BluebeamClient.Sessions.cs" Link="Shared\Bluebeam\BluebeamClient.Sessions.cs" />
    <Compile Include="..\api\Features\Bluebeam\NullBluebeamClient.cs" Link="Shared\Bluebeam\NullBluebeamClient.cs" />
    <Compile Include="..\api\Features\Bluebeam\BluebeamTokenService.cs" Link="Shared\Bluebeam\BluebeamTokenService.cs" />
    <Compile Include="..\api\Features\Bluebeam\BluebeamConnectionState.cs" Link="Shared\Bluebeam\BluebeamConnectionState.cs" />
    <Compile Include="..\api\Features\Bluebeam\BluebeamConnectionWriter.cs" Link="Shared\Bluebeam\BluebeamConnectionWriter.cs" />
    <Compile Include="..\api\Features\Bluebeam\Queue\BluebeamQueues.cs" Link="Shared\Bluebeam\BluebeamQueues.cs" />
    <Compile Include="..\api\Features\Bluebeam\Extraction\PdfTextLayerExtractor.cs" Link="Shared\Bluebeam\PdfTextLayerExtractor.cs" />
    <Compile Include="..\api\Features\Bluebeam\Extraction\BluebeamMarkupParser.cs" Link="Shared\Bluebeam\BluebeamMarkupParser.cs" />
    <Compile Include="..\api\Features\Bluebeam\Extraction\DrawingExtractionRunner.cs" Link="Shared\Bluebeam\DrawingExtractionRunner.cs" />
    <Compile Include="..\api\Features\Bluebeam\Extraction\DrawingExtractionResultWriter.cs" Link="Shared\Bluebeam\DrawingExtractionResultWriter.cs" />
    <Compile Include="..\api\Features\Bluebeam\Extraction\DrawingExtractionOutcome.cs" Link="Shared\Bluebeam\DrawingExtractionOutcome.cs" />
    <!-- The PDF's own read (2026-09-07): positioned geometry + the structured drawing record. -->
    <Compile Include="..\api\Features\Drawings\Geometry\*.cs" Link="Shared\Drawings\Geometry\%(Filename)%(Extension)" />
    <!-- The drawings blob store the runner reads PDFs from and writes payload blobs to. -->
    <Compile Include="..\api\Features\Drawings\Storage\IDrawingBlobStore.cs" Link="Shared\Bluebeam\IDrawingBlobStore.cs" />
    <Compile Include="..\api\Features\Drawings\Storage\AzureBlobDrawingStore.cs" Link="Shared\Bluebeam\AzureBlobDrawingStore.cs" />
    <Compile Include="..\api\Features\Drawings\Storage\NullDrawingBlobStore.cs" Link="Shared\Bluebeam\NullDrawingBlobStore.cs" />
    <!-- Shared Sales research source (2026-09-06): the strategy-research queue consumer runs the
         SAME researcher, runner, plan prompt and Claude client the api compiles. The command
         handlers and endpoints are deliberately NOT linked. -->
    <Compile Include="..\api\Features\Ai\AnthropicOptions.cs" Link="Shared\Sales\AnthropicOptions.cs" />
    <Compile Include="..\api\Features\Ai\ClaudeClient.cs" Link="Shared\Sales\ClaudeClient.cs" />
    <Compile Include="..\api\Features\Sales\SalesEntityMapping.cs" Link="Shared\Sales\SalesEntityMapping.cs" />
    <Compile Include="..\api\Features\Sales\Research\SalesQueues.cs" Link="Shared\Sales\SalesQueues.cs" />
    <Compile Include="..\api\Features\Sales\Research\StrategyPlanPrompt.cs" Link="Shared\Sales\StrategyPlanPrompt.cs" />
    <Compile Include="..\api\Features\Sales\Research\StrategyResearcher.cs" Link="Shared\Sales\StrategyResearcher.cs" />
    <Compile Include="..\api\Features\Sales\Research\StrategyResearchRunner.cs" Link="Shared\Sales\StrategyResearchRunner.cs" />
    <!-- Shared Imagine render source (2026-09-06): the render queue consumer runs the SAME runner,
         concept writer, Azure image client, blob store and email notifier the api compiles. The
         public endpoints, the public service and the command handlers are deliberately NOT linked. -->
    <Compile Include="..\api\Storage\AzureBlobFileStore.cs" Link="Shared\Storage\AzureBlobFileStore.cs" />
    <Compile Include="..\api\Features\Sales\Imagine\IImagineImageStore.cs" Link="Shared\Sales\Imagine\IImagineImageStore.cs" />
    <Compile Include="..\api\Features\Sales\Imagine\AzureImageClient.cs" Link="Shared\Sales\Imagine\AzureImageClient.cs" />
    <Compile Include="..\api\Features\Sales\Imagine\ImagineConceptWriter.cs" Link="Shared\Sales\Imagine\ImagineConceptWriter.cs" />
    <Compile Include="..\api\Features\Sales\Imagine\ImagineNotifier.cs" Link="Shared\Sales\Imagine\ImagineNotifier.cs" />
    <Compile Include="..\api\Features\Sales\Imagine\ImagineRenderRunner.cs" Link="Shared\Sales\Imagine\ImagineRenderRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
